{% doc %}
  Media-led Banner block. Its media, layout, appearance and child content use
  the same shared renderer and settings as the Image card block.

  @example
  {% content_for 'block', type: 'banner', id: 'banner' %}
{% enddoc %}

{% capture banner_children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'media-card',
  media_card_block: block,
  children: banner_children,
  class_modifier: 'image-card--featured-collection-banner',
  use_image_ratio: true
%}

{% schema %}
{
  "name": "t:general.banner",
  "tag": null,
  "blocks": [
    {
      "type": "eyebrow"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "header"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "image",
          "label": "t:general.image"
        },
        {
          "value": "video",
          "label": "t:general.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "gradient",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "default": "#00000033",
      "alpha": true,
      "label": "t:labels.overlay_color",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:labels.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "t:labels.image_ratio",
      "options": [
        {
          "value": "full_screen",
          "label": "t:options.section_height.full_screen"
        },
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "ratio_1_1",
          "label": "Square (1:1)"
        },
        {
          "value": "ratio_4_5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "ratio_3_4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "ratio_2_3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "ratio_9_16",
          "label": "Portrait (9:16)"
        },
        {
          "value": "ratio_16_9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "ratio_3_2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "ratio_4_3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "ratio_5_4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_desktop",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_desktop",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "t:labels.image_ratio_mobile",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "ratio_1_1",
          "label": "Square (1:1)"
        },
        {
          "value": "ratio_4_5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "ratio_3_4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "ratio_2_3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "ratio_9_16",
          "label": "Portrait (9:16)"
        },
        {
          "value": "ratio_16_9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "ratio_3_2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "ratio_4_3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "ratio_5_4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_mobile",
      "label": "W (mobile)",
      "default": 16,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_mobile",
      "label": "H (mobile)",
      "default": 9,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "select",
      "id": "position_desktop",
      "label": "t:labels.desktop_position",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_center",
          "label": "Top center"
        },
        {
          "value": "top_right",
          "label": "Top right"
        },
        {
          "value": "center_left",
          "label": "Center left"
        },
        {
          "value": "center_center",
          "label": "Center center"
        },
        {
          "value": "center_right",
          "label": "Center right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom_left"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "t:labels.mobile_position",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_center",
          "label": "Top center"
        },
        {
          "value": "top_right",
          "label": "Top right"
        },
        {
          "value": "center_left",
          "label": "Center left"
        },
        {
          "value": "center_center",
          "label": "Center center"
        },
        {
          "value": "center_right",
          "label": "Center right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom_left"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.border"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.radius_preset.inherit"
        },
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "custom",
          "label": "t:options.radius_preset.custom"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:labels.custom_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.banner",
      "category": "t:general.cards",
      "settings": {
        "image_ratio_desktop": "ratio_1_1",
        "image_ratio_mobile": "ratio_1_1",
        "corner_radius": "square",
        "custom_corner_radius": 0,
        "color_scheme": "scheme-3",
        "position_desktop": "bottom_left",
        "position_mobile": "bottom_left",
        "padding_top": 32,
        "padding_bottom": 32,
        "padding_left": 32,
        "padding_right": 32
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "<p>Subheading</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>Your Main Heading Goes Here</p>",
            "heading_size": "display",
            "html_tag": "h2"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Button label",
            "button_style": "tertiary",
            "button_open_in_new_tab": false,
            "show_icon": true,
            "icon": "arrow",
            "icon_position": "after",
            "icon_size": "inherit",
            "icon_width": 20,
            "width": "fit",
            "width_mobile": "fit",
            "customize_mobile_padding": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
