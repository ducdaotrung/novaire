{% doc %}
  Renders a responsive, nested-content carousel. The carousel owns the Swiper
  viewport, slide layout, controls, pagination, autoplay and outer spacing.
  Slide content is owned by the child item blocks.
{% enddoc %}

{% liquid
  assign carousel_columns_desktop = block.settings.columns_desktop | default: '4' | plus: 0
  if carousel_columns_desktop < 1 or carousel_columns_desktop > 6
    assign carousel_columns_desktop = 4
  endif
  assign carousel_columns_mobile = block.settings.columns_mobile | default: '1' | plus: 0
  if carousel_columns_mobile < 1 or carousel_columns_mobile > 2
    assign carousel_columns_mobile = 1
  endif

  assign carousel_show_next_slide_preview = false
  if block.settings.show_next_slide_preview_on_desktop
    assign carousel_show_next_slide_preview = true
  endif
  assign carousel_show_next_slide_preview_mobile = false
  if block.settings.show_next_slide_preview_on_mobile
    assign carousel_show_next_slide_preview_mobile = true
  endif

  assign carousel_gap_desktop = block.settings.gap_desktop | default: 4 | plus: 0
  assign carousel_gap_mobile = block.settings.gap_mobile | default: 4 | plus: 0
  if carousel_gap_desktop < 0 or carousel_gap_desktop > 40
    assign carousel_gap_desktop = 4
  endif
  if carousel_gap_mobile < 0 or carousel_gap_mobile > 40
    assign carousel_gap_mobile = 4
  endif

  assign carousel_width_mode = block.settings.width | default: 'fill'
  unless carousel_width_mode == 'fill' or carousel_width_mode == 'custom'
    assign carousel_width_mode = 'fill'
  endunless
  assign carousel_custom_width = block.settings.custom_width | default: 50 | plus: 0
  if carousel_custom_width < 20 or carousel_custom_width > 100
    assign carousel_custom_width = 50
  endif

  assign carousel_navigation_style = block.settings.navigation_style | default: 'primary'
  unless carousel_navigation_style == 'primary' or carousel_navigation_style == 'secondary' or carousel_navigation_style == 'outline'
    assign carousel_navigation_style = 'primary'
  endunless
  assign carousel_navigation_icon = block.settings.navigation_icon | default: 'arrow'
  unless carousel_navigation_icon == 'chevron' or carousel_navigation_icon == 'arrow' or carousel_navigation_icon == 'long_arrow'
    assign carousel_navigation_icon = 'arrow'
  endunless
  assign carousel_navigation_behavior = block.settings.navigation_behavior | default: 'show_on_hover'
  unless carousel_navigation_behavior == 'always' or carousel_navigation_behavior == 'show_on_hover'
    assign carousel_navigation_behavior = 'show_on_hover'
  endunless

  assign carousel_show_navigation = true
  if block.settings.show_navigation_on_desktop == false or block.settings.show_navigation_on_desktop == 'false'
    assign carousel_show_navigation = false
  endif

  assign carousel_navigation_position = block.settings.navigation_position | default: 'outside'
  unless carousel_navigation_position == 'inside' or carousel_navigation_position == 'outside'
    assign carousel_navigation_position = 'outside'
  endunless

  assign carousel_pagination_type = block.settings.pagination_type | default: 'bullets'
  unless carousel_pagination_type == 'progress_bar' or carousel_pagination_type == 'bullets'
    assign carousel_pagination_type = 'bullets'
  endunless
  assign carousel_pagination_desktop = true
  if block.settings.show_pagination_on_desktop == false or block.settings.show_pagination_on_desktop == 'false'
    assign carousel_pagination_desktop = false
  endif
  assign carousel_pagination_mobile = false
  if block.settings.show_pagination_on_mobile == true or block.settings.show_pagination_on_mobile == 'true'
    assign carousel_pagination_mobile = true
  endif
  assign carousel_pagination_padding_desktop = block.settings.pagination_padding_desktop | default: 40 | plus: 0
  assign carousel_pagination_padding_mobile = block.settings.pagination_padding_mobile | default: 30 | plus: 0
  if carousel_pagination_padding_desktop < 0 or carousel_pagination_padding_desktop > 70
    assign carousel_pagination_padding_desktop = 40
  endif
  if carousel_pagination_padding_mobile < 0 or carousel_pagination_padding_mobile > 50
    assign carousel_pagination_padding_mobile = 30
  endif
  assign carousel_pagination_limit_width = false
  if carousel_pagination_type == 'progress_bar' and block.settings.pagination_limit_width
    assign carousel_pagination_limit_width = true
  endif
  assign carousel_pagination_max_width = block.settings.pagination_max_width | default: 200 | plus: 0
  if carousel_pagination_max_width < 100 or carousel_pagination_max_width > 500
    assign carousel_pagination_max_width = 200
  endif

  assign carousel_autoplay = block.settings.autoplay
  assign carousel_pause_on_hover = true
  if block.settings.pause_on_hover == false or block.settings.pause_on_hover == 'false'
    assign carousel_pause_on_hover = false
  endif
  assign carousel_speed = block.settings.autoplay_speed | default: 4 | plus: 0
  if carousel_speed < 1 or carousel_speed > 10
    assign carousel_speed = 4
  endif

  assign carousel_padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign carousel_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign carousel_padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign carousel_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign carousel_customize_mobile_padding = block.settings.customize_mobile_padding
  assign carousel_id = 'Carousel-' | append: block.id
  assign carousel_delay = carousel_speed | times: 1000
  assign carousel_previous_label = 'collection_tabs.previous' | t
  assign carousel_next_label = 'collection_tabs.next' | t
  assign carousel_has_multiple_items = false
  if block.blocks != blank and block.blocks.size > 1
    assign carousel_has_multiple_items = true
  endif
%}

<script data-theme-module="{{ 'carousel-block.js' | asset_url }}"></script>
<script data-theme-module="{{ 'image-text-card-grid.js' | asset_url }}"></script>

{% capture carousel_slides %}{% content_for 'blocks' %}{% endcapture %}
{% capture carousel_pagination %}
  {% if carousel_has_multiple_items %}
    {% if carousel_pagination_desktop or carousel_pagination_mobile %}
      <div
        class="swiper-pagination swiper-pagination--below carousel-block__pagination carousel-block__pagination--{{ carousel_pagination_type }}"
        data-carousel-pagination
        data-pagination-type="{{ carousel_pagination_type }}"
        data-pagination-visible-desktop="{{ carousel_pagination_desktop }}"
        data-pagination-visible-mobile="{{ carousel_pagination_mobile }}"
        {% if carousel_pagination_limit_width %}style="--carousel-pagination-width: min(100%, {{ carousel_pagination_max_width }}px); --swiper-pagination-width: min(100%, {{ carousel_pagination_max_width }}px);"{% endif %}
      ></div>
    {% endif %}
  {% endif %}
{% endcapture %}

{% capture carousel_style %}
  --carousel-padding-top: {{ carousel_padding_top }}px;
  --carousel-padding-bottom: {{ carousel_padding_bottom }}px;
  {% if carousel_customize_mobile_padding %}
    --carousel-padding-top-mobile: {{ carousel_padding_top_mobile }}px;
    --carousel-padding-bottom-mobile: {{ carousel_padding_bottom_mobile }}px;
  {% endif %}
  {% if carousel_width_mode == 'custom' %}--carousel-width: {{ carousel_custom_width }}%;{% endif %}
  {% if carousel_pagination_desktop %}--carousel-pagination-padding-desktop: {{ carousel_pagination_padding_desktop }}px;{% endif %}
  {% if carousel_pagination_mobile %}--carousel-pagination-padding-mobile: {{ carousel_pagination_padding_mobile }}px;{% endif %}
  {% if carousel_pagination_desktop %}--swiper-pagination-spacing: {{ carousel_pagination_padding_desktop }}px;{% endif %}
  {% if carousel_pagination_mobile %}--swiper-pagination-spacing-mobile: {{ carousel_pagination_padding_mobile }}px;{% endif %}
{% endcapture %}

{% capture carousel_navigation_markup %}
    {% if carousel_has_multiple_items %}
      {% capture carousel_navigation_center_style %}
        {% if carousel_pagination_desktop %}
          {% assign carousel_pagination_size = 'var(--swiper-pagination-progressbar-size, 4px)' %}
          {% if carousel_pagination_type == 'bullets' %}{% assign carousel_pagination_size = 'var(--swiper-pagination-bullet-size, 0.5rem)' %}{% endif %}
          --swiper-navigation-center-offset: calc(({{ carousel_pagination_padding_desktop }}px + {{ carousel_pagination_size }}) / 2);
        {% endif %}
      {% endcapture %}
      {% render 'swiper-navigation',
        show: carousel_show_navigation,
        position: carousel_navigation_position,
        style: carousel_navigation_style,
        icon: carousel_navigation_icon,
        behavior: carousel_navigation_behavior,
        centered: true,
        center_style: carousel_navigation_center_style,
        wrapper_class: 'carousel-block__navigation',
        wrapper_attributes: 'data-carousel-navigation',
        previous_attribute: 'data-carousel-previous',
        next_attribute: 'data-carousel-next',
        previous_label: carousel_previous_label,
        next_label: carousel_next_label
      %}
    {% endif %}
{% endcapture %}

<div
  class="carousel-block carousel-block--width-{{ carousel_width_mode }}"
  style="{{ carousel_style | strip }}"
  data-carousel-block
  data-carousel-preview-requested="{{ carousel_show_next_slide_preview }}"
  data-swiper-columns-desktop="{{ carousel_columns_desktop }}"
  data-swiper-columns-mobile="{{ carousel_columns_mobile }}"
  data-swiper-gap-desktop="{{ carousel_gap_desktop }}"
  data-swiper-gap-mobile="{{ carousel_gap_mobile }}"
  data-swiper-pagination-type="{{ carousel_pagination_type }}"
  data-swiper-pagination-desktop="{{ carousel_pagination_desktop }}"
  data-swiper-pagination-mobile="{{ carousel_pagination_mobile }}"
  data-swiper-autoplay="{{ carousel_autoplay }}"
  data-swiper-autoplay-pause-on-hover="{{ carousel_pause_on_hover }}"
  data-swiper-autoplay-delay="{{ carousel_speed | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="carousel-block__container swiper-carousel__container">
    {% render 'swiper-carousel',
      id: carousel_id,
      content: carousel_slides,
      root_class: 'carousel-block__viewport',
      aria_label: 'Carousel',
      pagination: carousel_pagination,
      autoplay: carousel_autoplay,
      pause_on_hover: carousel_pause_on_hover,
      autoplay_delay: carousel_delay,
      show_next_slide_preview: carousel_show_next_slide_preview,
      show_next_slide_preview_on_mobile: carousel_show_next_slide_preview_mobile
    %}
    {{ carousel_navigation_markup }}

  </div>
</div>

{% stylesheet %}
  [data-carousel-block] { width: var(--carousel-width, 100%); min-width: 0; padding-block: var(--carousel-padding-top, 0px) var(--carousel-padding-bottom, 0px); }
  [data-carousel-block] .carousel-block__container { position: relative; min-width: 0; }
  [data-carousel-block] .carousel-block__viewport { width: 100%; }
  [data-carousel-block] .carousel-block__viewport > .swiper-wrapper { column-gap: 0; }
  [data-carousel-block] .carousel-block__navigation { position: absolute; z-index: 2; inset: calc(50% - var(--swiper-navigation-center-offset, 0px)) 0 auto; display: flex; justify-content: space-between; padding-inline: 0.5rem; transform: translateY(-50%); pointer-events: none; }
  [data-carousel-block] .carousel-block__navigation.swiper-carousel__navigation--outside { padding-inline: 0; }
  [data-carousel-block] .swiper-carousel__navigation--outside .swiper-nav-button--prev { margin-inline-start: calc(-1 * var(--swiper-nav-size) / 2); }
  [data-carousel-block] .swiper-carousel__navigation--outside .swiper-nav-button--next { margin-inline-end: calc(-1 * var(--swiper-nav-size) / 2); }
  [data-carousel-block] .carousel-block__navigation .swiper-nav-button { pointer-events: auto; }
  [data-carousel-block] .carousel-block__navigation .swiper-button-disabled { pointer-events: none; }
  [data-carousel-block].carousel-block--locked > .carousel-block__container > .carousel-block__navigation,
  [data-carousel-block].carousel-block--locked > .carousel-block__container > .carousel-block__viewport > .swiper-pagination { display: none !important; }
  [data-carousel-block] .carousel-block__viewport > .swiper-pagination { width: var(--carousel-pagination-width, 100%); margin-block-start: var(--carousel-pagination-padding-desktop, 0px); }
  @media (min-width: 768px) { [data-carousel-block] .swiper-pagination[data-pagination-visible-desktop='false'] { display: none; } }
  @media (max-width: 767.98px) {
    [data-carousel-block] { padding-block: var(--carousel-padding-top-mobile, var(--carousel-padding-top, 0px)) var(--carousel-padding-bottom-mobile, var(--carousel-padding-bottom, 0px)); }
    [data-carousel-block] .carousel-block__navigation { display: none; }
    [data-carousel-block] .carousel-block__viewport > .swiper-pagination { margin-block-start: var(--carousel-pagination-padding-mobile, 0px); }
    [data-carousel-block] .swiper-pagination[data-pagination-visible-mobile='false'] { display: none; }
  }
{% endstylesheet %}

