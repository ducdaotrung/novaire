      "type": "select",
      "id": "media_2_type",
      "label": "Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image",
      "visible_if": "{{ block.settings.layout == 'split' }}"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image",
      "visible_if": "{{ block.settings.layout == 'split' and block.settings.media_2_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Mobile image",
