    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "video"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "scroll-to"
    },
    {
      "type": "group"
