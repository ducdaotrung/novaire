{% capture effective_overlay %}{% render 'overlay-background', overlay_settings: block.settings, color_id: 'overlay_color', enabled_id: 'show_overlay', style_id: 'overlay_style' %}{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}
{% render 'hero-styles' %}
{% doc %}
  A merchant-configurable visual slide for the Slideshow section. It owns the
  slide media and local content placement; nested Theme Blocks supply content.
{% enddoc %}

{% liquid
  assign slide_layout = block.settings.layout | default: 'classic'
  assign slide_media_type = block.settings.media_type | default: 'image'
  assign slide_media_2_type = block.settings.media_2_type | default: 'image'
  assign slide_content_width = block.settings.content_width | default: 'fit'
  unless slide_content_width == 'fit' or slide_content_width == 'fill' or slide_content_width == 'custom'
    assign slide_content_width = 'fit'
  endunless
  assign slide_scheme = block.settings.color_scheme | default: 'scheme-1'
  if block.settings.color_scheme.id != blank
    assign slide_scheme = block.settings.color_scheme.id
  endif
  assign slide_scheme = slide_scheme | handleize
  assign slide_image_loading = 'lazy'
  assign slide_image_fetchpriority = 'auto'
  assign slide_mobile_height = 0
  comment
    Match the Slideshow mobile preset heights (rem at the foundation's 10px root).
    Adapt and full screen have no fixed pixel height, so retain uncropped sources.
  endcomment
  assign slide_mobile_height_preset = section.settings.mobile_height | default: 'small'
  case slide_mobile_height_preset
    when 'custom'
      assign slide_mobile_height = section.settings.mobile_height_custom | default: 440 | at_least: 1 | round
    when 'extra_small'
      assign slide_mobile_height = 320
    when 'small'
      assign slide_mobile_height = 440
    when 'medium'
      assign slide_mobile_height = 560
    when 'large'
      assign slide_mobile_height = 680
    when 'extra_large'
      assign slide_mobile_height = 820
  endcase
  if section.blocks.first != blank and section.blocks.first.id == block.id
    assign slide_image_loading = 'eager'
    assign slide_image_fetchpriority = 'high'
  endif
%}

{% capture slide_style %}
  {% if block.settings.show_overlay %}--slideshow-slide-overlay: {{ effective_overlay | default: 'transparent' | escape }};{% endif %}
  {% if block.settings.desktop_gap != 12 %}--slideshow-slide-gap: {{ block.settings.desktop_gap }}px;{% endif %}
  {% if block.settings.mobile_gap != 12 %}--slideshow-slide-gap-mobile: {{ block.settings.mobile_gap }}px;{% endif %}
  {% if slide_content_width == 'custom' %}--hero-content-max-width: {{ block.settings.content_max_width | default: 640 }}px;{% endif %}
{% endcapture %}

{% if slide_image_loading == 'eager' and section.index == 1 and slide_media_type == 'image' and block.settings.image != blank %}
  <!-- theme-lcp-preloads:start -->
  {% render 'slideshow-image', image: block.settings.image, mobile_image: block.settings.mobile_image, mobile_height: slide_mobile_height, preload: true %}
  <!-- theme-lcp-preloads:end -->
{% endif %}

<div
  class="swiper-slide slideshow-slide slideshow-slide--{{ slide_layout }} hero hero--width-full hero--classic hero--content-{{ slide_content_width }} hero--desktop-adapt hero--mobile-adapt color-scheme section-color-scope {{ slide_scheme }}"
  data-slideshow-slide
  data-image-zoom="{{ settings.motion_image_zoom }}"
  data-slideshow-color-scheme="{{ slide_scheme | escape }}"
  data-parallax="{{ block.settings.parallax_effect | default: 'none' }}"
  {% if slide_style != blank %}style="{{ slide_style | strip }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="hero__surface slideshow-slide__surface">
    <div class="media slideshow-slide__media slideshow-slide__media--primary" aria-hidden="true">
      <div class="media__inner{% if block.settings.image == blank and block.settings.video == blank %} placeholder-image{% endif %}" data-slideshow-media>
        {% if slide_media_type == 'video' and block.settings.video != blank %}
          {{ block.settings.video | video_tag: image_size: '2400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'slideshow-slide__video' }}
        {% elsif block.settings.image != blank %}
          {% render 'slideshow-image', image: block.settings.image, mobile_image: block.settings.mobile_image, mobile_height: slide_mobile_height, loading: slide_image_loading, fetchpriority: slide_image_fetchpriority %}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
        {% endif %}
      </div>
      {% if block.settings.show_overlay %}<span class="slideshow-slide__overlay"></span>{% endif %}
    </div>

    {% if slide_layout == 'split' %}
      <div class="media slideshow-slide__media slideshow-slide__media--secondary" aria-hidden="true">
        <div class="media__inner{% if block.settings.image_2 == blank and block.settings.video_2 == blank %} placeholder-image{% endif %}">
          {% if slide_media_2_type == 'video' and block.settings.video_2 != blank %}
            {{ block.settings.video_2 | video_tag: image_size: '2400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'slideshow-slide__video' }}
          {% elsif block.settings.image_2 != blank %}
            <picture>
              {% if block.settings.mobile_image_2 != blank %}
                <source media="(max-width: 767.98px)" sizes="100vw" srcset="{{ block.settings.mobile_image_2 | image_url: width: 375 }} 375w, {{ block.settings.mobile_image_2 | image_url: width: 550 }} 550w, {{ block.settings.mobile_image_2 | image_url: width: 750 }} 750w, {{ block.settings.mobile_image_2 | image_url: width: 1100 }} 1100w, {{ block.settings.mobile_image_2 | image_url: width: 1500 }} 1500w">
              {% endif %}
              {{ block.settings.image_2 | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '50vw', loading: slide_image_loading, fetchpriority: slide_image_fetchpriority, alt: '' }}
            </picture>
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hero__placeholder' }}
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.link != blank %}<a class="hero__link" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ block.settings.link_label | default: 'Slide link' | escape }}"></a>{% endif %}

    <div class="hero__container hero__container--desktop-{{ block.settings.desktop_position }} hero__container--mobile-{{ block.settings.mobile_position }} slideshow-slide__content">
      <div class="hero__content hero__content--width-{{ slide_content_width }} align-content slideshow-slide__content-inner">{% content_for 'blocks' %}</div>
    </div>
  </div>
</div>

{% stylesheet %}
  .slideshow-slide__media :is(img, .hero__placeholder) {
    border-radius: 0;
    scale: 1;
    clip-path: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide[data-image-zoom='true'].swiper-slide-active .slideshow-slide__media :is(img, .hero__placeholder) {
      animation: slideshow-image-zoom-out .6s ease-out both;
    }

    .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide[data-image-zoom='true'].slideshow-slide--loop-reset .slideshow-slide__media :is(img, .hero__placeholder) {
      animation: none;
    }
  }

  @keyframes slideshow-image-zoom-out {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }

  .slideshow-slide { min-height: inherit; isolation: isolate; overflow: hidden; }
  .slideshow-slide .slideshow-slide__surface { grid-template-rows: minmax(0, 1fr); min-height: inherit; height: 100%; overflow: hidden; }
  .slideshow-slide__media picture, .slideshow-slide__media img, .slideshow-slide__media svg, .slideshow-slide__video { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; }
  .slideshow-slide__overlay { position: absolute; inset: 0; background: var(--slideshow-slide-overlay, #00000033); }
  .slideshow-slide .hero__container { --page-margin-current: var(--page-margin-desktop); padding-block: 7rem; padding-inline: var(--page-margin-current); }
  .slideshow-slide__content { pointer-events: none; }
  .slideshow-slide__content-inner { gap: var(--slideshow-slide-gap, 1.2rem); color: var(--body-color); pointer-events: auto; }
  .slideshow-slide__media--secondary { display: none; }
  .slideshow-slide--split .slideshow-slide__surface { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .slideshow-slide--split .slideshow-slide__surface > .slideshow-slide__media--primary { position: relative; grid-column: 1; grid-row: 1; }
  .slideshow-slide--split .slideshow-slide__surface > .slideshow-slide__media--secondary { display: block; position: relative; grid-column: 2; grid-row: 1; min-height: inherit; }
  .slideshow-slide--split .slideshow-slide__content { grid-column: 1; grid-row: 1; width: 100%; }
  .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide__content { visibility: hidden; pointer-events: none; }
  .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide.swiper-slide-active .slideshow-slide__content { visibility: visible; pointer-events: auto; }
  .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide:not(.swiper-slide-active) .slideshow-slide__content-inner > :not(style):not(script) { opacity: 0; transform: translateY(1.6rem); }
  .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide.swiper-slide-active .slideshow-slide__content-inner > :not(style):not(script) { animation: slideshow-content-in .5s ease both; animation-delay: calc(var(--slideshow-block-index, 0) * 75ms); }
  .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide.swiper-slide-clone.swiper-slide-active .slideshow-slide__content-inner > :not(style):not(script), .slideshow__swiper[data-swiper-ready='true'] .slideshow-slide.slideshow-slide--loop-reset .slideshow-slide__content-inner > :not(style):not(script) { animation: none; opacity: 1; transform: none; }
  .slideshow-slide__content-inner > :not(style):not(script):nth-child(1) { --slideshow-block-index: 0; }.slideshow-slide__content-inner > :not(style):not(script):nth-child(2) { --slideshow-block-index: 1; }.slideshow-slide__content-inner > :not(style):not(script):nth-child(3) { --slideshow-block-index: 2; }.slideshow-slide__content-inner > :not(style):not(script):nth-child(4) { --slideshow-block-index: 3; }.slideshow-slide__content-inner > :not(style):not(script):nth-child(5) { --slideshow-block-index: 4; }.slideshow-slide__content-inner > :not(style):not(script):nth-child(6) { --slideshow-block-index: 5; }
  @keyframes slideshow-content-in { to { opacity: 1; transform: translateY(0); } }
  @media (min-width: 768px) and (max-width: 1149.98px) { .slideshow-slide .hero__container { --page-margin-current: var(--page-margin-tablet); } }
  @media (max-width: 767.98px) {
    .slideshow-slide .hero__container { --page-margin-current: var(--page-margin-mobile); padding-block: 5rem; padding-inline: var(--page-margin-current); }
    .slideshow-slide__content-inner { gap: var(--slideshow-slide-gap-mobile, var(--slideshow-slide-gap, 1.2rem)); }
    .slideshow-slide--split .slideshow-slide__surface { grid-template-columns: 1fr; grid-template-rows: 1fr; }
    .slideshow-slide--split .slideshow-slide__surface > .slideshow-slide__media--primary { grid-column: 1; grid-row: 1; }
    .slideshow-slide--split .slideshow-slide__surface > .slideshow-slide__media--secondary { display: none; }
    .slideshow-slide--split .slideshow-slide__content { grid-column: 1; grid-row: 1; width: 100%; }
  }
{% endstylesheet %}

