{% doc %}
  Renders the lead article and supporting cards for Featured Blog Posts.

  Blog Grid owns the selected blog, item count, and responsive composition. Its
  static First card and Blog card children own the editable card presentation;
  article resources are passed to those shared compositions through `closest`.
  @param {boolean} [use_section_blog] - Use the supplied section blog, including an intentionally blank selection
{% enddoc %}

{% liquid
  if use_section_blog
    assign blog_grid_source = section.settings.blog
  else
    assign blog_grid_source = closest.blog | default: block.settings.blog | default: blog
  endif
  assign blog_grid_layout = block.settings.layout | default: 'horizontal'
  unless blog_grid_layout == 'horizontal' or blog_grid_layout == 'vertical'
    assign blog_grid_layout = 'horizontal'
  endunless

  assign blog_grid_card_count = block.settings.max_posts | default: 3 | plus: 0
  if blog_grid_card_count < 1 or blog_grid_card_count > 8
    assign blog_grid_card_count = 3
  endif

  assign blog_grid_columns_desktop = block.settings.desktop_columns | default: 2 | plus: 0
  if blog_grid_columns_desktop < 2 or blog_grid_columns_desktop > 6
    assign blog_grid_columns_desktop = 2
  endif
  assign blog_grid_columns_mobile = block.settings.mobile_columns | default: 1 | plus: 0
  if blog_grid_columns_mobile < 1 or blog_grid_columns_mobile > 2
    assign blog_grid_columns_mobile = 1
  endif

  assign blog_grid_featured_width = block.settings.horizontal_split | default: 65 | split: '-' | first | plus: 0
  if blog_grid_featured_width < 50 or blog_grid_featured_width > 75
    assign blog_grid_featured_width = 65
  endif
  assign blog_grid_secondary_width = 100 | minus: blog_grid_featured_width
  assign blog_grid_horizontal_columns = 'minmax(0, ' | append: blog_grid_featured_width | append: 'fr) minmax(0, ' | append: blog_grid_secondary_width | append: 'fr)'

  assign blog_grid_secondary_limit = blog_grid_card_count
  assign blog_grid_placeholder_article = blank
  assign blog_grid_gap_desktop = block.settings.gap_desktop | default: 8 | plus: 0
  assign blog_grid_gap_mobile = block.settings.gap_mobile | default: 16 | plus: 0
  assign blog_grid_class = 'blog-grid'
  if block.settings.sticky and blog_grid_layout == 'horizontal'
    assign blog_grid_class = blog_grid_class | append: ' blog-grid--sticky'
  endif
  assign blog_grid_layout_class = 'blog-grid__layout blog-grid__layout--' | append: blog_grid_layout
  if blog_grid_source != blank and blog_grid_source.articles.size < 2
    assign blog_grid_layout_class = blog_grid_layout_class | append: ' blog-grid__layout--single'
  endif
%}

{% assign blog_grid_first_card_content = blank %}
{% assign blog_grid_secondary_content = blank %}
{% capture blog_grid_content %}
  {% if blog_grid_source != blank and blog_grid_source.articles != blank %}
    {% assign blog_grid_first_article = blog_grid_source.articles.first %}
    <div class="{{ blog_grid_layout_class }}">
      {% capture blog_grid_first_card_content %}{% content_for 'block', type: 'first-card', id: 'first-card', closest.article: blog_grid_first_article, blog: blog_grid_source %}{% endcapture %}
      {% render 'section-content-slot', content: blog_grid_first_card_content, class: 'blog-grid__first-card' %}
      {% if blog_grid_source.articles.size > 1 %}
        {% capture blog_grid_secondary_content %}
          {% for blog_grid_article in blog_grid_source.articles offset: 1 limit: blog_grid_secondary_limit %}
            {% capture blog_grid_card_content %}{% content_for 'block', type: 'blog-card', id: 'blog-card', closest.article: blog_grid_article, blog: blog_grid_source, placeholder: false %}{% endcapture %}
            {% render 'section-content-slot', content: blog_grid_card_content, class: 'blog-grid__item' %}
          {% endfor %}
        {% endcapture %}
        {% render 'section-content-slot', content: blog_grid_secondary_content, class: 'blog-grid__items' %}
      {% endif %}
    </div>
  {% elsif request.design_mode %}
    <div class="{{ blog_grid_layout_class }}">
      {% capture blog_grid_first_card_content %}{% content_for 'block', type: 'first-card', id: 'first-card', closest.article: blog_grid_placeholder_article, blog: blog_grid_source, placeholder: true %}{% endcapture %}
      {% render 'section-content-slot', content: blog_grid_first_card_content, class: 'blog-grid__first-card' %}
      {% capture blog_grid_secondary_content %}
        {% for blog_grid_placeholder in (1..blog_grid_secondary_limit) %}
          {% capture blog_grid_card_content %}{% content_for 'block', type: 'blog-card', id: 'blog-card', closest.article: blog_grid_placeholder_article, blog: blog_grid_source, placeholder: true %}{% endcapture %}
          {% render 'section-content-slot', content: blog_grid_card_content, class: 'blog-grid__item' %}
        {% endfor %}
      {% endcapture %}
      {% render 'section-content-slot', content: blog_grid_secondary_content, class: 'blog-grid__items' %}
    </div>
  {% endif %}
{% endcapture %}
{% assign blog_grid_first_card_content = blog_grid_first_card_content | strip %}
{% assign blog_grid_secondary_content = blog_grid_secondary_content | strip %}

<div
  class="{{ blog_grid_class }}"
  style="--blog-grid-gap-desktop: {{ blog_grid_gap_desktop }}px; --blog-grid-gap-mobile: {{ blog_grid_gap_mobile }}px; --blog-grid-columns-horizontal: {{ blog_grid_horizontal_columns }}; --blog-grid-columns-desktop: {{ blog_grid_columns_desktop }}; --blog-grid-columns-mobile: {{ blog_grid_columns_mobile }};"
  {% if blog_grid_first_card_content == blank and blog_grid_secondary_content == blank %}data-content-empty{% endif %}
  {{ block.shopify_attributes }}
>
  {{ blog_grid_content }}
</div>

{% stylesheet %}
  .blog-grid {
    width: 100%;
    min-width: 0;
  }

  .blog-grid__layout {
    display: grid;
    grid-template-columns: var(--blog-grid-columns-horizontal, minmax(0, 1.8fr) minmax(0, 1fr));
    align-items: stretch;
    gap: var(--blog-grid-gap-desktop, 8px);
    min-width: 0;
  }

  .blog-grid__layout:not(:has(> .blog-grid__first-card)),
  .blog-grid__layout:not(:has(> .blog-grid__items)),
  .blog-grid__layout--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .blog-grid__layout--vertical {
    grid-template-columns: minmax(0, 1fr);
  }

  .blog-grid__first-card,
  .blog-grid__items,
  .blog-grid__item {
    min-width: 0;
  }

  .blog-grid__items {
    display: grid;
    grid-auto-rows: minmax(116px, 1fr);
    gap: var(--blog-grid-gap-desktop, 8px);
    min-height: 0;
  }

  .blog-grid__layout--vertical .blog-grid__items {
    grid-template-columns: repeat(var(--blog-grid-columns-desktop, 2), minmax(0, 1fr));
    grid-auto-rows: auto;
  }

  .blog-grid__item > .blog-card {
    min-height: 116px;
    height: 100%;
  }

  .blog-grid__layout--vertical .blog-grid__item > .blog-card {
    height: auto;
  }

  @media (min-width: 768px) {
    .blog-grid--sticky .blog-grid__layout--horizontal .blog-grid__first-card {
      position: sticky;
      top: calc(var(--header-height, 0px) + 1rem);
      align-self: start;
    }
  }

  @media (max-width: 767.98px) {
    .blog-grid__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--blog-grid-gap-mobile, 16px);
    }

    .blog-grid__items {
      gap: var(--blog-grid-gap-mobile, 16px);
    }

    .blog-grid__layout--vertical .blog-grid__items {
      grid-template-columns: repeat(var(--blog-grid-columns-mobile, 1), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

