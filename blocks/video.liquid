          "value": "square",
          "label": "t:options.aspect_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.aspect_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.aspect_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.aspect_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.aspect_ratio.custom"
        }
      ],
