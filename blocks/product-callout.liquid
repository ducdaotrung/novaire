        },
        {
          "value": "extra_small",
          "label": "t:options.hero_height.extra_small"
        },
        {
          "value": "small",
          "label": "t:options.hero_height.small"
        },
        {
          "value": "medium",
          "label": "t:options.hero_height.medium"
        },
        {
          "value": "large",
          "label": "t:options.hero_height.large"
        },
        {
          "value": "extra_large",
          "label": "t:options.hero_height.extra_large"
        },
        {
          "value": "full_screen",
          "label": "t:options.hero_height.full_screen"
        }
      ],
