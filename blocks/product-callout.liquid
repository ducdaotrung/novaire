    },
    {
      "type": "select",
      "id": "content_panel_width",
      "label": "t:labels.content_width",
      "options": [
        {
          "value": "30",
          "label": "t:options.hero_height.small"
        },
        {
          "value": "40",
          "label": "t:options.hero_height.medium"
        },
        {
          "value": "50",
          "label": "t:options.hero_height.large"
        },
        {
          "value": "60",
          "label": "t:options.hero_height.extra_large"
        }
      ],
      "default": "30",
      "visible_if": "{{ block.settings.content_layout == 'split' }}"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
