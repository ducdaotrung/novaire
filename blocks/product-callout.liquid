        {
          "value": "split",
          "label": "t:options.product_callout_content_layout.split"
        }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "first",
