{% doc %}
  Renders the one-column carousel owned by Testimonial: split.
{% enddoc %}

{% liquid
  assign transition = block.settings.transition_style | default: 'slide'
  unless transition == 'slide' or transition == 'fade'
    assign transition = 'slide'
  endunless
  assign carousel_id = 'TestimonialSplit-' | append: block.id
  assign speed = block.settings.autoplay_speed | default: 4 | at_least: 3 | at_most: 7
  assign delay = speed | times: 1000
  assign carousel_label = 'general.testimonial_split' | t
%}
<script data-theme-module="{{ 'testimonial-split.js' | asset_url }}"></script>
{% if transition == 'fade' %}
  <link rel="stylesheet" href="{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url | stylesheet_tag }}</noscript>
{% endif %}
{% capture slides %}{% content_for 'blocks' %}{% endcapture %}
{% capture carousel_style %}
  --carousel-padding-top: {{ block.settings.padding_top | default: 0 }}px;
  --carousel-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
  {% if block.settings.customize_mobile_padding %}
    --carousel-padding-top-mobile: {{ block.settings.padding_top_mobile | default: 0 }}px;
    --carousel-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile | default: 0 }}px;
  {% endif %}
{% endcapture %}
<div class="testimonial-split-carousel" style="{{ carousel_style | strip }}" data-testimonial-split
  data-transition="{{ transition }}" data-swiper-columns-desktop="1" data-swiper-columns-mobile="1"
  data-swiper-gap-desktop="0" data-swiper-gap-mobile="0" data-swiper-pagination-desktop="false" data-swiper-pagination-mobile="false"
  data-carousel-loop="{{ block.settings.loop }}" data-swiper-autoplay="{{ block.settings.autoplay }}"
  data-swiper-autoplay-pause-on-hover="{{ block.settings.pause_on_hover }}" data-swiper-autoplay-delay="{{ delay }}"
  {{ block.shopify_attributes }}>
  {% render 'swiper-carousel', id: carousel_id, content: slides, root_class: 'testimonial-split-carousel__viewport', aria_label: carousel_label, autoplay: block.settings.autoplay, pause_on_hover: block.settings.pause_on_hover, autoplay_delay: delay, show_next_slide_preview: false, show_next_slide_preview_on_mobile: false %}
</div>
{% stylesheet %}
  .testimonial-split-carousel { width: 100%; min-width: 0; padding-block: var(--carousel-padding-top, 0px) var(--carousel-padding-bottom, 0px); }
  .testimonial-split-carousel__viewport > .swiper-wrapper { column-gap: 0; }
  .testimonial-split-carousel__viewport { width: 100%; min-width: 0; }
  .testimonial-split-carousel__viewport > .swiper-wrapper > .testimonial-split-slide { flex-basis: 100%; }
  .testimonial-split-carousel .swiper:not(.swiper-initialized) .testimonial-split-controls,
  .testimonial-split-carousel .swiper-initialized .swiper-slide:not(.swiper-slide-active) .testimonial-split-controls { visibility: hidden; }
  .testimonial-split-carousel.carousel-block--locked .testimonial-split-controls { display: none; }
  @media (max-width: 767.98px) {
    .testimonial-split-carousel { padding-block: var(--carousel-padding-top-mobile, var(--carousel-padding-top, 0px)) var(--carousel-padding-bottom-mobile, var(--carousel-padding-bottom, 0px)); }
  }
{% endstylesheet %}
