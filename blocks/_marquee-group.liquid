{% liquid
 assign direction = block.settings.direction | default: 'vertical'
 assign align = block.settings.alignment | default: 'left'
 assign radius = '0px'
 case block.settings.corner_radius
  when 'inherit'
   assign radius = 'var(--card-radius,0px)'
  when 'rounded'
   assign radius = 'var(--radius-rounded)'
  when 'custom'
   assign radius = block.settings.custom_corner_radius | append: 'px'
 endcase
%}
<div class="marquee-group marquee-group--{{ direction }} marquee-group--{{ align }} marquee-group--shadow-{{ block.settings.shadow }}{% if block.settings.color_type == 'scheme' %} color-scheme {{ block.settings.color_scheme }} section-color-scope{% endif %}" style="--mq-group-gap:{{ block.settings.gap_desktop | default: 20 }}px;--mq-group-gap-mobile:{{ block.settings.gap_mobile | default: 20 }}px;--mq-group-border:{{ block.settings.border_thickness | default: 0 }}px;--mq-group-radius:{{ radius }};--mq-pad-top:{{ block.settings.padding_top | default: 0 }}px;{% if block.settings.customize_mobile_padding %}--mq-pad-top-mobile:{{ block.settings.padding_top_mobile | default: 0 }}px;{% endif %}--mq-pad-bottom:{{ block.settings.padding_bottom | default: 0 }}px;{% if block.settings.customize_mobile_padding %}--mq-pad-bottom-mobile:{{ block.settings.padding_bottom_mobile | default: 0 }}px;{% endif %}--mq-pad-left:{{ block.settings.padding_left | default: 0 }}px;{% if block.settings.customize_mobile_padding %}--mq-pad-left-mobile:{{ block.settings.padding_left_mobile | default: 0 }}px;{% endif %}--mq-pad-right:{{ block.settings.padding_right | default: 0 }}px;{% if block.settings.customize_mobile_padding %}--mq-pad-right-mobile:{{ block.settings.padding_right_mobile | default: 0 }}px;{% endif %}" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}
.marquee-group{display:flex;flex:0 0 auto;width:max-content;flex-direction:column;gap:var(--mq-group-gap);border:var(--mq-group-border) solid var(--border-color);border-radius:var(--mq-group-radius);background:var(--background-color);}
.marquee-group--horizontal{flex-direction:row;align-items:center;}.marquee-group--vertical{align-items:flex-start;}.marquee-group--vertical.marquee-group--center{align-items:center;}.marquee-group--vertical.marquee-group--right{align-items:flex-end;}.marquee-group--horizontal.marquee-group--center{justify-content:center;}.marquee-group--horizontal.marquee-group--right{justify-content:flex-end;}.marquee-group>*{min-width:0;max-width:100%;}.marquee-group--shadow-xs{box-shadow:0 1px 2px color-mix(in srgb,var(--shadow-color) 10%,transparent);}.marquee-group--shadow-sm{box-shadow:0 2px 4px color-mix(in srgb,var(--shadow-color) 12%,transparent);}.marquee-group--shadow-md{box-shadow:0 4px 8px color-mix(in srgb,var(--shadow-color) 14%,transparent);}.marquee-group--shadow-lg{box-shadow:0 8px 16px color-mix(in srgb,var(--shadow-color) 18%,transparent);}
@media(max-width:767.98px){.marquee-group{gap:var(--mq-group-gap-mobile);}}
.marquee-group{padding-top:var(--mq-pad-top,0px);padding-bottom:var(--mq-pad-bottom,0px);padding-left:var(--mq-pad-left,0px);padding-right:var(--mq-pad-right,0px);}
@media(max-width:767.98px){.marquee-group{padding-top:var(--mq-pad-top-mobile,var(--mq-pad-top,0px));padding-bottom:var(--mq-pad-bottom-mobile,var(--mq-pad-bottom,0px));padding-left:var(--mq-pad-left-mobile,var(--mq-pad-left,0px));padding-right:var(--mq-pad-right-mobile,var(--mq-pad-right,0px));}}
{% endstylesheet %}

{% schema %}
{
