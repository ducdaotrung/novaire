{% doc %}
  Fixed Search input. Smart results are siblings beneath this SAME form input.
  Uses global form/heading tokens and the shared predictive renderer.
{% enddoc %}
{% liquid
 assign input_id = 'SearchPageInput-' | append: section.id | append: '-' | append: block.id
 assign results_id = 'SearchSuggestions-' | append: section.id | append: '-' | append: block.id
 assign heading = block.settings.heading
 if heading == blank
  assign heading = 'search.results_title' | t
 endif
 assign placeholder = block.settings.placeholder
 if placeholder == blank
  assign placeholder = 'search.placeholder' | t
 endif
 assign search_heading_custom_size = block.settings.custom_heading_size | default: 24 | plus: 0
 assign search_label = 'search.title' | t
 assign types = ''
 if block.settings.show_products
  assign types = ',product'
 endif
 if block.settings.show_blog_posts
  assign types = types | append: ',article'
 endif
 if block.settings.show_pages
  assign types = types | append: ',page'
 endif
 assign types = types | remove_first: ','
%}
{% capture search_heading_size %}{% render 'heading-size-token', size: block.settings.heading_size, fallback: 'xl' %}{% endcapture %}
{% assign search_heading_size = search_heading_size | strip %}
<div class="search-page__header" {{ block.shopify_attributes }} style="--search-input-gap:{{ block.settings.gap }}px;--search-input-width:{{ block.settings.input_width }}px;--search-input-height:{{ block.settings.input_height }}px;--search-input-padding:{{ block.settings.input_padding }}px">
 <{{ block.settings.heading_tag }} class="search-page__title heading-block heading-text heading-{{ search_heading_size }}"{% if search_heading_size == 'custom' %} style="--heading-block-custom-size: {{ search_heading_custom_size }}px"{% endif %}>{{ heading }}</{{ block.settings.heading_tag }}>
 <div class="search-page__smart-anchor" data-search-smart data-smart-enabled="{{ block.settings.enable_smart_search }}" data-show-products="{{ block.settings.show_products }}" data-show-collections="{{ block.settings.show_collections }}" data-show-blog-posts="{{ block.settings.show_blog_posts }}" data-show-pages="{{ block.settings.show_pages }}" data-show-recent="{{ block.settings.show_recently_viewed }}" data-recent-limit="{{ block.settings.recently_viewed_limit }}" data-predictive-search-url="{{ routes.predictive_search_url }}" data-search-url="{{ routes.search_url }}" data-products-label="{{ 'search.products' | t | escape }}" data-collections-label="{{ 'search.collections' | t | escape }}" data-blog-posts-label="{{ 'search.blog_posts' | t | escape }}" data-pages-label="{{ 'search.pages' | t | escape }}" data-suggestions-label="{{ 'search.suggestions' | t | escape }}" data-recent-searches-label="{{ 'search.recent_searches' | t | escape }}" data-clear-history-label="{{ 'search.clear_recent_searches' | t | escape }}" data-recent-label="{{ 'search.recently_viewed' | t | escape }}" data-loading-label="{{ 'accessibility.loading' | t | escape }}" data-error-label="{{ 'search.predictive_error' | t | escape }}" data-no-results-label="{{ 'search.no_results' | t | escape }}" data-view-all-label="{{ 'search.view_all_results' | t | escape }}">
  <form class="search-page__form{% if search.terms != blank %} has-query{% endif %}" action="{{ routes.search_url }}" method="get" role="search">
    {% render 'form-field', id: input_id, name: 'q', label: search_label, type: 'search', value: search.terms, placeholder: placeholder, autocomplete: 'off', hide_label: true, class: 'search-page__field body-text body-md' %}
    <button class="search-page__submit" type="submit" aria-label="{{ 'search.submit' | t | escape }}">{% render 'icon', icon: 'magnifying-glass', bare: true %}</button>
    <button class="search-page__clear overlay-close" type="button" data-search-page-clear aria-label="{{ 'search.clear' | t | escape }}"{% if search.terms == blank %} hidden{% endif %}>{% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}</button>
    <input type="hidden" name="options[prefix]" value="last">
    {% if types != blank %}<input type="hidden" name="type" value="{{ types }}">{% endif %}
  </form>
  <div id="{{ results_id }}" class="search-suggestions" data-search-smart-results role="region" aria-label="{{ 'search.title' | t | escape }}" aria-live="polite" hidden></div>
 </div>
 <button class="search-smart__backdrop" data-search-smart-backdrop type="button" tabindex="-1" aria-label="{{ 'search.close' | t | escape }}" hidden></button>
</div>
{% stylesheet %}
.search-page__header { display: grid; gap: var(--search-input-gap); margin-block-end: 40px; }
.search-page__title { margin: 0; text-align: center; }
.search-page__title.heading-block { text-align: center; }
.search-page__smart-anchor { width: min(100%, var(--search-input-width)); margin-inline: auto; position: relative; }
.search-page__smart-anchor.is-open { z-index: calc(var(--z-modal, 1000) + 1); }
.search-page__form { display: flex; align-items: center; gap: 12px; min-height: var(--search-input-height); padding-inline: var(--search-input-padding); border: var(--input-border-width, 1px) solid var(--input-border-color, var(--border-color)); border-radius: var(--input-radius); background: var(--input-background-color); }
.search-page__smart-anchor.is-open .search-page__form { position: relative; z-index: 1; background-color: #fff; }
.search-page__form:focus-within { outline: 2px solid var(--input-focus-color); outline-offset: 2px; }
.search-page__field { flex: 1 1 auto; min-width: 0; }
.search-page__field .form__control.form__control--input { width: 100%; min-width: 0; min-height: 0; padding: 0; border: 0; outline: 0; box-shadow: none; background: transparent; border-radius: 0; font: inherit; }
.search-page__field input::-webkit-search-cancel-button { display: none; -webkit-appearance: none; }
.search-page__submit { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 40px; padding: 6px; border: 0; background: transparent; color: inherit; cursor: pointer; }
.search-page__submit svg { width: 20px; height: 20px; }
.search-page__form.has-query .search-page__submit { display: none; }
.search-page__clear[hidden] { display: none; }
.search-smart__backdrop { position: fixed; z-index: var(--z-modal, 1000); inset: 0; border: 0; width: 100%; height: 100dvh; background: rgb(0 0 0 / .45); backdrop-filter: blur(6px); cursor: pointer; }
.search-smart__backdrop[hidden] { display: none; }
@media (max-width: 767.98px) { .search-page__header { margin-block-end: 24px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.html_tag",
      "options": [
        { "value": "div", "label": "t:options.html_tag.paragraph" },
        { "value": "h1", "label": "t:options.html_tag.h1" },
        { "value": "h2", "label": "t:options.html_tag.h2" },
        { "value": "h3", "label": "t:options.html_tag.h3" },
        { "value": "h4", "label": "t:options.html_tag.h4" },
        { "value": "h5", "label": "t:options.html_tag.h5" },
        { "value": "h6", "label": "t:options.html_tag.h6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
      "options": [
        { "value": "display", "label": "t:options.heading_size.display" },
        { "value": "xl", "label": "t:options.heading_size.xl" },
        { "value": "lg", "label": "t:options.heading_size.lg" },
        { "value": "md", "label": "t:options.heading_size.md" },
        { "value": "sm", "label": "t:options.heading_size.sm" },
        { "value": "xs", "label": "t:options.heading_size.xs" },
        { "value": "custom", "label": "t:options.heading_size.custom" }
      ],
      "default": "xl"
    },
    {
      "type": "range",
      "id": "custom_heading_size",
      "label": "Custom size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "input_width",
      "label": "t:labels.search_input_width",
      "min": 320,
      "max": 800,
      "step": 10,
      "default": 550,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "input_height",
      "label": "t:labels.search_input_height",
      "min": 40,
      "max": 80,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "input_padding",
      "label": "t:labels.search_input_padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:labels.placeholder"
    },
    {
      "type": "checkbox",
      "id": "enable_smart_search",
      "label": "t:labels.enable_smart_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "t:labels.search_recently_viewed",
      "default": true,
      "visible_if": "{{ block.settings.enable_smart_search }}"
    },
    {
      "type": "range",
      "id": "recently_viewed_limit",
      "label": "t:labels.search_recently_viewed_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.enable_smart_search and block.settings.show_recently_viewed }}"
    },
    {
      "type": "header",
      "content": "t:labels.search_types"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "t:labels.products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "t:labels.collections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_blog_posts",
      "label": "t:labels.blog_posts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pages",
      "label": "t:labels.pages",
      "default": true
    }
  ]
}
{% endschema %}
