          "value": "secondary",
          "label": "t:options.button_variant.secondary"
        },
        {
          "value": "tertiary",
          "label": "t:options.button_variant.tertiary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        { "value": "inherit", "label": "t:options.radius_preset.inherit" },
        { "value": "square", "label": "t:options.radius_preset.square" },
        { "value": "rounded", "label": "t:options.radius_preset.rounded" },
        { "value": "custom", "label": "t:options.radius_preset.custom" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:labels.custom_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
