{% liquid
  assign bundle_summary_desktop_scheme = block.settings.desktop_color_scheme | default: 'scheme-1'
  if block.settings.desktop_color_scheme.id != blank
    assign bundle_summary_desktop_scheme = block.settings.desktop_color_scheme.id
  endif
  assign bundle_summary_desktop_scheme = bundle_summary_desktop_scheme | default: 'scheme-1' | handleize

  assign bundle_summary_mobile_scheme = block.settings.mobile_color_scheme | default: 'scheme-3'
  if block.settings.mobile_color_scheme.id != blank
    assign bundle_summary_mobile_scheme = block.settings.mobile_color_scheme.id
  endif
  assign bundle_summary_mobile_scheme = bundle_summary_mobile_scheme | default: 'scheme-3' | handleize

  assign bundle_summary_corner_radius = block.settings.corner_radius | default: 'square'
  unless bundle_summary_corner_radius == 'inherit' or bundle_summary_corner_radius == 'square' or bundle_summary_corner_radius == 'rounded' or bundle_summary_corner_radius == 'custom'
    assign bundle_summary_corner_radius = 'square'
  endunless
  assign bundle_summary_custom_corner_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  if bundle_summary_custom_corner_radius < 0 or bundle_summary_custom_corner_radius > 40
    assign bundle_summary_custom_corner_radius = 0
  endif
  assign bundle_summary_corner_radius_value = 'var(--radius-square)'
  case bundle_summary_corner_radius
    when 'inherit'
      assign bundle_summary_corner_radius_value = 'var(--media-radius, var(--radius-square))'
    when 'rounded'
      assign bundle_summary_corner_radius_value = 'var(--radius-rounded)'
    when 'custom'
      assign bundle_summary_corner_radius_value = 'var(--bundle-summary-custom-radius)'
  endcase

  assign bundle_summary_initial_message = block.settings.initial_message | strip_html | strip
  assign bundle_summary_unlocked_message = block.settings.unlocked_message | strip_html | strip
  assign bundle_summary_message_font_size = block.settings.progress_font_size | default: 'md'
  unless bundle_summary_message_font_size == 'xs' or bundle_summary_message_font_size == 'sm' or bundle_summary_message_font_size == 'md' or bundle_summary_message_font_size == 'lg' or bundle_summary_message_font_size == 'xl' or bundle_summary_message_font_size == 'xxl'
    assign bundle_summary_message_font_size = 'md'
  endunless
  assign bundle_add_bundle_label = 'bundle_builder.add_bundle' | t
  assign bundle_summary_heading_label = block.settings.heading | strip_html | strip | default: 'Your bundle'
  assign bundle_summary_progress_id = 'BundleSummaryProgress-' | append: section.id | append: '-' | append: block.id | handleize
  assign bundle_summary_items_id = 'BundleSummaryItems-' | append: section.id | append: '-' | append: block.id | handleize
  assign bundle_summary_zero_price = 0 | money
  if settings.price_currency_code_product_cards
    assign bundle_summary_zero_price = 0 | money_with_currency
  endif
  assign bundle_summary_padding_vertical_mobile = block.settings.padding_vertical | default: 30 | plus: 0
  if block.settings.customize_mobile_padding == true
    assign bundle_summary_padding_vertical_mobile = block.settings.padding_vertical_mobile | default: 24 | plus: 0
  endif
  assign bundle_tier_1_label = block.settings.discount_label
  assign bundle_tier_1_minimum_type = block.settings.minimum_requirement | default: 'quantity'
  assign bundle_tier_1_minimum_quantity = block.settings.minimum_quantity | default: 3 | plus: 0
  if bundle_tier_1_minimum_quantity < 2
    assign bundle_tier_1_minimum_quantity = 2
  elsif bundle_tier_1_minimum_quantity > 10
    assign bundle_tier_1_minimum_quantity = 10
  endif
  assign bundle_tier_1_enabled = true
  assign bundle_tier_2_enabled = block.settings.enable_tier_2
  assign bundle_tier_3_enabled = block.settings.enable_tier_3
  assign bundle_tier_2_label = block.settings.tier_2_label
  assign bundle_tier_2_minimum_quantity = block.settings.tier_2_minimum_quantity | default: 5 | plus: 0
  if bundle_tier_2_minimum_quantity < 3
    assign bundle_tier_2_minimum_quantity = 3
  elsif bundle_tier_2_minimum_quantity > 10
    assign bundle_tier_2_minimum_quantity = 10
  endif
  assign bundle_tier_3_label = block.settings.tier_3_label
  assign bundle_tier_3_minimum_quantity = block.settings.tier_3_minimum_quantity | default: 7 | plus: 0
  if bundle_tier_3_minimum_quantity < 4
    assign bundle_tier_3_minimum_quantity = 4
  elsif bundle_tier_3_minimum_quantity > 10
    assign bundle_tier_3_minimum_quantity = 10
  endif
  assign bundle_summary_placeholder_count = 3
  if bundle_tier_1_minimum_type == 'quantity'
    assign bundle_summary_placeholder_count = bundle_tier_1_minimum_quantity
    if bundle_tier_2_enabled and bundle_tier_2_minimum_quantity < bundle_summary_placeholder_count
      assign bundle_summary_placeholder_count = bundle_tier_2_minimum_quantity
    endif
    if bundle_tier_3_enabled and bundle_tier_3_minimum_quantity < bundle_summary_placeholder_count
      assign bundle_summary_placeholder_count = bundle_tier_3_minimum_quantity
    endif
  endif

  assign bundle_mobile_background = settings.background_color | default: '#FFFFFF'
  assign bundle_mobile_heading = settings.foreground_color | default: '#1C1B1A'
  assign bundle_mobile_heading_highlight = '#A67C52'
  assign bundle_mobile_body = settings.foreground_color | default: '#1C1B1A'
  assign bundle_mobile_accent = settings.color_accent | default: bundle_mobile_body
  assign bundle_mobile_border = settings.color_border | default: '#D7D0C8'
  assign bundle_mobile_shadow = bundle_mobile_body
  assign bundle_mobile_sale_price = '#9A3D32'
  assign bundle_mobile_primary_background = bundle_mobile_accent
  assign bundle_mobile_primary_text = bundle_mobile_background
  assign bundle_mobile_primary_border = bundle_mobile_accent
  assign bundle_mobile_primary_hover_background = 'transparent'
  assign bundle_mobile_primary_hover_text = bundle_mobile_accent
  assign bundle_mobile_primary_hover_border = bundle_mobile_accent
  assign bundle_mobile_secondary_background = bundle_mobile_background
  assign bundle_mobile_secondary_text = bundle_mobile_accent
  assign bundle_mobile_secondary_border = bundle_mobile_accent
  assign bundle_mobile_secondary_hover_background = 'transparent'
  assign bundle_mobile_secondary_hover_text = bundle_mobile_accent
  assign bundle_mobile_secondary_hover_border = bundle_mobile_accent
  assign bundle_mobile_tertiary_text = bundle_mobile_accent
  assign bundle_mobile_tertiary_hover_text = bundle_mobile_accent

  for scheme in settings.color_schemes
    if scheme.id == bundle_summary_mobile_scheme
      assign bundle_mobile_background = scheme.settings.background | default: bundle_mobile_background
      assign bundle_mobile_heading = scheme.settings.heading | default: bundle_mobile_heading
      assign bundle_mobile_heading_highlight = scheme.settings.heading_highlight | default: bundle_mobile_heading_highlight
      assign bundle_mobile_body = scheme.settings.text | default: bundle_mobile_body
      assign bundle_mobile_accent = scheme.settings.accent | default: bundle_mobile_accent
      assign bundle_mobile_border = scheme.settings.border | default: bundle_mobile_border
      assign bundle_mobile_shadow = scheme.settings.shadow | default: bundle_mobile_shadow
      assign bundle_mobile_sale_price = scheme.settings.sale_price | default: bundle_mobile_sale_price
      assign bundle_mobile_primary_background = scheme.settings.button_primary_background | default: bundle_mobile_primary_background
      assign bundle_mobile_primary_text = scheme.settings.button_primary_text | default: bundle_mobile_primary_text
      assign bundle_mobile_primary_border = scheme.settings.button_primary_border | default: bundle_mobile_primary_border
      assign bundle_mobile_primary_hover_background = scheme.settings.button_primary_hover_background | default: bundle_mobile_primary_hover_background
      assign bundle_mobile_primary_hover_text = scheme.settings.button_primary_hover_text | default: bundle_mobile_primary_hover_text
      assign bundle_mobile_primary_hover_border = scheme.settings.button_primary_hover_border | default: bundle_mobile_primary_hover_border
      assign bundle_mobile_secondary_background = scheme.settings.button_secondary_background | default: bundle_mobile_secondary_background
      assign bundle_mobile_secondary_text = scheme.settings.button_secondary_text | default: bundle_mobile_secondary_text
      assign bundle_mobile_secondary_border = scheme.settings.button_secondary_border | default: bundle_mobile_secondary_border
      assign bundle_mobile_secondary_hover_background = scheme.settings.button_secondary_hover_background | default: bundle_mobile_secondary_hover_background
      assign bundle_mobile_secondary_hover_text = scheme.settings.button_secondary_hover_text | default: bundle_mobile_secondary_hover_text
      assign bundle_mobile_secondary_hover_border = scheme.settings.button_secondary_hover_border | default: bundle_mobile_secondary_hover_border
      assign bundle_mobile_tertiary_text = scheme.settings.button_tertiary_text | default: bundle_mobile_tertiary_text
      assign bundle_mobile_tertiary_hover_text = scheme.settings.button_tertiary_hover_text | default: bundle_mobile_tertiary_hover_text
    endif
  endfor
  assign bundle_mobile_body_rgb = bundle_mobile_body | color_to_rgb | remove: 'rgb(' | remove: ')' | replace: ',', ' ' | strip
%}

{% capture bundle_goals %}
  [
    {
      "enabled": {{ bundle_tier_1_enabled | json }},
      "label": {{ bundle_tier_1_label | json }},
      "minimumType": {{ bundle_tier_1_minimum_type | json }},
      "minimumQuantity": {{ bundle_tier_1_minimum_quantity | json }},
      "minimumAmount": {{ block.settings.minimum_amount | json }},
      "discountType": {{ block.settings.discount_type | json }},
      "discountMethod": {{ block.settings.discount_method | json }},
      "discountPercentage": {{ block.settings.discount_percentage | json }},
      "discountAmount": {{ block.settings.discount_amount | json }},
      "onlyApplyOncePerOrder": {{ block.settings.only_apply_discount_once_per_order | json }}
    },
    {
      "enabled": {{ bundle_tier_2_enabled | json }},
      "label": {{ bundle_tier_2_label | json }},
      "minimumType": {{ block.settings.minimum_requirement | json }},
      "minimumQuantity": {{ bundle_tier_2_minimum_quantity | json }},
      "minimumAmount": {{ block.settings.tier_2_minimum_amount | json }},
      "discountType": {{ block.settings.tier_2_discount_type | json }},
      "discountMethod": {{ block.settings.discount_method | json }},
      "discountPercentage": {{ block.settings.tier_2_discount_percentage | json }},
      "discountAmount": {{ block.settings.tier_2_discount_amount | json }},
      "onlyApplyOncePerOrder": {{ block.settings.only_apply_discount_once_per_order | json }}
    },
    {
      "enabled": {{ bundle_tier_3_enabled | json }},
      "label": {{ bundle_tier_3_label | json }},
      "minimumType": {{ block.settings.minimum_requirement | json }},
      "minimumQuantity": {{ bundle_tier_3_minimum_quantity | json }},
      "minimumAmount": {{ block.settings.tier_3_minimum_amount | json }},
      "discountType": {{ block.settings.tier_3_discount_type | json }},
      "discountMethod": {{ block.settings.discount_method | json }},
      "discountPercentage": {{ block.settings.tier_3_discount_percentage | json }},
      "discountAmount": {{ block.settings.tier_3_discount_amount | json }},
      "onlyApplyOncePerOrder": {{ block.settings.only_apply_discount_once_per_order | json }}
    }
  ]
{% endcapture %}

{% capture bundle_summary_style %}
  --bundle-summary-gap: {{ block.settings.gap_desktop | default: 28 }}px;
  --bundle-summary-gap-mobile: {{ block.settings.gap_mobile | default: 16 }}px;
  --bundle-summary-border-width: {{ block.settings.border_thickness | default: 0 }}px;
  --bundle-summary-radius: {{ bundle_summary_corner_radius_value }};
  {% if bundle_summary_corner_radius == 'custom' %}--bundle-summary-custom-radius: {{ bundle_summary_custom_corner_radius }}px;{% endif %}
  --bundle-summary-padding-block: {{ block.settings.padding_vertical | default: 30 }}px;
  --bundle-summary-padding-inline: {{ block.settings.padding_horizontal | default: 30 }}px;
  --bundle-summary-padding-vertical-mobile: {{ bundle_summary_padding_vertical_mobile }}px;
  --bundle-summary-progress-color: {{ block.settings.progress_color | default: '#32A84C' }};
  --bundle-summary-mobile-background: {{ bundle_mobile_background }};
  --bundle-summary-mobile-heading: {{ bundle_mobile_heading }};
  --bundle-summary-mobile-heading-highlight: {{ bundle_mobile_heading_highlight }};
  --bundle-summary-mobile-body: {{ bundle_mobile_body }};
  --bundle-summary-mobile-body-rgb: {{ bundle_mobile_body_rgb }};
  --bundle-summary-mobile-accent: {{ bundle_mobile_accent }};
  --bundle-summary-mobile-border: {{ bundle_mobile_border }};
  --bundle-summary-mobile-shadow: {{ bundle_mobile_shadow }};
  --bundle-summary-mobile-sale-price: {{ bundle_mobile_sale_price }};
  --bundle-summary-mobile-primary-background: {{ bundle_mobile_primary_background }};
  --bundle-summary-mobile-primary-text: {{ bundle_mobile_primary_text }};
  --bundle-summary-mobile-primary-border: {{ bundle_mobile_primary_border }};
  --bundle-summary-mobile-primary-hover-background: {{ bundle_mobile_primary_hover_background }};
  --bundle-summary-mobile-primary-hover-text: {{ bundle_mobile_primary_hover_text }};
  --bundle-summary-mobile-primary-hover-border: {{ bundle_mobile_primary_hover_border }};
  --bundle-summary-mobile-secondary-background: {{ bundle_mobile_secondary_background }};
  --bundle-summary-mobile-secondary-text: {{ bundle_mobile_secondary_text }};
  --bundle-summary-mobile-secondary-border: {{ bundle_mobile_secondary_border }};
  --bundle-summary-mobile-secondary-hover-background: {{ bundle_mobile_secondary_hover_background }};
  --bundle-summary-mobile-secondary-hover-text: {{ bundle_mobile_secondary_hover_text }};
  --bundle-summary-mobile-secondary-hover-border: {{ bundle_mobile_secondary_hover_border }};
  --bundle-summary-mobile-tertiary-text: {{ bundle_mobile_tertiary_text }};
  --bundle-summary-mobile-tertiary-hover-text: {{ bundle_mobile_tertiary_hover_text }};
{% endcapture %}
{% assign bundle_summary_style = bundle_summary_style | strip %}
<div
  class="bundle-summary"
  style="{{ bundle_summary_style }}"
  data-bundle-summary
  data-mobile-expanded="false"
  data-goals="{{ bundle_goals | strip | escape }}"
  data-placeholder-count="{{ bundle_summary_placeholder_count }}"
  data-initial-message="{{ bundle_summary_initial_message | escape }}"
  data-unlocked-message="{{ bundle_summary_unlocked_message | escape }}"
  data-show-quantity="{{ block.settings.show_quantity_selector }}"
  {{ block.shopify_attributes }}
>
  <div class="bundle-summary__surface color-scheme section-color-scope {{ bundle_summary_desktop_scheme }}{% if bundle_summary_corner_radius == 'custom' %} bundle-summary__surface--radius-custom{% endif %}{% if block.settings.shadow != 'none' %} bundle-summary__surface--shadow-{{ block.settings.shadow }}{% endif %}">
    <div class="bundle-summary__inner">
      <div class="bundle-summary__header">
        <h3 class="bundle-summary__heading heading-text heading-lg">
          <button type="button" class="bundle-summary__toggle" data-bundle-summary-toggle aria-expanded="false" aria-controls="{{ bundle_summary_progress_id }} {{ bundle_summary_items_id }}" disabled>
            <span>{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ bundle_summary_heading_label | escape }}{% endif %}</span>
            <span class="bundle-summary__indicator" aria-hidden="true">{% render 'icon', icon: 'chevron', bare: true %}</span>
          </button>
        </h3>

        <div class="bundle-summary__progress" id="{{ bundle_summary_progress_id }}" data-bundle-progress hidden>
          <p class="bundle-summary__progress-message body-text body-{{ bundle_summary_message_font_size }}" data-bundle-progress-message aria-live="polite"></p>
          <div class="bundle-summary__progress-visual">
            <div
              class="bundle-summary__progress-track"
              role="progressbar"
              aria-label="{{ 'bundle_builder.progress' | t }}"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              data-bundle-progress-bar
            >
              <span class="bundle-summary__progress-fill-zone">
                <span class="bundle-summary__progress-fill" data-bundle-progress-fill></span>
              </span>
              <span class="bundle-summary__progress-milestones" data-bundle-progress-milestones hidden aria-hidden="true"></span>
            </div>
            <div class="bundle-summary__progress-milestone-labels" data-bundle-progress-milestone-labels hidden aria-hidden="true"></div>
          </div>
        </div>
      </div>

      <template data-bundle-progress-milestone-template>
        <span class="bundle-summary__progress-milestone">
          <span class="bundle-summary__progress-milestone-dot">
            <svg viewBox="0 0 16 16" focusable="false" aria-hidden="true">
              <path d="m3 8 3.2 3.2L13 4.5"></path>
            </svg>
          </span>
        </span>
      </template>
      <template data-bundle-progress-milestone-label-template>
        <span class="bundle-summary__progress-milestone-label body-text body-xs"></span>
      </template>

      <div class="bundle-summary__items scrollbar scrollbar--vertical scrollbar--hidden-mobile" id="{{ bundle_summary_items_id }}" data-bundle-items>
        {% for placeholder_index in (1..bundle_summary_placeholder_count) %}
          <div class="bundle-summary__placeholder-item" data-bundle-placeholder aria-hidden="true">
            <span class="bundle-summary__placeholder-media"></span>
            <span class="bundle-summary__placeholder-details">
              <span class="bundle-summary__placeholder-line"></span>
              <span class="bundle-summary__placeholder-line bundle-summary__placeholder-line--short"></span>
            </span>
          </div>
        {% endfor %}
      </div>

      <div class="bundle-summary__footer">
        <div class="bundle-summary__prices">
          <div class="bundle-summary__total" data-bundle-total>
            <span class="body-text body-md">{{ 'bundle_builder.subtotal_before_discount' | t }}</span>
            <span class="bundle-summary__total-price price price--product-card product-card__price" data-bundle-total-price>
              <span class="price__current price__current--sale price__value price__value--sale" data-bundle-discounted-total hidden>
                <span class="visually-hidden">{{ 'products.sale_price' | t }}: </span>
                <span data-bundle-discounted-total-value>{{ bundle_summary_zero_price }}</span>
              </span>
              <span class="price__current price__current--regular price__value price__value--regular" data-bundle-subtotal>{{ bundle_summary_zero_price }}</span>
              <s class="price__compare price__compare-at price__value price__value--compare-at" data-bundle-original-total hidden>
                <span class="visually-hidden">{{ 'products.compare_at_price' | t }}: </span>
                <span data-bundle-original-total-value>{{ bundle_summary_zero_price }}</span>
              </s>
            </span>
          </div>

          <div class="bundle-summary__saving body-text body-sm" data-bundle-saving hidden aria-live="polite">
            <span>{{ 'bundle_builder.saving' | t }}</span>
            <span class="price__current price__current--sale price__value price__value--sale" data-bundle-saving-amount></span>
          </div>
        </div>

        {% render 'theme-button',
          label: bundle_add_bundle_label,
          aria_label: bundle_add_bundle_label,
          variant: 'primary',
          class: 'bundle-summary__submit',
          disabled: true,
          loading_dots: true,
          attributes: 'data-bundle-submit'
        %}
      </div>
    </div>
  </div>

  <template data-bundle-item-template>
    <article class="bundle-summary__item" data-bundle-item>
      <div class="bundle-summary__item-media">
        <img class="bundle-summary__item-image" data-bundle-item-image alt="" width="100" height="100" loading="lazy">
      </div>
      <div class="bundle-summary__item-details">
        <h4 class="bundle-summary__item-title body-text body-sm" data-bundle-item-title></h4>
        <p class="bundle-summary__item-line-total body-text body-sm" data-bundle-item-total aria-label="{{ 'bundle_builder.line_total' | t }}"></p>
      </div>
      <button type="button" class="bundle-summary__remove" data-bundle-remove>
        {% render 'icon', icon: 'trash', bare: true %}
        <span class="visually-hidden">{{ 'bundle_builder.remove_item' | t }}</span>
      </button>
      <div class="bundle-summary__item-footer">
        <p class="bundle-summary__item-variant body-text body-xs" data-bundle-item-variant hidden></p>
        <div class="bundle-summary__quantity quantity-selector" data-bundle-quantity-controls>
          <button type="button" class="quantity-selector__button" data-bundle-quantity-decrease aria-label="{{ 'bundle_builder.decrease_quantity' | t }}">{% render 'icon', icon: 'minus', bare: true %}</button>
          <input type="number" min="1" step="1" value="1" inputmode="numeric" data-bundle-quantity aria-label="{{ 'bundle_builder.item_quantity' | t }}">
          <button type="button" class="quantity-selector__button" data-bundle-quantity-increase aria-label="{{ 'bundle_builder.increase_quantity' | t }}">{% render 'icon', icon: 'plus', bare: true %}</button>
        </div>
        <span class="bundle-summary__item-quantity body-text body-sm" data-bundle-static-quantity aria-label="{{ 'bundle_builder.item_quantity' | t }}" hidden></span>
      </div>
    </article>
  </template>

  <template data-bundle-placeholder-template>
    <div class="bundle-summary__placeholder-item" data-bundle-placeholder aria-hidden="true">
      <span class="bundle-summary__placeholder-media"></span>
      <span class="bundle-summary__placeholder-details">
        <span class="bundle-summary__placeholder-line"></span>
        <span class="bundle-summary__placeholder-line bundle-summary__placeholder-line--short"></span>
      </span>
    </div>
  </template>
</div>

{% stylesheet %}
  .bundle-summary {
    min-width: 0;
    color: var(--body-color);
  }

  .bundle-summary__surface {
    display: flex;
    flex-direction: column;
    border: var(--bundle-summary-border-width, 0px) solid var(--border-color);
    border-radius: var(--bundle-summary-radius, var(--radius-square));
    background: var(--background-color);
    color: var(--body-color);
    padding-block: var(--bundle-summary-padding-block, 30px 30px);
    padding-inline: var(--bundle-summary-padding-inline, 30px 30px);
  }

  .bundle-summary__surface--shadow-small {
    box-shadow: 0 4px 18px color-mix(in srgb, var(--shadow-color) 12%, transparent);
  }

  .bundle-summary__surface--shadow-medium {
    box-shadow: 0 8px 28px color-mix(in srgb, var(--shadow-color) 18%, transparent);
  }

  .bundle-summary__inner {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--bundle-summary-gap, 28px);
    min-height: 0;
  }

  .bundle-summary__header,
  .bundle-summary__footer {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--bundle-summary-gap, 28px);
  }

  .bundle-summary__header {
    gap: 14px;
  }

  .bundle-summary__heading {
    margin: 0;
  }

  .bundle-summary__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
  }

  .bundle-summary__toggle:disabled {
    opacity: 1;
  }

  .bundle-summary__indicator {
    display: none;
  }

  .bundle-summary__progress {
    display: grid;
    gap: 40px;
  }

  .bundle-summary__progress[hidden],
  .bundle-summary__total[hidden],
  .bundle-summary__item-variant[hidden],
  .bundle-summary__item-quantity[hidden] {
    display: none;
  }

  .bundle-summary__progress-message {
    margin: 0;
  }

  .bundle-summary__progress-track {
    position: relative;
    width: 100%;
    height: 0.5rem;
    overflow: visible;
    border-radius: 999px;
    background: color-mix(in srgb, var(--body-color) 12%, transparent);
  }

  .bundle-summary__progress-visual {
    --bundle-progress-label-width: 80px;
    --bundle-progress-edge-inset: 0px;
    display: grid;
    gap: 10px;
  }

  .bundle-summary__progress[data-tiered='true'] .bundle-summary__progress-visual {
    --bundle-progress-edge-inset: 40px;
  }

  .bundle-summary__progress-fill-zone {
    position: absolute;
    inset: 0 var(--bundle-progress-edge-inset) 0 0;
    border-radius: inherit;
  }

  .bundle-summary__progress[data-complete='true'] .bundle-summary__progress-fill-zone {
    right: 0;
  }

  .bundle-summary__progress-fill {
    display: block;
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--bundle-summary-progress-color, #32A84C);
    transition: width 180ms ease;
  }

  .bundle-summary__progress-milestones {
    position: absolute;
    inset: 0 var(--bundle-progress-edge-inset) 0 0;
    z-index: 1;
  }

  .bundle-summary__progress-milestones[hidden],
  .bundle-summary__progress-milestone-labels[hidden] {
    display: none;
  }

  .bundle-summary__progress-milestone {
    position: absolute;
    top: 50%;
    left: var(--bundle-progress-position, 0%);
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
    border: 2px solid color-mix(in srgb, var(--body-color) 32%, var(--background-color));
    border-radius: 50%;
    background: var(--background-color);
    transform: translate(-50%, -50%);
  }

  .bundle-summary__progress-milestone[data-complete='true'] {
    border-color: var(--bundle-summary-progress-color, #32A84C);
    background: var(--bundle-summary-progress-color, #32A84C);
  }

