{% liquid
  assign faq_accordion_style = block.settings.style | default: 'simple'
  unless faq_accordion_style == 'simple' or faq_accordion_style == 'boxed'
    assign faq_accordion_style = 'simple'
  endunless
  assign faq_accordion_icon = block.settings.icon | default: 'chevron'
  unless faq_accordion_icon == 'chevron' or faq_accordion_icon == 'plus'
    assign faq_accordion_icon = 'chevron'
  endunless
  assign faq_accordion_width = block.settings.width | default: 'fill'
  assign faq_accordion_width_css = '100%'
  if faq_accordion_width == 'custom'
    assign faq_accordion_width_css = block.settings.custom_width | default: 100 | append: '%'
  endif
  assign faq_accordion_max_width_css = blank
  if block.settings.limit_width
    assign faq_accordion_max_width_css = block.settings.max_width | default: 850 | append: 'px'
  endif
  assign faq_question_font = block.settings.question_font | default: 'heading'
  unless faq_question_font == 'heading' or faq_question_font == 'body' or faq_question_font == 'accent'
    assign faq_question_font = 'heading'
  endunless
  assign faq_accordion_color_type = block.settings.color_type
  if faq_accordion_color_type == blank and faq_accordion_style == 'boxed'
    assign faq_accordion_color_type = 'color_scheme'
  endif

  assign faq_accordion_width_mobile_css = blank
  assign faq_accordion_max_width_mobile_css = blank
  assign faq_accordion_mobile_size_enabled = false
  if block.settings.device != blank or block.settings.customize_mobile_size
    assign faq_accordion_mobile_size_enabled = true
    assign faq_accordion_width_mobile_css = '100%'
    if block.settings.width_mobile == 'custom'
      assign faq_accordion_width_mobile_css = block.settings.custom_width_mobile | default: 100 | append: '%'
    endif
    assign faq_accordion_max_width_mobile_css = '100%'
    if block.settings.limit_width_mobile
      assign faq_accordion_max_width_mobile_css = block.settings.max_width_mobile | default: 1100 | append: 'px'
    endif
  endif

  assign faq_question_font_size = block.settings.question_font_size | default: 'sm'
  assign faq_question_font_size_mobile = block.settings.question_font_size_mobile | default: faq_question_font_size
  assign faq_accordion_scheme = block.settings.color_scheme | default: 'scheme-2'
  if block.settings.color_scheme.id != blank
    assign faq_accordion_scheme = block.settings.color_scheme.id
  endif
  assign faq_accordion_scheme = faq_accordion_scheme | handleize

  unless faq_question_font_size == 'display' or faq_question_font_size == 'xl' or faq_question_font_size == 'lg' or faq_question_font_size == 'md' or faq_question_font_size == 'sm' or faq_question_font_size == 'xs'
    assign faq_question_font_size = 'xs'
  endunless
  unless faq_question_font_size_mobile == 'display' or faq_question_font_size_mobile == 'xl' or faq_question_font_size_mobile == 'lg' or faq_question_font_size_mobile == 'md' or faq_question_font_size_mobile == 'sm' or faq_question_font_size_mobile == 'xs'
    assign faq_question_font_size_mobile = faq_question_font_size
  endunless

  assign faq_item_padding_top = 16
  assign faq_item_padding_right = 20
  assign faq_item_padding_bottom = 16
  assign faq_item_padding_left = 20
  assign faq_item_padding = block.settings.padding | default: 'large'
  case faq_item_padding
    when 'large'
      assign faq_item_padding_top = 20
      assign faq_item_padding_right = 24
      assign faq_item_padding_bottom = 20
      assign faq_item_padding_left = 24
    when 'small'
      assign faq_item_padding_top = 12
      assign faq_item_padding_right = 20
      assign faq_item_padding_bottom = 12
      assign faq_item_padding_left = 20
    when 'custom'
      assign faq_item_padding_top = block.settings.padding_top | default: 16 | plus: 0
      assign faq_item_padding_right = block.settings.padding_right | default: 20 | plus: 0
      assign faq_item_padding_bottom = block.settings.padding_bottom | default: 16 | plus: 0
      assign faq_item_padding_left = block.settings.padding_left | default: 20 | plus: 0
  endcase

  if faq_item_padding_top < 0 or faq_item_padding_top > 100
    assign faq_item_padding_top = 16
  endif
  if faq_item_padding_right < 0 or faq_item_padding_right > 100
    assign faq_item_padding_right = 20
  endif
  if faq_item_padding_bottom < 0 or faq_item_padding_bottom > 100
    assign faq_item_padding_bottom = 16
  endif
  if faq_item_padding_left < 0 or faq_item_padding_left > 100
    assign faq_item_padding_left = 20
  endif

%}

{% capture faq_accordion_style_attribute %}
  {% render 'size-style',
    width: faq_accordion_width_css,
    max_width: faq_accordion_max_width_css,
    width_mobile: faq_accordion_width_mobile_css,
    max_width_mobile: faq_accordion_max_width_mobile_css
  %}
  --faq-item-gap: {{ block.settings.gap_desktop | default: 16 }}px;
  --faq-item-gap-mobile: {{ block.settings.gap_mobile | default: 12 }}px;
  --faq-item-border-width: {{ block.settings.border_thickness | default: 0 }}px;
  --faq-item-padding-top: {{ faq_item_padding_top }}px;
  --faq-item-padding-right: {{ faq_item_padding_right }}px;
  --faq-item-padding-bottom: {{ faq_item_padding_bottom }}px;
  --faq-item-padding-left: {{ faq_item_padding_left }}px;
  {% if faq_item_padding == 'large' %}
    --faq-item-padding-right-mobile: 20px;
    --faq-item-padding-left-mobile: 20px;
  {% endif %}
  --faq-item-shadow: {% case block.settings.shadow %}{% when 'extra-small' %}0 2px 4px color-mix(in srgb, var(--shadow-color) 8%, transparent){% when 'small' %}0 4px 12px color-mix(in srgb, var(--shadow-color) 12%, transparent){% when 'medium' %}0 8px 20px color-mix(in srgb, var(--shadow-color) 18%, transparent){% when 'large' %}0 16px 32px color-mix(in srgb, var(--shadow-color) 24%, transparent){% else %}none{% endcase %};
  --faq-item-question-family: var(--font-{{ faq_question_font }}-family);
  --faq-item-question-weight: var(--font-{{ faq_question_font }}-weight);
  --faq-item-question-style: var(--font-{{ faq_question_font }}-style);
  {% if faq_question_font == 'heading' %}
    --faq-item-question-size: var(--font-heading-{{ faq_question_font_size }});
    --faq-item-question-line-height: var(--font-heading-{{ faq_question_font_size }}-line-height);
    --faq-item-question-letter-spacing: var(--font-heading-{{ faq_question_font_size }}-letter-spacing);
    --faq-item-question-text-transform: var(--font-heading-{{ faq_question_font_size }}-text-transform);
  {% else %}
    --faq-item-question-size: var(--font-body-{{ block.settings.question_body_font_size | default: 'md' }});
    --faq-item-question-line-height: var(--font-body-line-height);
    --faq-item-question-letter-spacing: var(--font-body-letter-spacing);
    --faq-item-question-text-transform: none;
  {% endif %}

  {% if block.settings.customize_mobile_font_size %}
    {% if faq_question_font == 'heading' %}
      --faq-item-question-size-mobile: var(--font-heading-{{ faq_question_font_size_mobile }});
      --faq-item-question-line-height-mobile: var(--font-heading-{{ faq_question_font_size_mobile }}-line-height);
      --faq-item-question-letter-spacing-mobile: var(--font-heading-{{ faq_question_font_size_mobile }}-letter-spacing);
      --faq-item-question-text-transform-mobile: var(--font-heading-{{ faq_question_font_size_mobile }}-text-transform);
    {% else %}
      --faq-item-question-size-mobile: var(--font-body-{{ block.settings.question_body_font_size_mobile | default: 'md' }});
    {% endif %}

  {% endif %}
{% endcapture %}

<div class="faq-accordion size-style faq-accordion--width-{{ faq_accordion_width }} faq-accordion--style-{{ faq_accordion_style }} faq-accordion--icon-{{ faq_accordion_icon }}{% if block.settings.dividers %} faq-accordion--dividers{% endif %}{% if faq_accordion_mobile_size_enabled %} faq-accordion--mobile-size{% endif %}{% if block.settings.padding == 'custom' %} faq-accordion--custom-padding{% endif %}{% if faq_accordion_style == 'boxed' and faq_accordion_color_type == 'color_scheme' %} color-scheme {{ faq_accordion_scheme }}{% endif %}" style="{{ faq_accordion_style_attribute | strip }}" {{ block.shopify_attributes }}>
  <div class="faq-accordion__items">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}

  .faq-accordion {
    min-width: 0;
    background: transparent;
    --size-style-width-mobile: var(--size-style-width, 100%);
    --size-style-max-width-mobile: var(--size-style-max-width, 100%);
    --faq-item-question-size-mobile: var(--faq-item-question-size);
    --faq-item-question-line-height-mobile: var(--faq-item-question-line-height);
    --faq-item-question-letter-spacing-mobile: var(--faq-item-question-letter-spacing);
    --faq-item-question-text-transform-mobile: var(--faq-item-question-text-transform);

    --faq-item-padding-right-mobile: var(--faq-item-padding-right);
    --faq-item-padding-left-mobile: var(--faq-item-padding-left);
  }
  .faq-accordion__items { display: grid; gap: var(--faq-item-gap, 16px); min-width: 0; }
  .faq-accordion--style-simple.faq-accordion--dividers > .faq-accordion__items { gap: 0; }
  .faq-accordion--style-simple > .faq-accordion__items > .faq-item { border: 0; }
  .faq-accordion--style-simple.faq-accordion--dividers > .faq-accordion__items > .faq-item { border-bottom: 1px solid var(--faq-divider-color, var(--border-color)); }
  .faq-accordion--style-simple > .faq-accordion__items > .faq-item > .faq-item__summary { padding: min(calc(var(--faq-item-gap, 16px) / 2), 8px) 0; }
  .faq-accordion--style-simple.faq-accordion--dividers > .faq-accordion__items > .faq-item > .faq-item__summary { padding-block: var(--faq-item-gap, 16px); }
  .faq-accordion--style-simple > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner { padding: 0 0 var(--faq-item-gap, 16px); }
  .faq-accordion--style-boxed > .faq-accordion__items > .faq-item { border: var(--faq-item-border-width, 1px) solid var(--border-color); border-radius: var(--card-radius); background: var(--background-color); box-shadow: var(--faq-item-shadow, none); }
  .faq-accordion--style-boxed > .faq-accordion__items > .faq-item > .faq-item__summary,
  .faq-accordion--style-boxed.faq-accordion--custom-padding > .faq-accordion__items > .faq-item > .faq-item__summary { padding: var(--faq-item-padding-top, 16px) var(--faq-item-padding-right, 20px) var(--faq-item-padding-bottom, 16px) var(--faq-item-padding-left, 20px); }
  .faq-accordion--style-boxed > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner,
  .faq-accordion--style-boxed.faq-accordion--custom-padding > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner { padding: 0 var(--faq-item-padding-right, 20px) var(--faq-item-padding-bottom, 16px) var(--faq-item-padding-left, 20px); }
  .faq-accordion > .faq-accordion__items > .faq-item > .faq-item__summary .faq-item__question {
    font-family: var(--faq-item-question-family, var(--font-heading-family));
    font-style: var(--faq-item-question-style, var(--font-heading-style));
    font-weight: var(--faq-item-question-weight, var(--font-heading-weight));
    font-size: var(--faq-item-question-size, inherit);
    line-height: var(--faq-item-question-line-height, inherit);
    letter-spacing: var(--faq-item-question-letter-spacing, normal);
    text-transform: var(--faq-item-question-text-transform, none);
  }
  .faq-accordion--icon-plus > .faq-accordion__items > .faq-item > .faq-item__summary .faq-item__chevron,
  .faq-accordion--icon-chevron > .faq-accordion__items > .faq-item > .faq-item__summary .faq-item__plus { display: none; }
  .faq-accordion--icon-plus > .faq-accordion__items > .faq-item[open] > .faq-item__summary .faq-item__plus { transform: none; }
  .faq-item__plus-vertical { transform-origin: center; transition: transform var(--motion-duration-standard) var(--motion-ease-standard); }
  .faq-accordion--icon-plus > .faq-accordion__items > .faq-item[open] > .faq-item__summary .faq-item__plus-vertical { transform: scaleY(0); }
  @media (max-width: 767.98px) {
    .faq-accordion__items { gap: var(--faq-item-gap-mobile, var(--faq-item-gap, 16px)); }
    .faq-accordion--style-simple > .faq-accordion__items > .faq-item > .faq-item__summary { padding-block: min(calc(var(--faq-item-gap-mobile, var(--faq-item-gap, 16px)) / 2), 8px); }
    .faq-accordion--style-simple.faq-accordion--dividers > .faq-accordion__items > .faq-item > .faq-item__summary { padding-block: var(--faq-item-gap-mobile, var(--faq-item-gap, 16px)); }
    .faq-accordion--style-simple > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner { padding-bottom: var(--faq-item-gap-mobile, var(--faq-item-gap, 16px)); }
    .faq-accordion--style-boxed > .faq-accordion__items > .faq-item > .faq-item__summary,
    .faq-accordion--style-boxed.faq-accordion--custom-padding > .faq-accordion__items > .faq-item > .faq-item__summary,
    .faq-accordion--style-boxed > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner,
    .faq-accordion--style-boxed.faq-accordion--custom-padding > .faq-accordion__items > .faq-item > .faq-item__content > .faq-item__content-inner { padding-right: var(--faq-item-padding-right-mobile, var(--faq-item-padding-right, 20px)); padding-left: var(--faq-item-padding-left-mobile, var(--faq-item-padding-left, 20px)); }
    .faq-accordion > .faq-accordion__items > .faq-item > .faq-item__summary .faq-item__question {
      font-size: var(--faq-item-question-size-mobile, var(--faq-item-question-size, inherit));
      line-height: var(--faq-item-question-line-height-mobile, var(--faq-item-question-line-height, inherit));
      letter-spacing: var(--faq-item-question-letter-spacing-mobile, var(--faq-item-question-letter-spacing, normal));
      text-transform: var(--faq-item-question-text-transform-mobile, var(--faq-item-question-text-transform, none));
    }
    .faq-section__content > .faq-accordion--mobile-size { flex-basis: auto; width: var(--size-style-width-mobile, var(--size-style-width, 100%)); }
  }
  @media (prefers-reduced-motion: reduce) { .faq-item__plus-vertical { transition: none; } }
{% endstylesheet %}

{% schema %}
