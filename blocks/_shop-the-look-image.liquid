{% doc %}
  Renders the private Shop the look image with an optional link.

  The block owns its image source, responsive ratio, solid or gradient overlay and radius,
  while the shared image snippet owns semantic media markup and image loading.

  @example
  {% content_for 'block', type: '_shop-the-look-image', id: 'image' %}
{% enddoc %}
{% capture effective_overlay %}
  {% if block.settings.show_overlay %}
    {% render 'overlay-background', overlay_settings: block.settings %}
  {% endif %}
{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}

{% liquid
  assign image_source = block.settings.image
  assign mobile_image_source = block.settings.mobile_image

  assign image_ratio_desktop_setting = block.settings.image_ratio_desktop | default: 'auto'
  capture image_ratio_desktop
    render 'image-ratio-value', setting: image_ratio_desktop_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_desktop, custom_height: block.settings.image_ratio_custom_height_desktop
  endcapture
  assign image_ratio_desktop = image_ratio_desktop | strip
  assign image_height_desktop = 'auto'
  assign image_fill_desktop = false
  if image_ratio_desktop_setting == 'auto' and block.settings.height_desktop == 'fill'
    assign image_height_desktop = '100%'
    assign image_fill_desktop = true
  endif
  if image_ratio_desktop_setting == 'square' or image_ratio_desktop_setting == 'portrait' or image_ratio_desktop_setting == 'landscape' or image_ratio_desktop_setting == 'wide' or image_ratio_desktop_setting == 'custom'
    assign image_height_desktop = '100%'
  endif

  assign image_ratio_mobile_setting = block.settings.image_ratio_mobile | default: 'auto'
  capture image_ratio_mobile
    render 'image-ratio-value', setting: image_ratio_mobile_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_mobile, custom_height: block.settings.image_ratio_custom_height_mobile
  endcapture
  assign image_ratio_mobile = image_ratio_mobile | strip
  assign image_height_mobile = 'auto'
  assign image_fill_mobile = false
  if image_ratio_mobile_setting == 'auto' and block.settings.height_mobile == 'fill'
    assign image_height_mobile = '100%'
    assign image_fill_mobile = true
  endif
  if image_ratio_mobile_setting == 'square' or image_ratio_mobile_setting == 'portrait' or image_ratio_mobile_setting == 'landscape' or image_ratio_mobile_setting == 'wide' or image_ratio_mobile_setting == 'custom'
    assign image_height_mobile = '100%'
  endif

  assign image_corner_radius = block.settings.corner_radius | default: 'square'
  assign image_custom_corner_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  unless image_corner_radius == 'inherit' or image_corner_radius == 'square' or image_corner_radius == 'rounded' or image_corner_radius == 'full' or image_corner_radius == 'custom'
    assign image_legacy_corner_radius = image_corner_radius | plus: 0
    if image_legacy_corner_radius > 0
      assign image_corner_radius = 'custom'
      assign image_custom_corner_radius = image_legacy_corner_radius
      if image_custom_corner_radius > 40
        assign image_custom_corner_radius = 40
      endif
    else
      assign image_corner_radius = 'square'
    endif
  endunless

  if image_custom_corner_radius < 0 or image_custom_corner_radius > 40
    assign image_custom_corner_radius = 0
  endif

  assign image_radius_value = 'var(--media-radius, var(--radius-square))'
  case image_corner_radius
    when 'square'
      assign image_radius_value = 'var(--radius-square)'
    when 'rounded'
      assign image_radius_value = 'var(--radius-rounded)'
    when 'full'
      assign image_radius_value = 'var(--radius-pill)'
    when 'custom'
      assign image_radius_value = image_custom_corner_radius | append: 'px'
  endcase

  assign image_class = 'shop-the-look-image image-block image-block--ratio-desktop-' | append: image_ratio_desktop_setting
  if image_fill_desktop
    assign image_class = image_class | append: ' image-block--height-fill'
  endif
  if image_fill_mobile
    assign image_class = image_class | append: ' image-block--height-fill-mobile'
  endif
  if block.settings.show_image_first_mobile
    assign image_class = image_class | append: ' image-block--first-mobile'
  endif
%}

{% capture image_style %}
  --image-block-ratio: {{ image_ratio_desktop }};
  --image-block-image-height: {{ image_height_desktop }};
  --image-block-ratio-mobile: {{ image_ratio_mobile }};
  --image-block-image-height-mobile: {{ image_height_mobile }};
  --image-block-overlay: {{ effective_overlay | default: 'transparent' | escape }};
  --image-block-radius: {{ image_radius_value }};
{% endcapture %}
{% assign image_style = image_style | strip | replace: '\n', ' ' %}

<div
  class="{{ image_class }}"
  style="{{ image_style }}"
  {{ block.shopify_attributes }}
>
  {% capture image_sizes %}(min-width: 768px) 50vw, 100vw{% endcapture %}
  {% render 'image',
    image: image_source,
    mobile_image: mobile_image_source,
    url: block.settings.image_link,
    open_in_new_tab: block.settings.open_in_new_tab,
    alt: block.settings.alt_text,
    class: 'image-block__media',
    width: 2400,
    widths: '400, 600, 800, 1200, 1600, 2400',
    sizes: image_sizes
  %}
</div>

{% stylesheet %}
  .shop-the-look-image {
    width: 100%;
    display: block;
    min-width: 0;
  }

  .shop-the-look-image > .image-block__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: var(--image-block-overlay, transparent);
    pointer-events: none;
  }

  .shop-the-look-image > .image-block__media {
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--image-block-ratio, auto);
    border-radius: var(--image-block-radius, 0px);
  }

  .shop-the-look-image .image-block__media > picture,
  .shop-the-look-image .image-block__media > picture > img,
  .shop-the-look-image .image-block__media > img,
  .shop-the-look-image .image-block__media .image__placeholder {
    display: block;
    width: 100%;
    height: var(--image-block-image-height, auto);
  }

  .shop-the-look-image .image-block__media > img,
  .shop-the-look-image .image-block__media > picture > img {
    object-fit: cover;
  }

  @media (max-width: 767.98px) {
    .shop-the-look-image.image-block--first-mobile {
      order: -1;
    }


    .shop-the-look-image > .image-block__media {
      aspect-ratio: var(--image-block-ratio-mobile, var(--image-block-ratio, auto));
    }

    .shop-the-look-image .image-block__media > picture,
    .shop-the-look-image .image-block__media > picture > img,
    .shop-the-look-image .image-block__media > img,
    .shop-the-look-image .image-block__media .image__placeholder {
      height: var(--image-block-image-height-mobile, var(--image-block-image-height, auto));
    }
  }
  /* Fill removes image intrinsic height from the row's sizing: sibling content
     or a definite parent height owns the frame. Auto remains intrinsic. */
  @media (min-width: 768px) {
    .shop-the-look-image.image-block--height-fill { display: flex; height: 100%; min-height: 0; align-self: stretch; }
    .shop-the-look-image.image-block--height-fill > .image-block__media { flex: 1 1 auto; height: auto; min-height: 0; }
    .shop-the-look-image.image-block--height-fill .image-block__media > :is(img, picture, .image__placeholder) { position: absolute; inset: 0; height: 100%; }
  }
  @media (max-width: 767.98px) {
    .shop-the-look-image.image-block--height-fill-mobile { display: flex; height: 100%; min-height: 0; align-self: stretch; }
    .shop-the-look-image.image-block--height-fill-mobile > .image-block__media { flex: 1 1 auto; height: auto; min-height: 0; }
    .shop-the-look-image.image-block--height-fill-mobile .image-block__media > :is(img, picture, .image__placeholder) { position: absolute; inset: 0; height: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "checkbox",
      "id": "show_image_first_mobile",
      "label": "t:labels.show_image_first_mobile",
      "default": false
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:labels.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "t:labels.image_ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:labels.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.image_ratio_desktop == 'auto' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_desktop",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_desktop",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "t:labels.image_ratio_mobile",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:labels.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.image_ratio_mobile == 'auto' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_mobile",
      "label": "W (mobile)",
      "default": 16,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_mobile",
      "label": "H (mobile)",
      "default": 9,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:general.border"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.radius_preset.inherit"
        },
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "full",
          "label": "t:options.radius_preset.full"
        },
        {
          "value": "custom",
          "label": "t:options.radius_preset.custom"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:labels.custom_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:general.overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "alpha": true,
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    }
  ]
}
{% endschema %}
