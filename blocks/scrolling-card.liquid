      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "backdrop_blur",
      "label": "Backdrop blur",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Card",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "alignment": "left",
            "width": "fill",
            "height": "fill",
            "gap_desktop": 16,
            "gap_mobile": 12,
            "appearance_type": "inherit",
            "border_type": "none",
            "corner_radius": "square",
            "shadow": "none",
            "show_overlay": false
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>Subheading</p>",
                "show_background": true,
                "corner_radius": "pill"
              }
            },
            {
              "type": "spacer",
              "settings": {
                "unit_desktop": "pixel",
                "size_desktop_px": 80,
                "show_on_mobile": true,
                "unit_mobile": "pixel",
                "size_mobile_px": 40
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>Heading</p>",
                "heading_size": "display",
                "html_tag": "h3",
                "width": "fit"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Use this text to share information about your brand, describe products, or highlight announcements. You can also promote special offers or communicate important messages to customers.</p>",
                "text_size": "sm",
                "width": "custom",
                "max_width": 500
