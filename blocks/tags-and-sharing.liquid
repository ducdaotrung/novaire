{% doc %}
  Renders article tags and social sharing links.
{% enddoc %}

<div class="article-tags-sharing" style="--article-tags-padding-top: {{ block.settings.padding_top }}px; --article-tags-padding-bottom: {{ block.settings.padding_bottom }}px; {% if block.settings.custom_mobile_padding %}--article-tags-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;{% endif %} {% if block.settings.custom_mobile_padding %}--article-tags-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;{% endif %}" {{ block.shopify_attributes }}>
  {% if block.settings.show_share_buttons %}
    {% assign article_share_url = canonical_url | url_encode %}
    <div class="article-tags-sharing__share">
      <p class="article-tags-sharing__label">{{ 'blog.share_label' | t }}</p>
      <div class="article-tags-sharing__buttons">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ article_share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_on' | t: network: 'Facebook' }}">{% render 'social-icon', icon: 'facebook' %}</a>
        <a href="https://twitter.com/intent/tweet?url={{ article_share_url }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_on' | t: network: 'X' }}">{% render 'social-icon', icon: 'x' %}</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ article_share_url }}&description={{ article.title | url_encode }}{% if article.image %}&media={{ article.image | image_url: width: 1600 | prepend: 'https:' | url_encode }}{% endif %}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_on' | t: network: 'Pinterest' }}">{% render 'social-icon', icon: 'pinterest' %}</a>
      </div>
    </div>
  {% endif %}
  {% if block.settings.show_tags and article.tags != blank %}
    <div class="article-tags-sharing__tag-group"><span>{{ 'blog.tags_label' | t }}</span><ul class="article-tags-sharing__tags" role="list">
      {% for tag in article.tags %}<li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>{% endfor %}
    </ul></div>
  {% endif %}
</div>

{% stylesheet %}
  .article-tags-sharing { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; width: 100%; min-height: 61px; margin-inline: auto; padding-top: var(--article-tags-padding-top, 0px); padding-bottom: var(--article-tags-padding-bottom, 0px); box-sizing: border-box; }
  .article-tags-sharing__tag-group { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; order: -1; }
  .article-tags-sharing__share { display: flex; flex-direction: row; align-items: center; gap: 16px; }
  .article-tags-sharing__label { margin: 0; }
  .article-tags-sharing__tags, .article-tags-sharing__buttons { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .article-tags-sharing__buttons a { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; color: inherit; text-decoration: none; }
  .article-tags-sharing__buttons svg { display: block; width: 24px; height: 24px; }
  .article-tags-sharing__tags a { display: inline-flex; align-items: center; justify-content: center; min-width: 68px; min-height: 40px; padding: 10px 16px; color: inherit; background: var(--color-surface); border-radius: var(--tag-radius); box-sizing: border-box; text-decoration: none; }
  @media (max-width: 767.98px) { .article-tags-sharing { width: 100%; min-height: 61px; padding-top: var(--article-tags-padding-top-mobile, var(--article-tags-padding-top, 0px)); padding-bottom: var(--article-tags-padding-bottom-mobile, var(--article-tags-padding-bottom, 0px)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Tags and sharing",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.custom_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Tags and sharing",
      "category": "Blog"
    }
  ]
}
{% endschema %}
