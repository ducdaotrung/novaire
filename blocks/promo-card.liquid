    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Mobile left and right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Promo card", "category": "t:general.product"
    }
  ]
