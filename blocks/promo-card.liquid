      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Button spacing",
      "min": 0,
      "max": 100,
      "step": 1,
