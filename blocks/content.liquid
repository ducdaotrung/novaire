{% doc %}
  Renders the full content of the current blog post.
{% enddoc %}

<div class="article-content article-content--{{ block.settings.width | default: 'default' }} rte" {{ block.shopify_attributes }}>
  {{ article.content }}
</div>

{% stylesheet %}
  .article-content { width: 100%; max-width: 100%; margin-inline: auto; overflow-wrap: anywhere; }
  .article-content :where(table, pre) { max-width: 100%; overflow-x: auto; }
  .article-content table { display: block; }
  .article-content--page { width: 100%; }
  .article-content--full { width: calc(100% - 48px); max-width: none; margin-inline: auto; }
  .article-content img, .article-content video, .article-content iframe { display: block; max-width: 100%; height: auto; }
  @media (max-width: 767.98px) {
    .article-content--full { width: calc(100% - 32px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Content",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "This content comes from your blog post."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Content",
      "category": "Blog"
    }
  ]
}
{% endschema %}
