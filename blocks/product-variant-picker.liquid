{% doc %}
  Renders variant options using the global Variant picker and Swatches settings.
  The picker emits variant changes to every buy-button block in this section.
{% enddoc %}

{% liquid
  assign picker_product = closest.product | default: product
  assign current_variant = picker_product.selected_or_first_available_variant
  assign media_gallery_id = 'ProductMedia-' | append: section.id

  assign picker_font = block.settings.font | default: 'body'
  unless picker_font == 'body' or picker_font == 'heading' or picker_font == 'accent'
    assign picker_font = 'body'
  endunless
  assign picker_font_size = block.settings.font_size | default: 'sm'
  assign picker_font_sizes = 'xs,sm,md,lg,xl,xxl' | split: ','
  unless picker_font_sizes contains picker_font_size
    assign picker_font_size = 'sm'
  endunless
  assign picker_tracking = block.settings.letter_spacing | default: 'normal'
  assign picker_tracking_value = '0'
  case picker_tracking
    when 'tighter'
      assign picker_tracking_value = '-0.04em'
    when 'tight'
      assign picker_tracking_value = '-0.02em'
    when 'relaxed'
      assign picker_tracking_value = '0.02em'
    when 'loose'
      assign picker_tracking_value = '0.04em'
    when 'extra_loose'
      assign picker_tracking_value = '0.08em'
    when 'ultra_loose'
      assign picker_tracking_value = '0.12em'
    when 'mega_loose'
      assign picker_tracking_value = '0.16em'
  endcase

  assign picker_input_font = block.settings.input_font | default: 'body'
  unless picker_input_font == 'body' or picker_input_font == 'heading' or picker_input_font == 'accent'
    assign picker_input_font = 'body'
  endunless
  assign picker_input_font_size = block.settings.input_font_size | default: 'md'
  assign picker_input_font_sizes = 'xs,sm,md,lg,xl,xxl' | split: ','
  unless picker_input_font_sizes contains picker_input_font_size
    assign picker_input_font_size = 'md'
  endunless
  assign picker_input_tracking = block.settings.input_letter_spacing | default: 'normal'
  assign picker_input_tracking_value = '0'
  case picker_input_tracking
    when 'tighter'
      assign picker_input_tracking_value = '-0.04em'
    when 'tight'
      assign picker_input_tracking_value = '-0.02em'
    when 'relaxed'
      assign picker_input_tracking_value = '0.02em'
    when 'loose'
      assign picker_input_tracking_value = '0.04em'
    when 'extra_loose'
      assign picker_input_tracking_value = '0.08em'
    when 'ultra_loose'
      assign picker_input_tracking_value = '0.12em'
    when 'mega_loose'
      assign picker_input_tracking_value = '0.16em'
  endcase

  assign show_option_names = true
  if block.settings.show_option_names == false
    assign show_option_names = false
  endif

  assign size_chart_option_name = block.settings.size_chart_option_name | default: 'Size' | strip
  assign size_chart_desktop_layout = block.settings.size_chart_desktop_layout | default: 'modal'
  unless size_chart_desktop_layout == 'modal' or size_chart_desktop_layout == 'drawer'
    assign size_chart_desktop_layout = 'modal'
  endunless
  assign size_chart_mobile_layout = block.settings.size_chart_mobile_layout | default: 'bottom_sheet'
  unless size_chart_mobile_layout == 'bottom_sheet' or size_chart_mobile_layout == 'drawer'
    assign size_chart_mobile_layout = 'bottom_sheet'
  endunless
  assign size_chart_width = block.settings.size_chart_width | default: 600 | plus: 0
  if size_chart_width < 320 or size_chart_width > 960
    assign size_chart_width = 600
  endif

  assign picker_padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign picker_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign picker_padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign picker_padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign picker_padding_top_mobile = block.settings.padding_top_mobile | default: picker_padding_top | plus: 0
  assign picker_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: picker_padding_bottom | plus: 0
  assign picker_padding_left_mobile = block.settings.padding_left_mobile | default: picker_padding_left | plus: 0
  assign picker_padding_right_mobile = block.settings.padding_right_mobile | default: picker_padding_right | plus: 0
  if picker_padding_top < 0 or picker_padding_top > 100
    assign picker_padding_top = 0
  endif
  if picker_padding_bottom < 0 or picker_padding_bottom > 100
    assign picker_padding_bottom = 0
  endif
  if picker_padding_left < 0 or picker_padding_left > 100
    assign picker_padding_left = 0
  endif
  if picker_padding_right < 0 or picker_padding_right > 100
    assign picker_padding_right = 0
  endif
  if picker_padding_top_mobile < 0 or picker_padding_top_mobile > 100
    assign picker_padding_top_mobile = picker_padding_top
  endif
  if picker_padding_bottom_mobile < 0 or picker_padding_bottom_mobile > 100
    assign picker_padding_bottom_mobile = picker_padding_bottom
  endif
  if picker_padding_left_mobile < 0 or picker_padding_left_mobile > 100
    assign picker_padding_left_mobile = picker_padding_left
  endif
  if picker_padding_right_mobile < 0 or picker_padding_right_mobile > 100
    assign picker_padding_right_mobile = picker_padding_right
  endif
%}

{% capture picker_style %}
  {% if picker_font != 'body' %}
    --variant-label-font-family: var(--font-{{ picker_font }}-family);
    --variant-label-font-style: var(--font-{{ picker_font }}-style);
    --variant-label-font-weight: var(--font-{{ picker_font }}-weight);
  {% endif %}
  {% if picker_font_size != 'sm' %}--variant-label-font-size: var(--font-body-{{ picker_font_size }});{% endif %}
  {% if picker_tracking_value != '0' %}--variant-label-letter-spacing: {{ picker_tracking_value }};{% endif %}
  {% if picker_input_font != 'body' %}
    --variant-input-font-family: var(--font-{{ picker_input_font }}-family);
    --variant-input-font-style: var(--font-{{ picker_input_font }}-style);
    --variant-input-font-weight: var(--font-{{ picker_input_font }}-weight);
  {% endif %}
  {% if picker_input_font_size != 'md' %}--variant-input-font-size: var(--font-body-{{ picker_input_font_size }});{% endif %}
  {% if picker_input_tracking_value != '0' %}--variant-input-letter-spacing: {{ picker_input_tracking_value }};{% endif %}

  {% if picker_padding_top != 0 %}--product-variant-picker-padding-top: {{ picker_padding_top }}px;{% endif %}
  {% if picker_padding_bottom != 0 %}--product-variant-picker-padding-bottom: {{ picker_padding_bottom }}px;{% endif %}
  {% if picker_padding_left != 0 %}--product-variant-picker-padding-left: {{ picker_padding_left }}px;{% endif %}
  {% if picker_padding_right != 0 %}--product-variant-picker-padding-right: {{ picker_padding_right }}px;{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if picker_padding_top_mobile != picker_padding_top %}--product-variant-picker-padding-top-mobile: {{ picker_padding_top_mobile }}px;{% endif %}
    {% if picker_padding_bottom_mobile != picker_padding_bottom %}--product-variant-picker-padding-bottom-mobile: {{ picker_padding_bottom_mobile }}px;{% endif %}
    {% if picker_padding_left_mobile != picker_padding_left %}--product-variant-picker-padding-left-mobile: {{ picker_padding_left_mobile }}px;{% endif %}
    {% if picker_padding_right_mobile != picker_padding_right %}--product-variant-picker-padding-right-mobile: {{ picker_padding_right_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign picker_style = picker_style | strip %}

{% if picker_product != blank and picker_product.has_only_default_variant == false %}
  <div class="product-variant-picker" data-product-variant-picker-block{% if picker_style != blank %} style="{{ picker_style }}"{% endif %} {{ block.shopify_attributes }}>
    {% render 'variant-picker',
      product: picker_product,
      current_variant: current_variant,
      section_id: section.id,
      media_gallery_id: media_gallery_id,
      block_id: block.id,
      show_option_names: show_option_names,
      size_chart_option_name: size_chart_option_name,
      size_chart_page: block.settings.size_chart_page,
      size_chart_desktop_layout: size_chart_desktop_layout,
      size_chart_mobile_layout: size_chart_mobile_layout,
      size_chart_width: size_chart_width
    %}
  </div>
{% endif %}

