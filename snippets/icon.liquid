{% doc %}
  Renders a registered icon or an isolated custom SVG image, optionally as a link.

  The caller owns the accessible name. A link is only rendered when a label is
  provided; decorative output is hidden from assistive technology.

  @param {string} [icon] - Registered Heroicons key or a supported legacy alias
  @param {string} [source] - Icon source: library or custom
  @param {string} [custom_icon] - Custom SVG markup from the Theme Editor
  @param {boolean} [bare] - Render only the SVG, without the shared wrapper
  @param {string} [url] - Optional link destination
  @param {string} [label] - Accessible name for a linked icon
  @param {boolean} [open_in_new_tab] - Whether the link opens in a new tab
  @param {number} [width] - Icon width in pixels
  @param {number} [padding] - Icon padding in pixels
  @param {string} [class] - Additional wrapper classes

  @example
  {% render 'icon', icon: 'arrow', width: 24 %}
{% enddoc %}

{% liquid
  assign icon_source = source | default: 'library'
  unless icon_source == 'library' or icon_source == 'custom'
    assign icon_source = 'library'
  endunless

  assign icon_name = icon | default: 'arrow-right'
  assign registered_icons = 'pencil-square|lock-closed|arrow|arrow-left|arrow-right|paper-airplane|bars-3|bars|grip-vertical|compare|menu|chevron|chevron-down|chevron-left|chevron-right|x-mark|close|eye|magnifying-glass|search|shopping-bag|bag|cart|shopping-cart|cube|user|users|account|truck|shipping|tag|discount|trash|remove|document-text|note|receipt-percent|coupon|share|play|pause|plus|minus|check|check-circle|x-circle|comparison-yes|comparison-no|information-circle|circle|square|triangle|diamond|star|four-stars|five-stars|calendar|calendar-days|clock|comment|chat-bubble|chat-bubble-left-right|shield-check|vertical-rule|funnel|sliders|arrow_right|long_arrow_right|chevron_right|arrow_up_right|circle_arrow|circle_chevron|long_arrow_up|double_chevron|arrow_outline|square_chevron' | split: '|'
  unless registered_icons contains icon_name
    assign icon_name = 'arrow-right'
  endunless

  assign icon_width = width | default: 24 | plus: 0
  if icon_width < 8 or icon_width > 100
    assign icon_width = 24
  endif

  assign icon_padding = padding | default: 0 | plus: 0
  if icon_padding < 0 or icon_padding > 100
    assign icon_padding = 0
  endif

  assign icon_body = blank
  if icon_source == 'custom'
    capture icon_body
      render 'custom-icon-image', markup: custom_icon
    endcapture
    assign icon_body = icon_body | strip
  else
    capture icon_body
      case icon_name
        when 'arrow', 'arrow-right', 'arrow_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'long_arrow_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M2 12h20m-6-6 6 6-6 6" /></svg>'
        when 'arrow_up_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M6 18 18 6M6 6h12v12" /></svg>'
        when 'circle_arrow'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><circle cx="12" cy="12" r="9" /><path d="M8 12h8m-4-4 4 4-4 4" /></svg>'
        when 'circle_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><circle cx="12" cy="12" r="9" /><path d="m10 8 4 4-4 4" /></svg>'
        when 'long_arrow_up'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M12 22V2m-6 6 6-6 6 6" /></svg>'
        when 'double_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="m5 5 7 7-7 7m7-14 7 7-7 7" /></svg>'
        when 'arrow_outline'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M3 8h9V3l9 9-9 9v-5H3Z" /></svg>'
        when 'square_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><rect x="3" y="3" width="18" height="18" rx="1" /><path d="m10 8 4 4-4 4" /></svg>'
        when 'arrow-left'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="m10.5 4.5-7.5 7.5m0 0 7.5 7.5M3 12h18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'paper-airplane'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="m3 4.5 18 7.5-18 7.5L7.5 12 3 4.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M7.5 12H21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/></svg>'
        when 'calendar'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3.75 9h16.5M5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'calendar-days'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3.75 9h16.5M5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>'
        when 'clock'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="var(--icon-stroke-width)"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/></svg>'
        when 'comment'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M7.5 8.25h9m-9 3h6m-7.5 7.5-3 2.25.75-3.75A7.5 7.5 0 0 1 3 12.75a7.5 7.5 0 0 1 7.5-7.5h3a7.5 7.5 0 0 1 7.5 7.5 7.5 7.5 0 0 1-7.5 7.5h-3a7.5 7.5 0 0 1-1.5-.15Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'chat-bubble'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M7.5 18.75 3.75 21l.75-4.5a8.25 8.25 0 1 1 3 2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M8.25 10.5h7.5m-7.5 3h4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/></svg>'
        when 'chat-bubble-left-right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M8.25 15.75 4.5 18l.75-4.5a7.5 7.5 0 1 1 2.25 2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M13.5 18.75a7.5 7.5 0 0 0 5.25-2.25l3 1.5-.75-3.75a7.5 7.5 0 0 0 .75-3.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/></svg>'
