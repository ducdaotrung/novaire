{% stylesheet %}
  .gallery-strip-item {
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--color-foreground-alpha-10, rgb(0 0 0 / 0.08));
  }

  .gallery-strip-item__image,
  .gallery-strip-item__image > picture,
  .gallery-strip-item__image > img,
  .gallery-strip-item__image .image__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-strip-item__image img,
  .gallery-strip-item__image .image__placeholder {
    object-fit: cover;
  }

{% endstylesheet %}
