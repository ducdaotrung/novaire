{% stylesheet %}
  .product-list__promo-item { display:flex; align-self:stretch; min-height:300px; }
  .product-list__promo-item > .promo-card { width:100%; }
  .product-list__mobile-promos:empty { display:none; }
  .product-list__mobile-promos { display:grid; gap:16px; margin-bottom:24px; }
  .product-list__mobile-promos .product-list__promo-item { width:100%; min-height:360px; }
{% endstylesheet %}
