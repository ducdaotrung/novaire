{% doc %}
  Renders the reusable empty state for a Product Card when a parent does not
  have a product resource yet.

  @param {string} card_class - Fully resolved Product Card classes from the shared card component
  @param {string} [attributes] - Theme Editor attributes for the card root
  @param {number} [placeholder_price] - Sample amount in shop currency units
  @param {string} [middle_content] - Optional HTML after product details
  @param {string} [footer_content] - Optional HTML at the bottom of card content

  @example
  {% render 'product-card-placeholder', card_class: 'product-card product-card--standard' %}
{% enddoc %}

<article
  class="{{ card_class | append: ' product-card--empty product-card--placeholder' | strip }}"
  data-product-card
  {% if attributes != blank %}{{ attributes }}{% endif %}
>
  <div class="product-card__media">
    {% render 'product-card-image', placeholder: true %}
  </div>
  <div class="product-card__content">
    <div class="product-card__details">
      {% render 'product-card-title', placeholder: true %}
      {% render 'product-card-price', placeholder: true, placeholder_price: placeholder_price %}
    </div>
    {% if middle_content != blank %}
      {{ middle_content }}
    {% endif %}
    {% if footer_content != blank %}
      {{ footer_content }}
    {% endif %}
  </div>
</article>
