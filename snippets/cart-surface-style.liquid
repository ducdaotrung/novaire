{% doc %}
  Cart panel appearance using shared semantic scheme tokens.
  The scheme Shadow color owns opacity, including its merchant-selected alpha.
  @param {object} settings - Block settings.
{% enddoc %}
--cart-surface-padding: {% case settings.padding %}{% when 'none' %}0{% when 'small' %}12px{% when 'large' %}32px{% else %}20px{% endcase %}; --cart-surface-border: {{ settings.border_width }}px; --cart-surface-shadow: {% case settings.shadow %}{% when 'none' %}none{% when 'sm' %}0 2px 10px{% when 'md' %}0 4px 20px{% else %}0 1px 5px{% endcase %}{% unless settings.shadow == 'none' %} var(--shadow-color){% endunless %};
