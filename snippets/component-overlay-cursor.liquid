{% doc %}
  Global close affordance for HTML component overlays. It is intentionally
  rendered once outside overlay content so it can follow the active backdrop.
{% enddoc %}
<custom-cursor data-component-overlay-cursor aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" focusable="false" aria-hidden="true">
    <path d="M13.3334 2.6665L2.66669 13.3332M2.66669 2.6665L13.3334 13.3332" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</custom-cursor>
