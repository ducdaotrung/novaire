{% doc %}
  Shared renderer for Image card and Promo card. Owns media/link/overlay/content.
  @param {object} block - Owning Theme Block with card settings/editor attributes
  @param {string} content - Rendered editable child blocks
  @param {boolean} [promo_card] - Enable section-owned grid dimensions and spans
{% enddoc %}
{% liquid
  assign image_card_media_type = block.settings.background_type | default: 'image'
  assign image_card_image = block.settings.image
  assign image_card_link = block.settings.link

  assign image_card_width_desktop_mode = block.settings.width_desktop | default: 'fill'
  assign image_card_width_desktop = '100%'
  assign image_card_size_desktop = '100vw'
  if image_card_width_desktop_mode == 'custom'
    assign image_card_width_desktop_value = block.settings.width_custom_desktop | default: 100 | plus: 0
    if image_card_width_desktop_value < 10 or image_card_width_desktop_value > 100
      assign image_card_width_desktop_value = 100
    endif
    assign image_card_width_desktop = image_card_width_desktop_value | append: '%'
    assign image_card_size_desktop = image_card_width_desktop_value | append: 'vw'
  endif

  assign image_card_max_width_desktop = '100%'
  assign image_card_max_width_desktop_value = block.settings.max_width_desktop | default: 1600 | plus: 0
  if image_card_max_width_desktop_value < 0 or image_card_max_width_desktop_value > 1600
    assign image_card_max_width_desktop_value = 1600
  endif
  if block.settings.limit_width_desktop and image_card_max_width_desktop_value > 0
    assign image_card_max_width_desktop = image_card_max_width_desktop_value | append: 'px'
  endif

  assign image_card_width_mobile_mode = block.settings.width_mobile | default: 'fill'
  assign image_card_width_mobile = '100%'
  assign image_card_size_mobile = '100vw'
  if image_card_width_mobile_mode == 'custom'
    assign image_card_width_mobile_value = block.settings.width_custom_mobile | default: 100 | plus: 0
    if image_card_width_mobile_value < 10 or image_card_width_mobile_value > 100
      assign image_card_width_mobile_value = 100
    endif
    assign image_card_width_mobile = image_card_width_mobile_value | append: '%'
    assign image_card_size_mobile = image_card_width_mobile_value | append: 'vw'
  endif

  assign image_card_max_width_mobile = '100%'
  assign image_card_max_width_mobile_value = block.settings.max_width_mobile | default: 1600 | plus: 0
  if image_card_max_width_mobile_value < 0 or image_card_max_width_mobile_value > 1600
    assign image_card_max_width_mobile_value = 1600
  endif
  if block.settings.limit_width_mobile and image_card_max_width_mobile_value > 0
    assign image_card_max_width_mobile = image_card_max_width_mobile_value | append: 'px'
  endif

  assign image_card_height_desktop = block.settings.height_desktop | default: 'ratio_1_1'
  assign image_card_height_mobile = block.settings.height_mobile | default: 'ratio_1_1'
  if promo_card
    assign image_card_height_desktop = 'fill'
    assign image_card_height_mobile = 'fill'
  endif
  assign image_card_position_desktop = block.settings.position_desktop | default: 'top_center'
  assign image_card_position_mobile = block.settings.position_mobile | default: 'top_center'

  assign image_card_gap_desktop = block.settings.gap_desktop | default: 20 | plus: 0
  assign image_card_gap_mobile = block.settings.gap_mobile | default: 16 | plus: 0

  assign image_card_padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign image_card_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign image_card_padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign image_card_padding_right = block.settings.padding_right | default: 0 | plus: 0

  if image_card_padding_top < 0 or image_card_padding_top > 100
    assign image_card_padding_top = 0
  endif
  if image_card_padding_bottom < 0 or image_card_padding_bottom > 100
    assign image_card_padding_bottom = 0
  endif
  if image_card_padding_left < 0 or image_card_padding_left > 100
    assign image_card_padding_left = 0
  endif
  if image_card_padding_right < 0 or image_card_padding_right > 100
    assign image_card_padding_right = 0
  endif

  assign image_card_padding_top_mobile = image_card_padding_top
  assign image_card_padding_bottom_mobile = image_card_padding_bottom
  assign image_card_padding_left_mobile = image_card_padding_left
  assign image_card_padding_right_mobile = image_card_padding_right
  if block.settings.customize_mobile_padding
    assign image_card_padding_top_mobile = block.settings.padding_top_mobile | default: image_card_padding_top | plus: 0
    assign image_card_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: image_card_padding_bottom | plus: 0
    assign image_card_padding_left_mobile = block.settings.padding_left_mobile | default: image_card_padding_left | plus: 0
    assign image_card_padding_right_mobile = block.settings.padding_right_mobile | default: image_card_padding_right | plus: 0

    if image_card_padding_top_mobile < 0 or image_card_padding_top_mobile > 100
      assign image_card_padding_top_mobile = image_card_padding_top
    endif
    if image_card_padding_bottom_mobile < 0 or image_card_padding_bottom_mobile > 100
      assign image_card_padding_bottom_mobile = image_card_padding_bottom
    endif
    if image_card_padding_left_mobile < 0 or image_card_padding_left_mobile > 100
      assign image_card_padding_left_mobile = image_card_padding_left
    endif
    if image_card_padding_right_mobile < 0 or image_card_padding_right_mobile > 100
      assign image_card_padding_right_mobile = image_card_padding_right
    endif
  endif

  assign image_card_radius = block.settings.corner_radius | default: 'square'
  assign image_card_scheme = block.settings.color_scheme | default: 'scheme-1'
  if block.settings.color_scheme.id != blank
    assign image_card_scheme = block.settings.color_scheme.id
  endif
  assign image_card_scheme = image_card_scheme | default: 'scheme-1' | handleize

  assign image_card_has_link = false
  if image_card_link != blank
    assign image_card_has_link = true
  endif

  assign image_card_media_alt = image_card_image.alt | default: block.settings.mobile_image.alt | default: block.settings.video.preview_image.alt | default: block.settings.mobile_video.preview_image.alt


  assign image_card_link_label = 'accessibility.image_card_link' | t
  if image_card_media_alt != blank
    assign image_card_link_label = image_card_media_alt
  endif

  assign image_card_media_aria_hidden = false
  if image_card_has_link or image_card_media_type == 'video'
    assign image_card_media_aria_hidden = true
  endif

  assign image_card_class = 'image-card'
  if block.settings.zoom_on_hover
    assign image_card_class = image_card_class | append: ' image-card--zoom'
  endif
  if promo_card and section.settings.carousel_mobile
    assign image_card_class = image_card_class | append: ' swiper-slide'
  endif
  if image_card_has_link
    assign image_card_class = image_card_class | append: ' image-card--linked'
  endif
  if block.settings.show_overlay
    assign image_card_class = image_card_class | append: ' image-card--has-overlay'
  endif
  if block.settings.enable_sticky
    assign image_card_class = image_card_class | append: ' image-card--content-sticky'
  endif
  if image_card_width_desktop_mode == 'custom'
    assign image_card_class = image_card_class | append: ' image-card--width-desktop-custom'
  endif
  if image_card_width_mobile_mode == 'custom'
    assign image_card_class = image_card_class | append: ' image-card--width-mobile-custom'
  endif
  assign image_card_class = image_card_class | append: ' image-card--height-desktop-' | append: image_card_height_desktop
  assign image_card_class = image_card_class | append: ' image-card--height-mobile-' | append: image_card_height_mobile
  assign image_card_class = image_card_class | append: ' image-card--position-desktop-' | append: image_card_position_desktop
  assign image_card_class = image_card_class | append: ' image-card--position-mobile-' | append: image_card_position_mobile
  assign image_card_class = image_card_class | append: ' image-card--radius-' | append: image_card_radius
  assign image_card_class = image_card_class | append: ' color-scheme section-color-scope ' | append: image_card_scheme
%}

{% capture image_card_style %}
  {% if promo_card %}
    --promo-card-columns:{{ block.settings.columns_wide | default: 1 | at_least: 1 | at_most: 4 }};
    --promo-card-rows:{{ block.settings.rows_tall | default: 1 | at_least: 1 | at_most: 4 }};
  {% endif %}
  {% if image_card_width_desktop != '100%' %}--image-card-width: {{ image_card_width_desktop }};{% endif %}
  {% if image_card_max_width_desktop != '100%' %}--image-card-max-width: {{ image_card_max_width_desktop }};{% endif %}
  {% if image_card_padding_top != 0 %}--image-card-padding-top: {{ image_card_padding_top }}px;{% endif %}
  {% if image_card_padding_bottom != 0 %}--image-card-padding-bottom: {{ image_card_padding_bottom }}px;{% endif %}
  {% if image_card_padding_left != 0 %}--image-card-padding-left: {{ image_card_padding_left }}px;{% endif %}
  {% if image_card_padding_right != 0 %}--image-card-padding-right: {{ image_card_padding_right }}px;{% endif %}
  {% if image_card_width_mobile != image_card_width_desktop %}--image-card-width-mobile: {{ image_card_width_mobile }};{% endif %}
  {% if image_card_max_width_mobile != image_card_max_width_desktop %}--image-card-max-width-mobile: {{ image_card_max_width_mobile }};{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if image_card_padding_top_mobile != image_card_padding_top %}--image-card-padding-top-mobile: {{ image_card_padding_top_mobile }}px;{% endif %}
    {% if image_card_padding_bottom_mobile != image_card_padding_bottom %}--image-card-padding-bottom-mobile: {{ image_card_padding_bottom_mobile }}px;{% endif %}
    {% if image_card_padding_left_mobile != image_card_padding_left %}--image-card-padding-left-mobile: {{ image_card_padding_left_mobile }}px;{% endif %}
    {% if image_card_padding_right_mobile != image_card_padding_right %}--image-card-padding-right-mobile: {{ image_card_padding_right_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign image_card_style = image_card_style | strip %}

{% assign image_card_content_justify = 'var(--image-card-content-justify, flex-start)' %}
{% if block.settings.enable_sticky %}
  {% assign image_card_content_justify = 'flex-start' %}
{% endif %}

{% capture image_card_content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    justify_content: image_card_content_justify,
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: image_card_gap_desktop,
    gap_mobile: image_card_gap_mobile
  %}
{% endcapture %}
{% assign image_card_content_style = image_card_content_style | strip %}

{% if promo_card %}
  {% liquid
    assign span = block.settings.columns_wide | default: 1 | at_least: 1 | at_most: 4
    assign desktop_columns = section.settings.columns_desktop | plus: 0 | at_least: 1
    assign tablet_columns = section.settings.columns_tablet | plus: 0 | at_least: 1
    assign mobile_columns = section.settings.columns_mobile | plus: 0 | at_least: 1
    assign desktop_fraction = span | at_most: desktop_columns | times: 100.0 | divided_by: desktop_columns
    assign tablet_fraction = span | at_most: tablet_columns | times: 100.0 | divided_by: tablet_columns
    assign mobile_fraction = 100.0 | divided_by: mobile_columns
    assign image_card_size_desktop = desktop_fraction | append: 'vw'
    assign image_card_size_mobile = mobile_fraction | append: 'vw'
  %}
{% endif %}
{% capture image_card_sizes %}{% if promo_card %}(min-width: 1150px) {{ image_card_size_desktop }}, (min-width: 768px) {{ tablet_fraction }}vw{% else %}(min-width: 768px) {{ image_card_size_desktop }}{% endif %}, {{ image_card_size_mobile }}{% endcapture %}

<article
  class="{{ image_card_class }}"
  {% if image_card_style != blank %}style="{{ image_card_style }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="image-card__media">
    {% render 'media-background',
      media_type: image_card_media_type,
      image: image_card_image,
      mobile_image: block.settings.mobile_image,
      video: block.settings.video,
      mobile_video: block.settings.mobile_video,
      alt: image_card_media_alt,
      sizes: image_card_sizes,
      aria_hidden: image_card_media_aria_hidden
    %}
  </div>

  {% if block.settings.show_overlay %}
    {% capture image_card_overlay_background %}{% render 'overlay-background', overlay_settings: block.settings %}{% endcapture %}
    {% assign image_card_overlay_background = image_card_overlay_background | strip %}
    <span class="image-card__overlay" style="background:{{ image_card_overlay_background | escape }};" aria-hidden="true"></span>
  {% endif %}

  {% if image_card_has_link %}
    <a
      class="image-card__link"
      href="{{ image_card_link | escape }}"
      aria-label="{{ image_card_link_label | escape }}"
      {% if block.settings.open_in_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
    ></a>
  {% endif %}

  <div class="image-card__content layout-flow layout-flow--responsive align-content{% if block.settings.enable_sticky %} image-card__content--sticky{% endif %}" style="{{ image_card_content_style }}">
    {{ content }}
  </div>
</article>

{% render 'deferred-stylesheet', filename: 'component-blocks-image-card.css' %}
