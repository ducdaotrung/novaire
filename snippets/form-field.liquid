{% doc %}
  Renders an accessible form field using the global Form settings.

  @param {string} id - Unique field id
  @param {string} name - Form field name
  @param {string} label - Visible label
  @param {string} [type] - Input type, defaults to text
  @param {string} [control] - Control type: input, textarea, or select
  @param [options] - Select options with value and label properties
  @param {string} [selected] - Selected value for a select control
  @param {string} [value] - Current value
  @param {string} [placeholder] - Optional placeholder
  @param {string} [helper_text] - Optional helper text
  @param {string} [error_text] - Optional error text
  @param {string} [autocomplete] - Optional autocomplete value
  @param {string} [class] - Optional class added to the field wrapper
  @param {string} [control_class] - Optional class added to the control
  @param {string} [inputmode] - Optional input mode hint for mobile keyboards
  @param {string} [pattern] - Optional HTML validation pattern
  @param {boolean} [required] - Whether the field is required
  @param {boolean} [disabled] - Whether the field is disabled
  @param {boolean} [hide_label] - Visually hide the label while keeping it accessible

  @example
  {% render 'form-field', id: 'search-q', name: 'q', label: 'Search', type: 'search' %}
{% enddoc %}

{% liquid
  assign control_type = control | default: 'input'
  assign input_type = type | default: 'text'
  assign control_classes = 'form__control'
  case control_type
    when 'textarea'
      assign control_classes = control_classes | append: ' form__control--textarea'
    when 'select'
      assign control_classes = control_classes | append: ' form__control--select'
    else
      assign control_classes = control_classes | append: ' form__control--input'
  endcase
  if error_text != blank
    assign control_classes = control_classes | append: ' form__control--error'
  endif
  if control_class != blank
    assign control_classes = control_classes | append: ' ' | append: control_class
  endif

  assign field_classes = 'form__field'
  assign label_classes = 'form__label'
  if hide_label
    assign label_classes = label_classes | append: ' visually-hidden'
  endif
  if error_text != blank
    assign field_classes = field_classes | append: ' form__field--has-error'
  endif
  if class != blank
    assign field_classes = field_classes | append: ' ' | append: class
  endif

  assign describedby = ''
  if helper_text != blank
    assign describedby = id | append: '-help'
  endif
  if error_text != blank
    if describedby != blank
      assign describedby = describedby | append: ' '
    endif
    assign describedby = describedby | append: id | append: '-error'
  endif
%}

<div class="{{ field_classes }}">
  <label class="{{ label_classes }}" for="{{ id }}">{{ label | escape }}</label>

  {% case control_type %}
    {% when 'textarea' %}
      <textarea
        class="{{ control_classes }}"
        id="{{ id }}"
        name="{{ name }}"
        {% if placeholder != blank %}
          placeholder="{{ placeholder | escape }}"
        {% endif %}
        {% if autocomplete != blank %}
          autocomplete="{{ autocomplete | escape }}"
        {% endif %}
        {% if inputmode != blank %}
          inputmode="{{ inputmode | escape }}"
        {% endif %}
        {% if pattern != blank %}
          pattern="{{ pattern | escape }}"
        {% endif %}
        {% if describedby != blank %}
          aria-describedby="{{ describedby }}"
        {% endif %}
        {% if error_text != blank %}
          aria-invalid="true"
        {% endif %}
        {% if required %}
          required
        {% endif %}
        {% if disabled %}
          disabled
        {% endif %}
      >{{ value | escape }}</textarea>
    {% when 'select' %}
      <div class="form__control-wrap form__control-wrap--select">
        <select
          class="{{ control_classes }}"
          id="{{ id }}"
          name="{{ name }}"
          {% if describedby != blank %}
            aria-describedby="{{ describedby }}"
          {% endif %}
          {% if error_text != blank %}
            aria-invalid="true"
          {% endif %}
          {% if required %}
            required
          {% endif %}
          {% if disabled %}
            disabled
          {% endif %}
        >
          {% if placeholder != blank %}
            <option value=""{% if selected == blank %} selected{% endif %}>{{ placeholder | escape }}</option>
          {% endif %}
          {% for option in options %}
            {% assign option_value = option.value | default: option | strip %}
            {% assign option_label = option.label | default: option.name | default: option | strip %}
            <option value="{{ option_value | escape }}"{% if option_value == selected %} selected{% endif %}>
              {{ option_label | escape }}
            </option>
          {% endfor %}
        </select>
      </div>
    {% else %}
      <input
        class="{{ control_classes }}"
        id="{{ id }}"
        name="{{ name }}"
        type="{{ input_type | escape }}"
        value="{{ value | escape }}"
        {% if placeholder != blank %}
          placeholder="{{ placeholder | escape }}"
        {% endif %}
        {% if autocomplete != blank %}
          autocomplete="{{ autocomplete | escape }}"
        {% endif %}
        {% if inputmode != blank %}
          inputmode="{{ inputmode | escape }}"
        {% endif %}
        {% if pattern != blank %}
          pattern="{{ pattern | escape }}"
        {% endif %}
        {% if describedby != blank %}
          aria-describedby="{{ describedby }}"
        {% endif %}
        {% if error_text != blank %}
          aria-invalid="true"
        {% endif %}
        {% if required %}
          required
        {% endif %}
        {% if disabled %}
          disabled
        {% endif %}
      >
  {% endcase %}

  {% if helper_text != blank %}
    <p class="form__helper" id="{{ id }}-help">{{ helper_text | escape }}</p>
  {% endif %}
  {% if error_text != blank %}
    <p class="form__error" id="{{ id }}-error" role="alert">{{ error_text | escape }}</p>
  {% endif %}
</div>
