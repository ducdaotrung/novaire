    },
    {
      "type": "color",
      "id": "overlay",
      "label": "t:labels.overlay_color",
      "alpha": true,
      "default": "#0000001A",
      "visible_if": "{{ section.settings.media_type != 'none' and section.settings.show_overlay and section.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ section.settings.media_type != 'none' and section.settings.show_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "select",
      "id": "parallax_effect",
      "label": "t:labels.parallax_effect",
      "options": [
        {
          "value": "none",
          "label": "t:options.parallax.none"
        },
        {
          "value": "fixed",
          "label": "t:options.parallax.fixed"
        },
        {
          "value": "vertical",
          "label": "t:options.parallax.vertical"
        },
        {
          "value": "horizontal",
          "label": "t:options.parallax.horizontal"
        },
        {
          "value": "zoom",
          "label": "t:options.parallax.zoom"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.media_type != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
