        },
        {
          "type": "image-text-stacked-band",
          "settings": { "image_alt": "", "gap_desktop": 16, "gap_mobile": 12, "tag": "<p>#3</p>", "heading": "<p>Made to last</p>", "text": "<p>Timeless forms, considered materials, and quality made for everyday use.</p>", "button_label": "Learn more", "button_link": "" }
        }
      ]
