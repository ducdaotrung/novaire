{% liquid
  assign quick_view_desktop_layout = section.settings.desktop_layout | default: 'popup'
  unless quick_view_desktop_layout == 'popup' or quick_view_desktop_layout == 'drawer'
    assign quick_view_desktop_layout = 'popup'
  endunless

  assign quick_view_mobile_layout = section.settings.mobile_layout | default: 'bottom_sheet'
  unless quick_view_mobile_layout == 'bottom_sheet' or quick_view_mobile_layout == 'drawer'
    assign quick_view_mobile_layout = 'bottom_sheet'
  endunless

  assign quick_view_media_position = section.settings.media_position | default: 'left'
  unless quick_view_media_position == 'top' or quick_view_media_position == 'left'
    assign quick_view_media_position = 'left'
  endunless

  assign quick_view_width = section.settings.desktop_width | default: 1200 | plus: 0
  if quick_view_width < 420 or quick_view_width > 1400
    assign quick_view_width = 1200
  endif

  assign quick_view_gap_desktop = section.settings.gap_desktop | default: 40 | plus: 0
  if quick_view_gap_desktop < 0 or quick_view_gap_desktop > 80
    assign quick_view_gap_desktop = 40
  endif

  assign quick_view_gap_mobile = section.settings.gap_mobile | default: 20 | plus: 0
  if quick_view_gap_mobile < 0 or quick_view_gap_mobile > 48
    assign quick_view_gap_mobile = 20
  endif

  assign quick_view_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign quick_view_scheme = section.settings.color_scheme.id
  endif
  assign quick_view_scheme = quick_view_scheme | default: 'scheme-1' | handleize

  assign quick_view_product = product
  assign quick_view_title = 'products.quick_view' | t
  assign quick_view_dialog_id = 'QuickView-' | append: section.id
%}

{% render 'deferred-stylesheet', filename: 'product-information.css' %}
{% render 'deferred-stylesheet', filename: 'product-information-extras.css' %}
{% render 'deferred-stylesheet', filename: 'product-media.css' %}
{% render 'deferred-stylesheet', filename: 'component-bouncing-dots.css' %}
{% render 'deferred-stylesheet', filename: 'quick-view.css' %}
<script type="module" src="{{ 'quick-view.js' | asset_url }}"></script>

{% capture quick_view_attributes %}
  data-quick-view-overlay
  data-product-media-module-url="{{ 'product-media.js' | asset_url | escape }}"
  data-quick-view-section-id="{{ section.id }}"
  data-quick-view-error-label="{{ 'products.quick_view_error' | t | escape }}"
  data-quick-view-retry-label="{{ 'products.quick_view_retry' | t | escape }}"
  data-overlay-color-scheme="{{ quick_view_scheme }}"
{% endcapture %}
{% assign quick_view_attributes = quick_view_attributes | strip_newlines | strip %}

{% capture quick_view_content %}
  <div
    class="quick-view__content color-scheme section-color-scope {{ quick_view_scheme }} quick-view--media-{{ quick_view_media_position }}"
    data-quick-view-content
    data-product-information
    data-quick-view-has-product="{% if quick_view_product != blank %}true{% else %}false{% endif %}"
    {% if quick_view_product != blank %}data-quick-view-product-id="{{ quick_view_product.id }}"{% endif %}
    style="--quick-view-gap-desktop: {{ quick_view_gap_desktop }}px; --quick-view-gap-mobile: {{ quick_view_gap_mobile }}px;"
  >
    <div class="quick-view__layout" data-quick-view-layout hidden>
      <div class="quick-view__media">
        {% content_for 'block', type: '_overlay-product-media', id: 'product-media' %}
      </div>
      <div class="quick-view__details">
        {% content_for 'block', type: '_product-details', id: 'product-details' %}
      </div>
    </div>

    <div class="quick-view__loading" data-quick-view-loading role="status" aria-live="polite" hidden>
      <span class="quick-view__spinner" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
    </div>

    <div class="quick-view__error" data-quick-view-error role="alert" hidden>
      <p data-quick-view-error-message>{{ 'products.quick_view_error' | t }}</p>
      <button class="btn btn--secondary quick-view__retry" type="button" data-quick-view-retry>
        {{ 'products.quick_view_retry' | t }}
      </button>
    </div>
  </div>
{% endcapture %}

{% render 'component-overlay',
  id: quick_view_dialog_id,
  content: quick_view_content,
  label: quick_view_title,
  desktop_layout: quick_view_desktop_layout,
  mobile_layout: quick_view_mobile_layout,
  width: quick_view_width,
  body_class: 'quick-view__body',
  append_to_body: true,
  attributes: quick_view_attributes,
  title: quick_view_title
%}

{% schema %}
{
  "name": "t:general.quick_view",
  "class": "section-quick-view",
  "enabled_on": { "groups": ["custom.overlay"] },
  "blocks": [
    { "type": "_overlay-product-media" },
    { "type": "_product-details" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:labels.desktop_layout",
      "options": [
        { "value": "popup", "label": "Popup" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "default": "popup"
    },
    {
      "type": "range",
      "id": "desktop_width",
      "label": "t:labels.desktop_width",
      "min": 420,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:labels.mobile_layout",
      "options": [
        { "value": "bottom_sheet", "label": "Bottom sheet" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "default": "bottom_sheet"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "left", "label": "Left" }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
