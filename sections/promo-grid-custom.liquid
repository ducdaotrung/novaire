{% liquid
  assign container_width = 'page-width'
  if section.settings.section_width != 'page_width'
    assign container_width = 'full-width'
  endif
  assign scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1'
  assign top_mobile = section.settings.padding_top
  assign bottom_mobile = section.settings.padding_bottom
  if section.settings.customize_mobile_padding
    assign top_mobile = section.settings.padding_top_mobile
    assign bottom_mobile = section.settings.padding_bottom_mobile
  endif
%}
{% style %}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}; }
{% endstyle %}
<div class="section-spacing promo-grid color-scheme section-color-scope {{ scheme | handleize }}"
  style="--promo-columns:{{ section.settings.columns_desktop | default: 3 }};--promo-columns-tablet:{{ section.settings.columns_tablet | default: 2 }};--promo-columns-mobile:{{ section.settings.columns_mobile | default: 1 }};--promo-gap:{{ section.settings.gap_desktop }}px;--promo-gap-mobile:{{ section.settings.gap_mobile }}px;--promo-top:{{ section.settings.padding_top }}px;--promo-bottom:{{ section.settings.padding_bottom }}px;--promo-top-mobile:{{ top_mobile }}px;--promo-bottom-mobile:{{ bottom_mobile }}px;{% if section.settings.background_color != blank %}--promo-background:{{ section.settings.background_color | escape }};{% endif %}"
  data-height-desktop="{{ section.settings.height_desktop }}" data-height-mobile="{{ section.settings.height_mobile }}">
  {% if section.settings.background_image != blank %}<div class="media-background-surface" aria-hidden="true">{{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'background-media-paint', loading: 'lazy' }}</div>{% endif %}
  <div class="container {{ container_width }}{% if section.settings.section_width == 'full_width_no_padding' %} promo-grid__no-padding{% endif %}">
    {% capture cards %}{% content_for 'blocks' %}{% endcapture %}
    {% if section.settings.carousel_mobile %}
      {% capture attributes %}data-product-carousel data-layout="carousel" data-swiper-mobile-only="true" data-swiper-columns-mobile="{{ section.settings.columns_mobile }}" data-swiper-gap-mobile="{{ section.settings.gap_mobile }}"{% endcapture %}
      {% capture pagination_style %}
        {% if section.settings.pagination_thickness == 'thin' %}--swiper-pagination-progressbar-size:2px;{% endif %}
        --swiper-pagination-spacing-mobile:{{ section.settings.pagination_padding_mobile | default: 24 }}px;
        {% if section.settings.pagination_type == 'progress_bar' and section.settings.pagination_limit_width %}--swiper-pagination-width:min(100%, {{ section.settings.pagination_max_width | default: 260 }}px);{% endif %}
      {% endcapture %}
      {% capture pagination %}{% render 'swiper-pagination', show: section.settings.show_pagination_on_mobile, type: section.settings.pagination_type, style: pagination_style %}{% endcapture %}
      {% render 'swiper-carousel', content: cards, root_class: 'promo-grid__carousel', wrapper_class: 'promo-grid__items', root_attributes: attributes, pagination: pagination, show_next_slide_preview_on_mobile: section.settings.show_next_slide_preview_on_mobile %}
      <script type="module" src="{{ 'product-collection-carousel.js' | asset_url }}"></script>
      <script type="module" src="{{ 'promo-grid.js' | asset_url }}"></script>
    {% else %}<div class="promo-grid__items">{{ cards }}</div>{% endif %}
  </div>
</div>
{% if request.design_mode %}{{ 'component-sections-promo-grid.css' | asset_url | stylesheet_tag }}{% else %}{% render 'deferred-stylesheet', filename: 'component-sections-promo-grid.css' %}{% endif %}

