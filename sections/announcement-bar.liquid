{% capture effective_overlay %}{% render 'overlay-background', overlay_settings: section.settings, color_id: 'overlay_color', enabled_id: 'overlay', style_id: 'overlay_style' %}{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}
{% liquid
  assign announcement_type = section.settings.type | default: 'slider'
  unless announcement_type == 'slider' or announcement_type == 'scrolling'
    assign announcement_type = 'slider'
  endunless
  assign announcement_speed = section.settings.speed | default: 1 | plus: 0
  if announcement_speed < 0 or announcement_speed > 2
    assign announcement_speed = 1
  endif
  assign announcement_direction = section.settings.direction | default: 'left'
  unless announcement_direction == 'left' or announcement_direction == 'right'
    assign announcement_direction = 'left'
  endunless
  assign announcement_gap = section.settings.gap | default: 16 | plus: 0
  assign announcement_padding_top = section.settings.padding_top | default: 8 | plus: 0
  assign announcement_padding_right = section.settings.padding_right | default: 0 | plus: 0
  assign announcement_padding_bottom = section.settings.padding_bottom | default: 8 | plus: 0
  assign announcement_padding_left = section.settings.padding_left | default: 0 | plus: 0
  assign announcement_color_scheme = section.settings.color_scheme | default: 'scheme-3'
  if section.settings.color_scheme.id != blank
    assign announcement_color_scheme = section.settings.color_scheme.id
  endif
  assign announcement_color_scheme = announcement_color_scheme | default: 'scheme-3' | handleize
  assign announcement_autoplay = section.settings.autoplay | default: 5 | plus: 0
  if announcement_autoplay < 1 or announcement_autoplay > 10
    assign announcement_autoplay = 5
  endif
  assign announcement_pause_on_hover = true
  if section.settings.pause_on_hover == false or section.settings.pause_on_hover == 'false'
    assign announcement_pause_on_hover = false
  endif
  assign announcement_navigation_behavior = section.settings.navigation_behavior | default: 'show_on_hover'
  unless announcement_navigation_behavior == 'always' or announcement_navigation_behavior == 'show_on_hover'
    assign announcement_navigation_behavior = 'show_on_hover'
  endunless
  assign announcement_navigation_icon = section.settings.navigation_icon | default: 'arrow'
  unless announcement_navigation_icon == 'chevron' or announcement_navigation_icon == 'arrow' or announcement_navigation_icon == 'long_arrow'
    assign announcement_navigation_icon = 'arrow'
  endunless
  assign announcement_font_size = section.settings.font_size | default: 'sm'
  unless announcement_font_size == 'xs' or announcement_font_size == 'sm' or announcement_font_size == 'md' or announcement_font_size == 'lg' or announcement_font_size == 'xl' or announcement_font_size == 'xxl'
    assign announcement_font_size = 'sm'
  endunless
  assign announcement_background_type = section.settings.background_type | default: 'none'
  unless announcement_background_type == 'none' or announcement_background_type == 'image'
    assign announcement_background_type = 'none'
  endunless
  assign announcement_overlay = false
  if section.settings.overlay and announcement_background_type == 'image'
    assign announcement_overlay = true
  endif
%}

<script type="module" src="{{ 'announcement-bar.js' | asset_url }}"></script>

<div
  class="announcement-bar announcement-bar--{{ announcement_type }} announcement-bar--direction-{{ announcement_direction }} announcement-bar--navigation-{{ announcement_navigation_behavior }} color-scheme section-color-scope body-text body-{{ announcement_font_size }} {{ announcement_color_scheme }}{% if announcement_speed == 0 %} announcement-bar--static{% endif %}{% if section.settings.bottom_separator %} announcement-bar--bottom-separator{% endif %}"
  data-announcement-bar
  data-announcement-type="{{ announcement_type }}"
  data-announcement-speed="{{ announcement_speed }}"
  data-announcement-direction="{{ announcement_direction }}"
  data-announcement-autoplay="{{ announcement_autoplay | times: 1000 }}"
  data-announcement-pause-on-hover="{{ announcement_pause_on_hover }}"
  style="--announcement-bar-gap: {{ announcement_gap }}px; --announcement-bar-speed: {{ announcement_speed }}; --announcement-bar-padding-top: {{ announcement_padding_top }}px; --announcement-bar-padding-right: {{ announcement_padding_right }}px; --announcement-bar-padding-bottom: {{ announcement_padding_bottom }}px; --announcement-bar-padding-left: {{ announcement_padding_left }}px;{% if announcement_overlay and section.settings.overlay %} --announcement-bar-overlay-color: {{ effective_overlay | default: 'transparent' | escape }};{% endif %}"
>
  {% if announcement_background_type == 'image' and section.settings.background_image != blank %}
    <div class="announcement-bar__background" aria-hidden="true">
      {% render 'image', image: section.settings.background_image, mobile_image: section.settings.mobile_background_image, alt: '', widths: '480, 720, 960, 1200, 1600, 2400', sizes: '100vw', class: 'announcement-bar__background-image' %}
      {% if announcement_overlay %}<div class="announcement-bar__overlay"></div>{% endif %}
    </div>
  {% endif %}
  <div class="announcement-bar__inner">
    <button class="announcement-bar__control announcement-bar__control--previous" type="button" data-announcement-previous aria-label="Previous announcement">
      {% render 'carousel-navigation-icon', icon: announcement_navigation_icon, direction: 'previous' %}
    </button>
    <div class="announcement-bar__viewport" data-announcement-viewport>
      <div class="announcement-bar__slides" data-announcement-track>
        {% content_for 'blocks' %}
      </div>
    </div>
    <button class="announcement-bar__control announcement-bar__control--next" type="button" data-announcement-next aria-label="Next announcement">
      {% render 'carousel-navigation-icon', icon: announcement_navigation_icon, direction: 'next' %}
    </button>
  </div>
</div>

{% stylesheet %}
  .announcement-bar--slider .announcement-bar__viewport { transition: height var(--motion-duration-standard) var(--motion-ease-standard); }
  .announcement-bar--slider .announcement-bar__slides { transition: transform 420ms var(--motion-ease-standard); will-change: transform; }
  .announcement-bar--slider .announcement-bar__slides.announcement-bar--slider-reset { transition: none; }
  .announcement-bar--slider .announcement-bar__slides > .text-block { transition: opacity 360ms var(--motion-ease-standard); }
  .announcement-bar--slider.announcement-bar--slider-moving .announcement-bar__slides > .text-block[data-announcement-state='exit'] { opacity: 0; }
  .announcement-bar--scrolling .announcement-bar__slides { will-change: transform; }
  .announcement-bar--scrolling.announcement-bar--ready .announcement-bar__slides { animation: announcement-scroll-left calc(28s / var(--announcement-bar-speed, 1)) linear infinite; }
  .announcement-bar--scrolling.announcement-bar--direction-right.announcement-bar--ready .announcement-bar__slides { animation-name: announcement-scroll-right; }
  .announcement-bar--scrolling.announcement-bar--static .announcement-bar__slides { animation: none; }
  .announcement-bar__control:hover { opacity: 0.7; }
  .announcement-bar__control:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .announcement-bar--slider.announcement-bar--navigation-show_on_hover .announcement-bar__inner > .announcement-bar__control { transition: opacity var(--motion-duration-standard) var(--motion-ease-standard); }
  .announcement-bar--slider.announcement-bar--navigation-show_on_hover:is(:hover, :focus-within) .announcement-bar__inner > .announcement-bar__control { opacity: 1; }
  .announcement-bar--scrolling:hover .announcement-bar__slides, .announcement-bar--scrolling:focus-within .announcement-bar__slides { animation-play-state: paused; }
  @keyframes announcement-scroll-left { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(calc(-1 * var(--announcement-bar-loop-distance)), 0, 0); } }
  @keyframes announcement-scroll-right { from { transform: translate3d(calc(-1 * var(--announcement-bar-loop-distance)), 0, 0); } to { transform: translate3d(0, 0, 0); } }
  @media (prefers-reduced-motion: reduce) { .announcement-bar__slides, .announcement-bar__viewport, .announcement-bar__slides > .text-block { transition-duration: 0.01ms; } .announcement-bar--scrolling .announcement-bar__slides { animation: none; transform: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement-bar",
  "tag": "div",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "limit": 1,
  "max_blocks": 4,
  "blocks": [
    {
      "type": "announcement-text"
    },
    {
      "type": "discount-code"
    },
    {
      "type": "announcement-countdown-timer"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Bottom separator"
    },
    {
      "type": "checkbox",
      "id": "bottom_separator",
      "label": "Show bottom separator",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "type",
      "label": "Type",
      "options": [
        {
          "value": "scrolling",
          "label": "Scrolling"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "visible_if": "{{ section.settings.type == 'scrolling' }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.type == 'scrolling' }}"
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-play slider",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.type == 'slider' }}"
    },
    {
      "type": "select",
      "id": "navigation_behavior",
      "label": "Navigation behavior",
      "options": [
        {
          "value": "always",
          "label": "Always show"
        },
        {
          "value": "show_on_hover",
          "label": "Show on hover"
        }
      ],
      "default": "show_on_hover",
      "visible_if": "{{ section.settings.type == 'slider' }}"
    },
    {
      "type": "select",
      "id": "navigation_icon",
      "label": "Navigation icon",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "long_arrow",
          "label": "Long arrow"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.type == 'slider' }}"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Font size",
      "options": [
        {
          "value": "xs",
          "label": "t:options.text_size.xs"
        },
        {
          "value": "sm",
          "label": "t:options.text_size.sm"
        },
        {
          "value": "md",
          "label": "t:options.text_size.md"
        },
        {
          "value": "lg",
          "label": "t:options.text_size.lg"
        },
        {
          "value": "xl",
          "label": "t:options.text_size.xl"
        },
        {
          "value": "xxl",
          "label": "t:options.text_size.xxl"
        }
      ],
      "default": "sm"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile image (optional)",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "t:labels.show_overlay",
      "default": false,
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.background_type == 'image' and section.settings.overlay }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#00000033",
      "visible_if": "{{ section.settings.background_type == 'image' and section.settings.overlay and section.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ section.settings.background_type == 'image' and section.settings.overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "t:general.header",
      "settings": {
        "type": "slider",
        "speed": 1,
        "direction": "left",
        "autoplay": 5,
        "pause_on_hover": true,
        "navigation_behavior": "show_on_hover",
        "navigation_icon": "arrow",
        "font_size": "sm",
        "background_type": "none",
        "overlay": false,
        "gap": 16,
        "color_scheme": "scheme-3",
        "bottom_separator": false,
        "padding_top": 8,
        "padding_right": 0,
        "padding_bottom": 8,
        "padding_left": 0
      },
      "blocks": [
        {
          "type": "announcement-text",
          "settings": {
            "text": "Free shipping for all orders over $100.00",
            "width": "fill"
          }
        },
        {
          "type": "discount-code",
          "settings": {
            "message": "<p>50% off - use code:</p>",
            "discount_code": "BIG50",
            "button_label": "Shop now",
            "button_style": "tertiary",
            "show_icon": false
          }
        },
        {
          "type": "announcement-countdown-timer",
          "settings": {
            "message": "<p>Hurry up! Sale ends in:</p>",
            "style": "inline",
            "type": "fixed_time",
            "end_time": "2026-12-25 12:00",
            "button_label": "Shop now",
            "button_style": "tertiary",
            "show_icon": false,
            "color_type": "inherit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
