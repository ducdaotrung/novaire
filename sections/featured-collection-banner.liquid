      width: auto;
    }
  }

  .container.full-width.featured-collection-banner__container--no-padding {
    padding-inline: 0;
  }

  .featured-collection-banner__content {
    display: flex;
    flex-wrap: wrap;
    gap: var(--featured-collection-banner-gap-mobile, 20px);
    min-width: 0;
  }

  .featured-collection-banner__content > :is(.block-header, .image-card--featured-collection-banner, .product-list-banner) {
    min-width: 0;
    flex: 0 0 100%;
    order: var(--featured-collection-role-order);
  }

