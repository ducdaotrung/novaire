  .featured-collection-banner__content[data-banner-position="after"]:not(:has(> .image-card--featured-collection-banner ~ .image-card--featured-collection-banner)):not(:has(> .product-list-banner ~ .product-list-banner)):has(> .image-card--featured-collection-banner:nth-child(3 of .block-header, .image-card--featured-collection-banner, .product-list-banner)):has(> .product-list-banner:nth-child(2 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) { --featured-collection-banner-banner-order: 3; --featured-collection-banner-products-order: 2; }

