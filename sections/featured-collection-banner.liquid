    .featured-collection-banner__content[data-banner-position="after"]:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) > .product-list-banner {
      grid-column: 1;
    }

    .featured-collection-banner__content[data-banner-position="before"]:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) > .product-list-banner,
    .featured-collection-banner__content[data-banner-position="after"]:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) > .image-card--featured-collection-banner {
      grid-column: 2;
    }
  }

  @media (max-width: 767.98px) {
    .featured-collection-banner__spacing {
      padding-top: var(--featured-collection-banner-padding-top-mobile, var(--featured-collection-banner-padding-top, 50px));
      padding-bottom: var(--featured-collection-banner-padding-bottom-mobile, var(--featured-collection-banner-padding-bottom, 50px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection_banner",
  "class": "section-featured-collection-banner",
  "enabled_on": { "templates": ["*"] },
  "max_blocks": 3,
  "blocks": [
    { "type": "header" },
    { "type": "banner" },
    { "type": "product-list-banner" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" },
        { "value": "full_width_no_padding", "label": "t:options.section_width.full_width_no_padding" }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "t:labels.banner_position",
      "options": [
        { "value": "before", "label": "t:options.banner_position.before" },
        { "value": "after", "label": "t:options.banner_position.after" }
      ],
      "default": "before"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Featured collection: Banner",
      "category": "t:general.collection",
      "settings": {
        "section_width": "page_width",
        "banner_position": "before",
        "gap_desktop": 30,
        "gap_mobile": 20,
        "color_scheme": "scheme-1",
        "padding_top": 50,
        "padding_bottom": 50,
        "customize_mobile_padding": false
      },
      "blocks": [
        {
          "type": "header",
          "settings": {
            "width": "fill",
            "alignment": "center",
            "gap_desktop": 8,
            "gap_mobile": 8
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
