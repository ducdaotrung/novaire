  .featured-collection-banner__content > :nth-child(2 of .block-header, .image-card--featured-collection-banner, .product-list-banner) { --featured-collection-role-order: 2; }
  .featured-collection-banner__content > :nth-child(3 of .block-header, .image-card--featured-collection-banner, .product-list-banner) { --featured-collection-role-order: 3; }

