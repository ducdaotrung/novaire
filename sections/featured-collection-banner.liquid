  }

  .featured-collection-banner__content > .product-list-banner {
    order: var(--featured-collection-banner-products-order, var(--featured-collection-role-order));
  }

  @media (min-width: 768px) {
    .featured-collection-banner__content {
      gap: var(--featured-collection-banner-gap-desktop, 30px);
    }

    .featured-collection-banner__content:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) { --featured-banner-view-all-order: 1; }
    .featured-collection-banner__content:has(> .block-header:nth-child(2 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) { --featured-banner-view-all-order: 2; }
    .featured-collection-banner__content:has(> .block-header:nth-child(3 of .block-header, .image-card--featured-collection-banner, .product-list-banner)) { --featured-banner-view-all-order: 3; }

    .featured-collection-banner__content:has(> .featured-collection-banner__view-all) > .block-header {
      flex: 1 1 0;
      width: auto;
      max-width: none;
    }

    .featured-collection-banner__content > .featured-collection-banner__view-all {
      order: var(--featured-banner-view-all-order, 1);
      flex: 0 0 auto;
      align-self: flex-end;
      margin-left: auto;
    }

    .featured-collection-banner__content > .featured-collection-banner__view-all--width-fill {
      flex: 0 1 30%;
    }

    .featured-collection-banner__content > :is(.image-card--featured-collection-banner, .product-list-banner) {
      flex-basis: calc((100% - var(--featured-collection-banner-gap-desktop, 30px)) / 2);
      position: sticky;
      top: calc(var(--header-sticky-height, 0px) + var(--sticky-offset-spacing, 16px));
      align-self: flex-start;
    }

    .featured-collection-banner__content:not(:has(> :nth-child(2 of .image-card--featured-collection-banner, .product-list-banner))) > :is(.image-card--featured-collection-banner, .product-list-banner) {
      flex-basis: 100%;
    }

    /* Keep the header and its action together above the banner/product pair. */
    .featured-collection-banner__content:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)):has(> .image-card--featured-collection-banner):has(> .product-list-banner):has(> .featured-collection-banner__view-all) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-collection-banner__content:has(> .block-header:nth-child(1 of .block-header, .image-card--featured-collection-banner, .product-list-banner)):has(> .image-card--featured-collection-banner):has(> .product-list-banner):has(> .featured-collection-banner__view-all) > .block-header {
