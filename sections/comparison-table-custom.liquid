{% liquid
  assign comparison_table_custom_width = section.settings.section_width | default: 'page_width'
  unless comparison_table_custom_width == 'page_width' or comparison_table_custom_width == 'full_width' or comparison_table_custom_width == 'full_width_no_padding'
    assign comparison_table_custom_width = 'page_width'
  endunless

  assign comparison_table_custom_container = 'page-width'
  assign comparison_table_custom_no_padding = false
  case comparison_table_custom_width
    when 'full_width'
      assign comparison_table_custom_container = 'full-width'
    when 'full_width_no_padding'
      assign comparison_table_custom_container = 'full-width'
      assign comparison_table_custom_no_padding = true
  endcase

  assign comparison_table_custom_direction = section.settings.direction | default: 'vertical'
  unless comparison_table_custom_direction == 'horizontal' or comparison_table_custom_direction == 'vertical'
    assign comparison_table_custom_direction = 'vertical'
  endunless

  assign comparison_table_custom_position = section.settings.position | default: 'center'
  unless comparison_table_custom_position == 'top' or comparison_table_custom_position == 'center' or comparison_table_custom_position == 'bottom'
    assign comparison_table_custom_position = 'center'
  endunless

  assign comparison_table_custom_horizontal_alignment = section.settings.horizontal_alignment | default: 'space-between'
  unless comparison_table_custom_horizontal_alignment == 'left' or comparison_table_custom_horizontal_alignment == 'center' or comparison_table_custom_horizontal_alignment == 'right' or comparison_table_custom_horizontal_alignment == 'space-between'
    assign comparison_table_custom_horizontal_alignment = 'space-between'
  endunless

  assign comparison_table_custom_alignment = section.settings.alignment | default: 'left'
  unless comparison_table_custom_alignment == 'left' or comparison_table_custom_alignment == 'center' or comparison_table_custom_alignment == 'right'
    assign comparison_table_custom_alignment = 'left'
  endunless

  assign comparison_table_custom_alignment_mobile = section.settings.alignment_mobile | default: 'left'
  unless comparison_table_custom_alignment_mobile == 'left' or comparison_table_custom_alignment_mobile == 'center' or comparison_table_custom_alignment_mobile == 'right'
    assign comparison_table_custom_alignment_mobile = 'left'
  endunless

  assign comparison_table_custom_flow_position = 'top'
  if comparison_table_custom_direction == 'horizontal'
    assign comparison_table_custom_flow_position = comparison_table_custom_position
  endif

  assign comparison_table_custom_flow_alignment = 'start'
  case comparison_table_custom_alignment
    when 'center'
      assign comparison_table_custom_flow_alignment = 'center'
    when 'right'
      assign comparison_table_custom_flow_alignment = 'end'
  endcase

  assign comparison_table_custom_flow_horizontal_alignment = 'flex-start'
  case comparison_table_custom_horizontal_alignment
    when 'left'
      assign comparison_table_custom_flow_horizontal_alignment = 'flex-start'
    when 'center'
      assign comparison_table_custom_flow_horizontal_alignment = 'center'
    when 'right'
      assign comparison_table_custom_flow_horizontal_alignment = 'flex-end'
    when 'space-between'
      assign comparison_table_custom_flow_horizontal_alignment = 'space-between'
  endcase

  assign comparison_table_custom_flow_mobile_alignment = 'start'
  case comparison_table_custom_alignment_mobile
    when 'center'
      assign comparison_table_custom_flow_mobile_alignment = 'center'
    when 'right'
      assign comparison_table_custom_flow_mobile_alignment = 'end'
  endcase

  assign comparison_table_custom_flow_mobile_justify = 'flex-start'
  case comparison_table_custom_alignment_mobile
    when 'center'
      assign comparison_table_custom_flow_mobile_justify = 'center'
    when 'right'
      assign comparison_table_custom_flow_mobile_justify = 'flex-end'
  endcase

  assign comparison_table_custom_mobile_vertical = false
  if comparison_table_custom_direction == 'horizontal' and section.settings.customize_mobile_alignment
    assign comparison_table_custom_mobile_vertical = true
  endif

  assign comparison_table_custom_inherited_alignment = comparison_table_custom_flow_alignment
  if comparison_table_custom_direction == 'horizontal'
    case comparison_table_custom_horizontal_alignment
      when 'center'
        assign comparison_table_custom_inherited_alignment = 'center'
      when 'right'
        assign comparison_table_custom_inherited_alignment = 'end'
      else
        assign comparison_table_custom_inherited_alignment = 'start'
    endcase
  endif
  assign comparison_table_custom_inherited_alignment_mobile = comparison_table_custom_inherited_alignment
  if comparison_table_custom_direction == 'vertical' or comparison_table_custom_mobile_vertical
    assign comparison_table_custom_inherited_alignment_mobile = comparison_table_custom_flow_mobile_alignment
  endif

  assign comparison_table_custom_scheme = section.settings.color_scheme | default: settings.default_color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign comparison_table_custom_scheme = section.settings.color_scheme.id
  endif
  assign comparison_table_custom_scheme = comparison_table_custom_scheme | default: 'scheme-1' | handleize

  assign comparison_table_custom_padding_top = section.settings.padding_top | default: 100 | plus: 0
  assign comparison_table_custom_padding_bottom = section.settings.padding_bottom | default: 100 | plus: 0
  assign comparison_table_custom_padding_top_mobile = section.settings.padding_top_mobile | default: 60 | plus: 0
  assign comparison_table_custom_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60 | plus: 0
  assign comparison_table_custom_gap = section.settings.gap_desktop | default: 50 | plus: 0
  assign comparison_table_custom_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0
  assign comparison_table_custom_content_class = 'comparison-table-custom__content layout-flow layout-flow--responsive comparison-table-custom__content--direction-' | append: comparison_table_custom_direction
%}

{% capture comparison_table_custom_style %}
  --section-padding-top: {{ comparison_table_custom_padding_top }}px;
  --section-padding-bottom: {{ comparison_table_custom_padding_bottom }}px;
  --comparison-table-custom-gap: {{ comparison_table_custom_gap }}px;
  --comparison-table-custom-gap-mobile: {{ comparison_table_custom_gap_mobile }}px;
  {% if section.settings.customize_mobile_spacing %}
    --section-padding-top-mobile: {{ comparison_table_custom_padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ comparison_table_custom_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign comparison_table_custom_style = comparison_table_custom_style | strip | replace: '\n', ' ' %}

{% capture comparison_table_custom_content_style %}
  --flex-align: {{ comparison_table_custom_inherited_alignment }};
  --flex-align-mobile: {{ comparison_table_custom_inherited_alignment_mobile }};
  {% render 'layout-flow-group-style',
    direction: comparison_table_custom_direction,
    wrap: 'nowrap',
    position: comparison_table_custom_flow_position,
    alignment: comparison_table_custom_flow_alignment,
    horizontal_alignment: comparison_table_custom_flow_horizontal_alignment,
    mobile_vertical: comparison_table_custom_mobile_vertical,
    mobile_alignment: comparison_table_custom_flow_mobile_alignment,
    mobile_justify: comparison_table_custom_flow_mobile_justify,
    gap: comparison_table_custom_gap,
    gap_mobile: comparison_table_custom_gap_mobile
  %}
{% endcapture %}
{% assign comparison_table_custom_content_style = comparison_table_custom_content_style | strip %}

{% if section.blocks.size > 0 or request.design_mode %}
  <div
    class="section-spacing comparison-table-custom__spacing color-scheme section-color-scope {{ comparison_table_custom_scheme }}{% if comparison_table_custom_no_padding %} comparison-table-custom__spacing--no-padding{% endif %}"
    {% if comparison_table_custom_style != blank %}style="{{ comparison_table_custom_style }}"{% endif %}
  >
    <div class="container {{ comparison_table_custom_container }} comparison-table-custom__container{% if comparison_table_custom_no_padding %} comparison-table-custom__container--no-padding{% endif %}">
      <div
        class="{{ comparison_table_custom_content_class }}"
        {% if comparison_table_custom_content_style != blank %}style="{{ comparison_table_custom_content_style }}"{% endif %}
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .comparison-table-custom__spacing,
  .comparison-table-custom__container,
  .comparison-table-custom__content {
    width: 100%;
    min-width: 0;
  }

  .comparison-table-custom__content > * {
    min-width: 0;
  }

  .comparison-table-custom__content {
    display: flex;
    text-align: var(--flex-align, start);
  }

  .comparison-table-custom__content--direction-horizontal > * {
    max-width: 100%;
  }

  .comparison-table-custom__spacing--no-padding,
  .comparison-table-custom__spacing .container.comparison-table-custom__container--no-padding {
    padding-inline: 0;
  }

  @media (max-width: 767.98px) {
    .comparison-table-custom__content {
      text-align: var(--flex-align-mobile, var(--flex-align, start));
    }
  }

{% endstylesheet %}

