{% liquid
  assign bundle_builder_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign bundle_builder_width = 'full-width'
  endif

  assign bundle_builder_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign bundle_builder_scheme = section.settings.color_scheme.id
  endif
  assign bundle_builder_scheme = bundle_builder_scheme | default: 'scheme-1' | handleize

  assign bundle_builder_alignment = section.settings.alignment | default: 'left'
  assign bundle_builder_flex_alignment = 'flex-start'
  case bundle_builder_alignment
    when 'center'
      assign bundle_builder_flex_alignment = 'center'
    when 'right'
      assign bundle_builder_flex_alignment = 'flex-end'
    else
      assign bundle_builder_alignment = 'left'
  endcase

  assign bundle_builder_gap_desktop = section.settings.gap_desktop | default: 60 | plus: 0
  assign bundle_builder_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0

  assign bundle_builder_padding_top = section.settings.padding_top | default: 40 | plus: 0
  assign bundle_builder_padding_bottom = section.settings.padding_bottom | default: 40 | plus: 0
  assign bundle_builder_padding_top_mobile = section.settings.padding_top_mobile | default: bundle_builder_padding_top | plus: 0
  assign bundle_builder_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: bundle_builder_padding_bottom | plus: 0
%}

{% capture bundle_builder_style %}
  --flex-align: {{ bundle_builder_flex_alignment }};
  --text-align-default: {{ bundle_builder_alignment }};
  --bundle-builder-gap: {{ bundle_builder_gap_desktop }}px;
  --bundle-builder-gap-mobile: {{ bundle_builder_gap_mobile }}px;
  {% if bundle_builder_padding_top != 40 %}--bundle-builder-padding-top: {{ bundle_builder_padding_top }}px;{% endif %}
  {% if bundle_builder_padding_bottom != 40 %}--bundle-builder-padding-bottom: {{ bundle_builder_padding_bottom }}px;{% endif %}
  {% if section.settings.background_color != blank %}--background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if bundle_builder_padding_top_mobile != bundle_builder_padding_top %}--bundle-builder-padding-top-mobile: {{ bundle_builder_padding_top_mobile }}px;{% endif %}
    {% if bundle_builder_padding_bottom_mobile != bundle_builder_padding_bottom %}--bundle-builder-padding-bottom-mobile: {{ bundle_builder_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign bundle_builder_style = bundle_builder_style | strip %}

<div
  class="section-spacing section-color-scope color-scheme {{ bundle_builder_scheme }} bundle-builder"
  {% if bundle_builder_style != blank %}style="{{ bundle_builder_style }}"{% endif %}
>
  {% if section.settings.background_media != 'none' %}
    <div class="bundle-builder__background" aria-hidden="true">
      {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'background-media-paint', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
        {{ section.settings.background_video | video_tag: class: 'background-media-paint', autoplay: true, loop: true, muted: true, controls: false }}
      {% endif %}
    </div>
  {% endif %}
  <div
    class="container {{ bundle_builder_width }} bundle-builder__container"
    data-bundle-builder
    data-section-id="{{ section.id }}"
    data-bundle-design-mode="{{ request.design_mode }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-currency-code-display="{{ settings.price_currency_code_product_cards }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-money-with-currency-format="{{ shop.money_with_currency_format | escape }}"
  >
    <div class="bundle-builder__headers">
      {% content_for 'blocks' %}
    </div>
    {% content_for 'block', type: '_bundle-product-list', id: 'products' %}
    {% content_for 'block', type: '_bundle-summary', id: 'summary' %}
    <noscript><p class="body-text body-md">{{ 'bundle_builder.javascript_required' | t }}</p></noscript>
  </div>
</div>

<script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>
{{ 'component-bouncing-dots.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'bundle-builder.js' | asset_url }}"></script>

{% stylesheet %}
  .bundle-builder {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding-block: var(--bundle-builder-padding-top, 40px) var(--bundle-builder-padding-bottom, 40px);
    background: var(--background-color);
    text-align: var(--text-align-default, left);
  }

  .bundle-builder__background {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .bundle-builder__background :is(img, video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bundle-builder__container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'header'
      'products'
      'summary';
    gap: var(--bundle-builder-gap-mobile, 30px);
  }

  .bundle-builder__headers {
    grid-area: header;
    display: flex;
    flex-direction: column;
    gap: var(--bundle-builder-gap-mobile, 30px);
  }

  .bundle-builder__headers > .block-header {
    width: 100%;
    max-width: none;
    --header-align: var(--flex-align, flex-start) !important;
    --header-text-align: var(--text-align-default, left) !important;
  }

  .bundle-builder__container > .bundle-product-list {
    grid-area: products;
  }

  .bundle-builder__container > .bundle-summary {
    grid-area: summary;
  }

  .bundle-builder__container > * {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .bundle-builder__container {
      grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.8fr);
      grid-template-areas:
        'header header'
        'products summary';
      align-items: start;
      column-gap: var(--bundle-builder-gap, 60px);
      row-gap: var(--bundle-builder-gap, 60px);
    }

    .bundle-builder__headers {
      gap: var(--bundle-builder-gap, 60px);
    }

    .bundle-builder__container > .bundle-summary {
      position: sticky;
      top: calc(var(--header-sticky-height, 0px) + var(--sticky-offset-spacing, 16px));
      align-self: start;
      z-index: 1;
    }
  }

  @media (max-width: 767.98px) {
    .bundle-builder {
      padding-top: var(--bundle-builder-padding-top-mobile, var(--bundle-builder-padding-top, 40px));
      padding-bottom: var(--bundle-builder-padding-bottom-mobile, var(--bundle-builder-padding-bottom, 40px));
    }

    .bundle-builder__container > .bundle-product-list {
      flex-basis: 100%;
      margin-block-end: -60lvh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle builder",
  "class": "section-bundle-builder",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 50,
  "blocks": [
    { "type": "header" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page_width", "label": "Page width" },
        { "value": "full_width", "label": "Full width" }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "t:general.gap" },
    { "type": "range", "id": "gap_desktop", "label": "t:labels.desktop_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 60 },
    { "type": "range", "id": "gap_mobile", "label": "t:labels.mobile_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 30 },
    { "type": "header", "content": "t:general.appearance" },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:general.image" },
        { "value": "video", "label": "t:general.video" }
      ],
      "default": "none"
    },
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image", "visible_if": "{{ section.settings.background_media == 'image' }}" },
    { "type": "video", "id": "background_video", "label": "t:labels.background_video", "visible_if": "{{ section.settings.background_media == 'video' }}" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "color", "alpha": true, "id": "background_color", "label": "t:labels.background_color" },
    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.top_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.bottom_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "customize_mobile_padding", "label": "t:labels.customize_mobile_padding", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "t:labels.mobile_top_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24, "visible_if": "{{ section.settings.customize_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:labels.mobile_bottom_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24, "visible_if": "{{ section.settings.customize_mobile_padding }}" }
  ],
  "presets": [
    {
      "name": "Bundle builder",
      "category": "t:labels.products",
      "blocks": [
        {
          "type": "header",
          "blocks": [
            { "type": "heading", "settings": { "text": "<p>Build your bundle</p>", "heading_size": "display", "html_tag": "h2" } },
            { "type": "text", "settings": { "text": "<p>The choice is yours. With our bundle builder, select any combination from our range of products. The easiest way to keep everyone happy.</p>" } }
          ]
        },
        { "type": "_bundle-product-list", "id": "products", "static": true },
        { "type": "_bundle-summary", "id": "summary", "static": true, "settings": { "border_thickness": 1 } }
      ]
    }
  ]
}
{% endschema %}
