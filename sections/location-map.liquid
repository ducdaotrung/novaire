{% liquid
  assign location_map_section_width = section.settings.section_width | default: 'page_width'
  unless location_map_section_width == 'page_width' or location_map_section_width == 'full_width' or location_map_section_width == 'full_width_no_padding'
    assign location_map_section_width = 'page_width'
  endunless

  assign location_map_container_width = 'page-width'
  assign location_map_no_padding = false
  if location_map_section_width == 'full_width' or location_map_section_width == 'full_width_no_padding'
    assign location_map_container_width = 'full-width'
  endif
  if location_map_section_width == 'full_width_no_padding'
    assign location_map_no_padding = true
  endif

  assign location_map_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign location_map_scheme = section.settings.color_scheme.id
  endif
  assign location_map_scheme = location_map_scheme | default: 'scheme-1' | handleize

  assign location_map_layout_style = section.settings.layout_style | default: 'beside'
  unless location_map_layout_style == 'beside' or location_map_layout_style == 'overlay'
    assign location_map_layout_style = 'beside'
  endunless

  assign location_map_direction = section.settings.direction | default: 'horizontal'
  unless location_map_direction == 'horizontal' or location_map_direction == 'vertical'
    assign location_map_direction = 'horizontal'
  endunless

  assign location_map_position = section.settings.position | default: 'center'
  unless location_map_position == 'top' or location_map_position == 'center' or location_map_position == 'bottom'
    assign location_map_position = 'center'
  endunless

  assign location_map_horizontal_alignment = section.settings.horizontal_alignment | default: 'space-between'
  unless location_map_horizontal_alignment == 'left' or location_map_horizontal_alignment == 'center' or location_map_horizontal_alignment == 'right' or location_map_horizontal_alignment == 'space-between'
    assign location_map_horizontal_alignment = 'space-between'
  endunless

  assign location_map_alignment = section.settings.alignment | default: 'left'
  unless location_map_alignment == 'left' or location_map_alignment == 'center' or location_map_alignment == 'right'
    assign location_map_alignment = 'left'
  endunless

  assign location_map_alignment_mobile = section.settings.alignment_mobile | default: location_map_alignment
  unless location_map_alignment_mobile == 'left' or location_map_alignment_mobile == 'center' or location_map_alignment_mobile == 'right'
    assign location_map_alignment_mobile = location_map_alignment
  endunless

  assign location_map_gap = section.settings.gap_desktop | default: 64 | plus: 0
  if location_map_layout_style == 'overlay' and section.settings.gap_desktop == 64
    assign location_map_gap = 36
  endif
  assign location_map_gap_mobile = section.settings.gap_mobile | default: 40 | plus: 0
  assign location_map_padding_top = section.settings.padding_top | default: 64 | plus: 0
  assign location_map_padding_right = section.settings.padding_right | default: 0 | plus: 0
  assign location_map_padding_bottom = section.settings.padding_bottom | default: 64 | plus: 0
  assign location_map_padding_left = section.settings.padding_left | default: 0 | plus: 0
  assign location_map_padding_top_mobile = section.settings.padding_top_mobile | default: location_map_padding_top | plus: 0
  assign location_map_padding_right_mobile = section.settings.padding_right_mobile | default: location_map_padding_right | plus: 0
  assign location_map_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: location_map_padding_bottom | plus: 0
  assign location_map_padding_left_mobile = section.settings.padding_left_mobile | default: location_map_padding_left | plus: 0
  unless section.settings.customize_mobile_padding
    assign location_map_padding_top_mobile = location_map_padding_top
    assign location_map_padding_right_mobile = location_map_padding_right
    assign location_map_padding_bottom_mobile = location_map_padding_bottom
    assign location_map_padding_left_mobile = location_map_padding_left
  endunless

  assign location_map_position_align = 'center'
  if location_map_position == 'top'
    assign location_map_position_align = 'start'
  elsif location_map_position == 'bottom'
    assign location_map_position_align = 'end'
  endif

  assign location_map_justify_items = 'stretch'
  if location_map_direction == 'vertical'
    if location_map_alignment == 'center'
      assign location_map_justify_items = 'center'
    elsif location_map_alignment == 'right'
      assign location_map_justify_items = 'end'
    else
      assign location_map_justify_items = 'start'
    endif
  elsif location_map_horizontal_alignment == 'center'
    assign location_map_justify_items = 'center'
  elsif location_map_horizontal_alignment == 'right'
    assign location_map_justify_items = 'end'
  elsif location_map_horizontal_alignment == 'left'
    assign location_map_justify_items = 'start'
  endif

  assign location_map_mobile_vertical = true

  assign location_map_columns = 'minmax(0, 5fr) minmax(0, 7fr)'
  if location_map_direction == 'vertical'
    assign location_map_columns = 'minmax(0, 1fr)'
  endif
  assign location_map_columns_mobile = location_map_columns
  if location_map_mobile_vertical
    assign location_map_columns_mobile = 'minmax(0, 1fr)'
  endif

  capture location_map_media
    echo '<div class="location-map__media'
    if section.settings.map_image == blank and request.design_mode
      echo ' placeholder-image'
    endif
    echo '" aria-hidden="true">'
    if section.settings.map_image != blank
      echo section.settings.map_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '(min-width: 768px) 58.333vw, 100vw', alt: section.settings.map_image_alt
    elsif request.design_mode
      echo 'image' | placeholder_svg_tag: 'location-map__placeholder'
    endif
    echo '</div>'
  endcapture

  capture location_map_header
    content_for 'block', type: 'group', id: 'header'
  endcapture

  capture location_map_content
    content_for 'block', type: 'group', id: 'content'
  endcapture
%}

<div class="location-map location-map--{{ location_map_section_width }} location-map--{{ location_map_layout_style }}">
  <div
    class="section-spacing location-map__spacing color-scheme section-color-scope {{ location_map_scheme }}{% if location_map_no_padding %} location-map__spacing--no-padding{% endif %}"
    style="--location-map-columns: {{ location_map_columns }}; --location-map-columns-mobile: {{ location_map_columns_mobile }}; --location-map-gap: {{ location_map_gap }}px; --location-map-gap-mobile: {{ location_map_gap_mobile }}px; --location-map-align: {{ location_map_position_align }}; --location-map-justify-items: {{ location_map_justify_items }}; --location-map-align-mobile: {{ location_map_alignment_mobile }}; --location-map-justify-items-mobile: {% if location_map_alignment_mobile == 'center' %}center{% elsif location_map_alignment_mobile == 'right' %}end{% else %}start{% endif %}; --location-map-padding-top: {{ location_map_padding_top }}px; --location-map-padding-right: {{ location_map_padding_right }}px; --location-map-padding-bottom: {{ location_map_padding_bottom }}px; --location-map-padding-left: {{ location_map_padding_left }}px; --location-map-padding-top-mobile: {{ location_map_padding_top_mobile }}px; --location-map-padding-right-mobile: {{ location_map_padding_right_mobile }}px; --location-map-padding-bottom-mobile: {{ location_map_padding_bottom_mobile }}px; --location-map-padding-left-mobile: {{ location_map_padding_left_mobile }}px;{% if section.settings.background_color != blank %} --location-map-background: {{ section.settings.background_color | escape }};{% endif %}"
  >
    <div class="container {{ location_map_container_width }} location-map__container{% if location_map_no_padding %} location-map__container--no-padding{% endif %}">
      {% if location_map_layout_style == 'overlay' %}
        <div class="location-map__layout">
          {{ location_map_media }}
          <div class="location-map__card">
            {{ location_map_header }}
            {{ location_map_content }}
          </div>
        </div>
      {% else %}
        {{ location_map_header }}
        <div class="location-map__layout">
          {{ location_map_content }}
          {{ location_map_media }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .location-map {
    width: 100%;
    min-width: 0;
  }

  .location-map__spacing {
    width: 100%;
    padding-right: var(--location-map-padding-right);
    padding-left: var(--location-map-padding-left);
    padding-top: var(--location-map-padding-top);
    padding-bottom: var(--location-map-padding-bottom);
    background-color: var(--location-map-background, var(--background-color));
  }

  .location-map__container,
  .location-map__layout,
  .location-map__layout > * {
    min-width: 0;
  }

  .location-map__container--no-padding,
  .container.full-width.location-map__container--no-padding {
    padding-inline: 0;
  }

  .location-map__layout {
    display: grid;
    grid-template-columns: var(--location-map-columns);
    align-items: var(--location-map-align, center);
    justify-items: var(--location-map-justify-items, stretch);
    gap: var(--location-map-gap);
    width: 100%;
    margin-top: var(--location-map-gap);
  }

  .location-map__layout > :first-child {
    width: 100%;
  }

  .location-map__media {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, var(--background-color) 82%, var(--body-color));
  }

  .location-map__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-map__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .location-map--overlay .location-map__layout {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: 28px;
    min-height: clamp(360px, 38vw, 560px);
  }

  .location-map--overlay .location-map__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .location-map--overlay .location-map__card {
    display: flex;
    flex-direction: column;
    gap: var(--location-map-gap);
    position: relative;
    z-index: 1;
    width: min(50%, 560px);
    max-width: calc(100% - 14%);
    margin-left: 7%;
    padding: 32px;
    background: var(--background-color);
  }

  @media (max-width: 767.98px) {
    .location-map__spacing {
      padding-right: var(--location-map-padding-right-mobile, var(--location-map-padding-right));
      padding-left: var(--location-map-padding-left-mobile, var(--location-map-padding-left));
      padding-top: var(--location-map-padding-top-mobile, var(--location-map-padding-top));
      padding-bottom: var(--location-map-padding-bottom-mobile, var(--location-map-padding-bottom));
    }

    .location-map__layout {
      grid-template-columns: var(--location-map-columns-mobile);
      justify-items: var(--location-map-justify-items-mobile, start);
      margin-top: var(--location-map-gap-mobile, var(--location-map-gap));
    }

    .location-map--overlay .location-map__card {
      width: 100%;
      max-width: 100%;
      margin-inline: 16px;
      padding: 24px;
    }
  }
{% endstylesheet %}

