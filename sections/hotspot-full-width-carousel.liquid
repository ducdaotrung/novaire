{% schema %}
{
  "name": "t:general.hotspot_carousel",
  "class": "section-hotspot-full-width-carousel",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 9,
  "blocks": [
    { "type": "header" },
    { "type": "product-callout" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full" },
        { "value": "full_bleed", "label": "Full (no padding)" }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "show_next_slide_preview_on_desktop",
      "label": "t:labels.show_next_slide_preview_on_desktop",
      "default": false,
      "visible_if": "{{ section.settings.width == 'page' }}"
    },
    {
      "type": "select",
      "id": "transition_style",
      "label": "Transition style",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.width != 'page' or section.settings.show_next_slide_preview_on_desktop == false }}"
    },
    {
      "type": "header",
      "content": "t:general.height"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "t:labels.desktop_height",
      "options": [
        { "value": "adapt", "label": "t:options.hero_height.adapt" },
        { "value": "extra_small", "label": "t:options.hero_height.extra_small" },
        { "value": "small", "label": "t:options.hero_height.small" },
        { "value": "medium", "label": "t:options.hero_height.medium" },
        { "value": "large", "label": "t:options.hero_height.large" },
        { "value": "extra_large", "label": "t:options.hero_height.extra_large" },
        { "value": "full_screen", "label": "t:options.hero_height.full_screen" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:labels.mobile_height",
      "options": [
        { "value": "adapt", "label": "t:options.hero_height.adapt" },
        { "value": "extra_small", "label": "t:options.hero_height.extra_small" },
        { "value": "small", "label": "t:options.hero_height.small" },
        { "value": "medium", "label": "t:options.hero_height.medium" },
        { "value": "large", "label": "t:options.hero_height.large" },
        { "value": "extra_large", "label": "t:options.hero_height.extra_large" },
        { "value": "full_screen", "label": "t:options.hero_height.full_screen" }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "t:general.navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "navigation_style",
      "label": "t:labels.style",
      "options": [
        { "value": "primary", "label": "t:options.button_variant.primary" },
        { "value": "secondary", "label": "t:options.button_variant.secondary" }
      ],
      "default": "primary",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "select",
      "id": "navigation_icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "chevron", "label": "t:options.collection_navigation_icon.chevron" },
        { "value": "arrow", "label": "t:options.collection_navigation_icon.arrow" },
        { "value": "long_arrow", "label": "t:options.collection_navigation_icon.long_arrow" }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "select",
      "id": "navigation_behavior",
      "label": "t:labels.behavior",
      "options": [
        { "value": "show_on_hover", "label": "t:options.collection_navigation_behavior.show_on_hover" },
        { "value": "always", "label": "t:options.collection_navigation_behavior.always" }
      ],
      "default": "show_on_hover",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "header",
      "content": "t:general.pagination"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:labels.show_pagination",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:labels.type",
      "options": [
        { "value": "progress_bar", "label": "t:options.collection_pagination.progress_bar" },
        { "value": "bullets", "label": "t:options.collection_pagination.bullets" },
        { "value": "numbers", "label": "Numbers" }
      ],
      "default": "bullets",
      "visible_if": "{{ section.settings.show_pagination }}"
    },
    {
      "type": "select",
      "id": "pagination_position_desktop",
      "label": "Desktop position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.show_pagination }}"
    },
    {
      "type": "select",
      "id": "pagination_position_mobile",
      "label": "Mobile position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.show_pagination }}"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Hotspot carousel"
    },
    {
      "type": "header",
      "content": "t:general.product_card"
    },
    {
      "type": "checkbox",
      "id": "show_product_type",
      "label": "t:labels.show_product_type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_image",
      "label": "t:labels.show_product_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "t:labels.product_link_label",
      "default": "View product"
    },
    {
      "type": "header",
      "content": "t:general.appearance",
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:general.image" },
        { "value": "video", "label": "t:general.video" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.width != 'full_bleed' and section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.width != 'full_bleed' and section.settings.background_media == 'video' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background_color",
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "header",
      "content": "t:general.padding",
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false,
      "visible_if": "{{ section.settings.width != 'full_bleed' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.width != 'full_bleed' and section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.width != 'full_bleed' and section.settings.customize_mobile_padding }}"
    }
  ],
