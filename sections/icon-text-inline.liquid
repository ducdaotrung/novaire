{% liquid
  assign section_width = section.settings.section_width | default: 'page_width'
  unless section_width == 'page_width' or section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign section_width = 'page_width'
  endunless

  assign container_width = 'page-width'
  assign container_no_padding = false
  if section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign container_width = 'full-width'
  endif
  if section_width == 'full_width_no_padding'
    assign container_no_padding = true
  endif

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif

  assign alignment = section.settings.alignment | default: 'left'
  assign flex_align = 'flex-start'
  if alignment == 'center'
    assign flex_align = 'center'
  elsif alignment == 'right'
    assign flex_align = 'flex-end'
  endif

  assign mobile_flex_align = flex_align
  if section.settings.customize_mobile_alignment
    assign mobile_alignment = section.settings.alignment_mobile | default: alignment
    if mobile_alignment == 'center'
      assign mobile_flex_align = 'center'
    elsif mobile_alignment == 'right'
      assign mobile_flex_align = 'flex-end'
    else
      assign mobile_flex_align = 'flex-start'
    endif
  endif

  assign content_gap = section.settings.content_gap | default: 40 | plus: 0
  assign content_gap_mobile = content_gap
  if section.settings.customize_mobile_gap
    assign content_gap_mobile = section.settings.content_gap_mobile | default: content_gap | plus: 0
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = padding_top
  assign padding_bottom_mobile = padding_bottom
  if section.settings.customize_mobile_padding
    assign padding_top_mobile = section.settings.padding_top_mobile | default: padding_top | plus: 0
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: padding_bottom | plus: 0
  endif
%}

<div class="icon-text-inline icon-text-inline--{{ section_width }}">
  <div
    class="section-spacing icon-text-inline__spacing color-scheme section-color-scope {{ color_scheme | handleize }}"
    style="--icon-text-inline-align: {{ flex_align }}; --icon-text-inline-align-mobile: {{ mobile_flex_align }}; --icon-text-inline-gap: {{ content_gap }}px; --icon-text-inline-gap-mobile: {{ content_gap_mobile }}px; --icon-text-inline-padding-top: {{ padding_top }}px; --icon-text-inline-padding-bottom: {{ padding_bottom }}px; --icon-text-inline-padding-top-mobile: {{ padding_top_mobile }}px; --icon-text-inline-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% if section.settings.background_color != blank %} --icon-text-inline-background: {{ section.settings.background_color | escape }};{% endif %}"
  >
    {% if section.settings.background_image != blank %}
      <div class="icon-text-inline__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'background-media-paint', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </div>
    {% endif %}
    <div class="container {{ container_width }} icon-text-inline__container{% if container_no_padding %} icon-text-inline__container--no-padding{% endif %}">
      <div class="icon-text-inline__content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .icon-text-inline {
    width: 100%;
    min-width: 0;
  }

  .icon-text-inline__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--icon-text-inline-padding-top);
    padding-bottom: var(--icon-text-inline-padding-bottom);
    background-color: var(--icon-text-inline-background, var(--background-color));
  }

  .icon-text-inline__background {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .icon-text-inline__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon-text-inline__container {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .container.full-width.icon-text-inline__container--no-padding {
    padding-inline: 0;
  }

  .icon-text-inline__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: var(--icon-text-inline-align);
    gap: var(--icon-text-inline-gap);
    text-align: var(--text-align, left);
  }

  .icon-text-inline__content > * {
    max-width: 100%;
    min-width: 0;
  }

  .icon-text-inline .carousel-slide-layout--horizontal > * {
    flex: 0 1 auto;
  }

  .icon-text-inline .carousel-slide.swiper-slide > .carousel-slide-layout > .group {
    display: grid;
    flex: 0 0 56px;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: 50%;
  }

  .icon-text-inline .carousel-slide.swiper-slide > .carousel-slide-layout > .group .icon-block {
    width: 24px;
    height: 24px;
    padding: 0;
  }

  .icon-text-inline .carousel-slide-layout--vertical {
    flex-direction: column;
  }

  .icon-text-inline .carousel-slide-layout--vertical > * {
    flex: 0 1 auto;
  }

  .icon-text-inline .carousel-slide.swiper-slide > .carousel-slide-layout > .group .icon-block__icon {
    width: 24px;
    height: 24px;
    --icon-width: 24px;
    --icon-padding: 0px;
  }

  @media (max-width: 767.98px) {
    .icon-text-inline__spacing {
      padding-top: var(--icon-text-inline-padding-top-mobile);
      padding-bottom: var(--icon-text-inline-padding-bottom-mobile);
    }

    .icon-text-inline__content {
      align-items: var(--icon-text-inline-align-mobile);
      gap: var(--icon-text-inline-gap-mobile, var(--icon-text-inline-gap));
    }
  }
{% endstylesheet %}

