  .cart-drawer__order-options-content label { display: grid; gap: 0.45rem; color: var(--heading-color); }
  .cart-drawer__order-options-content textarea,
  .cart-drawer__order-options-content input,
  .cart-drawer__order-options-content select { width: 100%; min-height: var(--input-height); box-sizing: border-box; }
  .cart-drawer__order-options-content textarea { min-height: 9rem; resize: vertical; }

  @media (max-width: 767.98px) {
    .cart-drawer__order-options-action { min-height: 4.5rem; flex-direction: column; gap: 0.25rem; padding-inline: 0.3rem; text-align: center; }
    .cart-drawer__order-options-action-copy { justify-items: center; }
    .cart-drawer__order-options-action-copy small { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
    .cart-drawer__order-options-panel { max-height: min(78dvh, calc(100% - 2rem)); }
    .cart-drawer__discount input,
    .cart-drawer__shipping-estimator input,
    .cart-drawer__shipping-estimator select,
    .cart-drawer__order-options-content input,
    .cart-drawer__order-options-content select { min-height: var(--input-height-mobile); }
  }

  .cart-drawer__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .cart-drawer__checkout-form,
  .cart-drawer__checkout {
    width: 100%;
  }

  .cart-drawer__checkout {
    min-height: 3.75rem;
  }

  .cart-drawer__totals > div:nth-child(2) > span:last-child {
    color: color-mix(in srgb, var(--body-color) 62%, transparent);
  }
{% endstylesheet %}

