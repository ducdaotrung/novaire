{% liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign scheme = section.settings.color_scheme.id
  endif
  assign container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign container_width = 'full-width'
  endif
  assign dialog_id = 'PasswordDialog-' | append: section.id
  assign form_id = 'PasswordForm-' | append: section.id
  assign input_id = 'PasswordInput-' | append: section.id
  assign error_id = 'PasswordError-' | append: section.id
  assign enter_label = 'password.enter_using_password' | t
  assign dialog_title = 'password.dialog_title' | t
%}
<style>
  #shopify-section-{{ section.id }} { background: {% if section.settings.background_color != blank %}{{ section.settings.background_color }}{% else %}var(--background-color){% endif %}; }
</style>
<password-page class="section-spacing password-page color-scheme section-color-scope {{ scheme }}" style="{% if section.settings.background_color != blank %}--password-background: {{ section.settings.background_color | escape }};{% endif %} --password-content-width: {{ section.settings.max_width | default: 560 }}px; --password-gap: {{ section.settings.gap | default: 10 }}px; --password-padding-top: {{ section.settings.padding_top | default: 32 }}px; --password-padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;">
  <div class="container {{ container_width }} password-page__layout">
    <header class="password-page__header">
      <div class="password-page__brand">{% content_for 'block', type: '_header-logo', id: 'password-logo' %}</div>
      {% capture open_attributes %}data-password-open aria-haspopup="dialog" aria-controls="{{ dialog_id }}" aria-expanded="false"{% endcapture %}
      {% render 'theme-button', label: enter_label, variant: 'tertiary', attributes: open_attributes %}
    </header>
    <div class="password-page__main">
      <div class="password-page__content align-content{% if section.settings.boxed %} password-page__content--boxed{% endif %}">
        {% content_for 'blocks' %}
        {% if shop.password_message != blank %}<div class="body-text body-md password-page__message">{{ shop.password_message | escape | newline_to_br }}</div>{% endif %}
      </div>
    </div>
    {% if section.settings.show_footer %}
      <footer class="password-page__footer body-text body-sm">
        <p>{{ 'password.powered_by' | t }} {{ powered_by_link | replace: 'Powered by Shopify', 'Shopify' }}</p>
        <p>{{ 'password.owner' | t }} <a href="{{ routes.root_url }}admin">{{ 'password.owner_login' | t }}</a></p>
      </footer>
    {% endif %}
  </div>
  {% capture password_content %}
    {% form 'storefront_password', id: form_id %}
      <div class="form__wrapper">
        {% if form.errors %}<div id="{{ error_id }}" class="form__error" role="alert" data-password-error>{{ form.errors | default_errors }}</div>{% endif %}
        <div class="form__fields password-page__fields">
          <div class="form__field">
            <label class="form__label" for="{{ input_id }}">{{ 'password.password' | t }}</label>
            <input class="form__control form__control--input" type="password" name="password" id="{{ input_id }}" autocomplete="current-password" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}>
          </div>
          {% assign submit_label = 'password.enter' | t %}
          {% render 'theme-button', label: submit_label, type: 'submit', variant: 'primary' %}
        </div>
      </div>
    {% endform %}
    <p class="password-page__owner body-text body-sm">{{ 'password.owner' | t }} <a href="{{ routes.root_url }}admin">{{ 'password.owner_login' | t }}</a></p>
  {% endcapture %}
  {% render 'component-overlay', id: dialog_id, content: password_content, title: dialog_title, label: dialog_title, desktop_layout: 'drawer', mobile_layout: 'drawer', attributes: 'data-password-dialog', body_class: 'password-page__dialog-body', width: 460 %}
  {% liquid
    assign fallback_form_id = form_id | append: '-Fallback'
    assign fallback_input_id = input_id | append: '-Fallback'
    assign fallback_error_id = error_id | append: '-Fallback'
  %}
  <noscript>
    <div class="container page-width password-page__fallback"><h2 class="heading-text heading-sm">{{ dialog_title }}</h2>{{ password_content | replace: form_id, fallback_form_id | replace: input_id, fallback_input_id | replace: error_id, fallback_error_id }}</div>
  </noscript>
</password-page>

{% stylesheet %}
  .password-page { display: block; min-height: 100svh; color: var(--body-color); background: var(--password-background, var(--background-color)); }
  .password-page__layout { display: flex; min-height: 100svh; flex-direction: column; }
  .password-page__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 2rem; }
  .password-page__brand { min-width: 0; max-width: 100%; }
  .password-page__brand .site-logo:has(.site-logo__fallback) { width: auto; max-width: 100%; }
  .password-page__main { display: grid; flex: 1; place-items: center; padding-block: var(--password-padding-top) var(--password-padding-bottom); }
  .password-page__content { --flex-align: center; width: min(100%, var(--password-content-width)); gap: var(--password-gap); padding: 2rem; }
  .password-page__content--boxed { border: 1px solid var(--border-color); }
  .password-page__content .email-signup-block { margin-top: 1rem; }
  .password-page__footer { padding-block: 2rem; text-align: center; }
  .password-page__footer p + p { margin-top: 1rem; }
  .password-page__fields { display: grid; gap: 1rem; }
  .password-page__fields > .btn { width: 100%; }
  .password-page__owner { margin-top: 2rem; text-align: center; }
  .password-page__fallback { padding-block: 2rem; }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .password-page__main { padding-block: calc(var(--password-padding-top) * .75) calc(var(--password-padding-bottom) * .75); }
  }
  @media (max-width: 767.98px) {
    .password-page__header { flex-wrap: wrap; padding-block: 1rem; }
    .password-page__content { padding: 1.5rem 1rem; }
    .password-page__main { padding-block: calc(var(--password-padding-top) * .5) calc(var(--password-padding-bottom) * .5); }
    .password-page__footer { padding-block: 1.5rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "class": "section-password",
  "enabled_on": { "templates": ["password"] },
  "max_blocks": 5,
  "blocks": [{"type":"heading"},{"type":"text"},{"type":"countdown-timer"},{"type":"email-signup"},{"type":"social-links"}],
  "settings": [
    {"type":"header","content":"t:general.layout"},
    {"type":"select","id":"section_width","label":"t:labels.section_width","options":[{"value":"page_width","label":"t:options.section_width.page_width"},{"value":"full_width","label":"t:options.section_width.full_width"}],"default":"page_width"},
    {"type":"range","id":"max_width","label":"t:labels.max_width","min":320,"max":1000,"step":10,"unit":"px","default":560},
    {"type":"range","id":"gap","label":"t:labels.gap","min":0,"max":60,"step":2,"unit":"px","default":10},
    {"type":"checkbox","id":"boxed","label":"t:labels.password_boxed","default":true},
    {"type":"checkbox","id":"show_footer","label":"t:labels.password_show_footer","default":true},
    {"type":"header","content":"t:general.appearance"},
    {"type":"color_scheme","id":"color_scheme","label":"t:labels.color_scheme","default":"scheme-1"},
    {"type":"color","id":"background_color","label":"t:labels.background_color"},
    {"type":"header","content":"t:general.section_padding"},
    {"type":"range","id":"padding_top","label":"t:labels.top_padding","min":0,"max":120,"step":4,"unit":"px","default":32},
    {"type":"range","id":"padding_bottom","label":"t:labels.bottom_padding","min":0,"max":120,"step":4,"unit":"px","default":32}
  ]
}
{% endschema %}
