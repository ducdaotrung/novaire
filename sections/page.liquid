{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="container page-width section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <h1 class="heading-text heading-xl">{{ page.title }}</h1>

  <div class="body-text body-md rte">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
